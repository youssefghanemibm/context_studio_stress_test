      "rdfs:comment": "First day the rule version or regulation applies. Absent for drafts.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:RuleVersion"
            },
            {
              "@id": "cc:Regulation"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:effectiveTo",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "effectiveTo",
      "rdfs:comment": "Last day the rule version applies. Absent while it is still in force.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:ruleText",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ruleText",
      "rdfs:comment": "The wording of the rule in this version.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:threshold",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "threshold",
      "rdfs:comment": "The main numeric trigger value set by the rule version, for example a score or a monetary limit. Pair a monetary threshold with currency.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:tier3Threshold",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "tier3Threshold",
      "rdfs:comment": "A threshold that applies only to Tier-3 Claims, where the rule version sets one that differs from the main threshold.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:amount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "amount",
      "rdfs:comment": "A monetary amount set by the rule version, such as an authority limit or a minimum value. Pair it with currency.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:currency",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "currency",
      "rdfs:comment": "ISO 4217 currency code of the amounts on the entity, for example GBP, NOK, SEK or DKK.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:RuleVersion"
            },
            {
              "@id": "cc:Product"
            },
            {
              "@id": "cc:Claim"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:approvedOn",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "approvedOn",
      "rdfs:comment": "The date the rule version was approved.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:publishedOn",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "publishedOn",
      "rdfs:comment": "The date the regulator published the regulation.",
      "rdfs:domain": {
        "@id": "cc:Regulation"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:frequency",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "frequency",
      "rdfs:comment": "How often the report is submitted, for example quarterly or annually.",
      "rdfs:domain": {
        "@id": "cc:RegulatoryReport"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:dueDeadline",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "dueDeadline",
      "rdfs:comment": "When the report is due, as stated (for example a number of days after period end).",
      "rdfs:domain": {
        "@id": "cc:RegulatoryReport"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:lineOfBusiness",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "lineOfBusiness",
      "rdfs:comment": "Line of business of the product, for example motor, home, commercial property or liability.",
      "rdfs:domain": {
        "@id": "cc:Product"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:region",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "region",
      "rdfs:comment": "Country or region of the product or claim.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:Product"
            },
            {
              "@id": "cc:Claim"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:excessAmount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "excessAmount",
      "rdfs:comment": "The standard Excess on the product: the amount the Policyholder bears on each claim, in the product currency. Older policy wordings may state older amounts.",
      "rdfs:domain": {
        "@id": "cc:Product"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:claimTypeCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "claimTypeCode",
      "rdfs:comment": "The short code of the Claim Type.",
      "rdfs:domain": {
        "@id": "cc:ClaimType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:sequenceNumber",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "sequenceNumber",
      "rdfs:comment": "Position of the stage or step in the process order.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:ProcessStage"
            },
            {
              "@id": "cc:ProcessStep"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "cc:serviceLevel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "serviceLevel",
      "rdfs:comment": "The service-level target of the step, for example a number of business days.",
      "rdfs:domain": {
        "@id": "cc:ProcessStep"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:severity",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "severity",
      "rdfs:comment": "Severity rating of the incident.",
      "rdfs:domain": {
        "@id": "cc:Incident"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:rootCause",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "rootCause",
      "rdfs:comment": "The root cause of the incident.",
      "rdfs:domain": {
        "@id": "cc:Incident"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:occurredOn",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "occurredOn",
      "rdfs:comment": "The date the incident started.",
      "rdfs:domain": {
        "@id": "cc:Incident"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:decisionDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "decisionDate",
      "rdfs:comment": "The date the architecture decision was made.",
      "rdfs:domain": {
        "@id": "cc:ArchitectureDecision"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:ticketType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "ticketType",
      "rdfs:comment": "Type of the ticket, for example bug, story or task.",
      "rdfs:domain": {
        "@id": "cc:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:resolvedOn",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "resolvedOn",
      "rdfs:comment": "The date the ticket was resolved.",
      "rdfs:domain": {
        "@id": "cc:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:releaseVersion",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "releaseVersion",
      "rdfs:comment": "The fix version (release) the ticket is planned for or was delivered in.",
      "rdfs:domain": {
        "@id": "cc:Ticket"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:milestoneDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "milestoneDate",
      "rdfs:comment": "The date of the milestone.",
      "rdfs:domain": {
        "@id": "cc:Milestone"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:claimsMigrated",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "claimsMigrated",
      "rdfs:comment": "Number of claims moved to the target platform by the migration wave.",
      "rdfs:domain": {
        "@id": "cc:Milestone"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "cc:lossDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "lossDate",
      "rdfs:comment": "The date the loss happened.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:notificationDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "notificationDate",
      "rdfs:comment": "The date of First Notice of Loss for the claim.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:closedDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "closedDate",
      "rdfs:comment": "The date the claim was closed.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:date"
      }
    },
    {
      "@id": "cc:channel",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "channel",
      "rdfs:comment": "The channel through which the claim was notified, for example phone, web, broker or app.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      }
    },
    {
      "@id": "cc:tier",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "tier",
      "rdfs:comment": "The complexity tier of the claim (1 to 3); tier 3 marks a Tier-3 Claim.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "cc:fraudScore",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "fraudScore",
      "rdfs:comment": "The Fraud Score (0 to 100) recorded for the claim.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      }
    },
    {
      "@id": "cc:fraudReferral",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "fraudReferral",
      "rdfs:comment": "True when the claim was the subject of a Fraud Referral.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "cc:reserveAmount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "reserveAmount",
      "rdfs:comment": "The current Reserve on the claim, in the claim currency.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:paidToDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "paidToDate",
      "rdfs:comment": "The amount paid on the claim so far, in the claim currency.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:incurredAmount",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "incurredAmount",
      "rdfs:comment": "Incurred: the amount paid to date plus the current Reserve, in the claim currency.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:decimal"
      }
    },
    {
      "@id": "cc:subrogationFlag",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "subrogationFlag",
      "rdfs:comment": "True when Subrogation is being pursued for the claim.",
      "rdfs:domain": {
        "@id": "cc:Claim"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    }
  ]
}
