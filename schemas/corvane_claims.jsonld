{
  "@context": {
    "cc": "https://example.org/corvane/claims#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "https://example.org/corvane/claims",
      "@type": "owl:Ontology",
      "rdfs:label": "Corvane Mutual claims modernisation schema",
      "rdfs:comment": "Hand-written knowledge-graph schema for the Corvane Mutual claims-platform modernisation (from the legacy CLARA platform to the Claims Hub microservices). It uses canonical terms only. Relationship labels are UPPER_SNAKE and their IRIs are camelCase; class labels are the canonical names; datatype property labels equal their IRI local names. Properties with more than one possible subject or object class use owl:unionOf.",
      "owl:versionInfo": "1.0.0"
    },
    {
      "@id": "cc:Person",
      "@type": "owl:Class",
      "rdfs:label": "Person",
      "rdfs:comment": "An individual: an employee of the insurer, a consultant, a contact at a supplier, or someone who works for the regulator. Job titles and role names are values of jobTitle, never separate Person nodes."
    },
    {
      "@id": "cc:Team",
      "@type": "owl:Class",
      "rdfs:label": "Team",
      "rdfs:comment": "A named working group with a lead and staff, inside a department. Team names and leads change over time."
    },
    {
      "@id": "cc:Department",
      "@type": "owl:Class",
      "rdfs:label": "Department",
      "rdfs:comment": "A top-level division of the insurer that groups teams and has a head."
    },
    {
      "@id": "cc:Location",
      "@type": "owl:Class",
      "rdfs:label": "Location",
      "rdfs:comment": "A physical site: an office, a data centre, or an office of an external organisation."
    },
    {
      "@id": "cc:Organisation",
      "@type": "owl:Class",
      "rdfs:label": "Organisation",
      "rdfs:comment": "A legal entity: the insurer itself, a supplier or panel firm, a consultancy, a reinsurer, a bank or the regulator.",
      "skos:altLabel": "Organization"
    },
    {
      "@id": "cc:System",
      "@type": "owl:Class",
      "rdfs:label": "System",
      "rdfs:comment": "An application or platform, legacy or target: the core claims platforms, a fraud-scoring engine, a portal, a data warehouse, a scheduler. Programs, services, tables, batch jobs and topics are parts of a system."
    },
    {
      "@id": "cc:Program",
      "@type": "owl:Class",
      "rdfs:label": "Program",
      "rdfs:comment": "A COBOL program of the legacy claims platform, identified by its eight-character program name. Online programs run under a CICS transaction; batch programs run as steps of batch jobs.",
      "skos:altLabel": "COBOL Program"
    },
    {
      "@id": "cc:Copybook",
      "@type": "owl:Class",
      "rdfs:label": "Copybook",
      "rdfs:comment": "A COBOL copybook: a shared record layout included by programs, usually the layout of one database table or one interface record."
    },
    {
      "@id": "cc:BatchJob",
      "@type": "owl:Class",
      "rdfs:label": "Batch Job",
      "rdfs:comment": "A scheduled JCL batch job made of steps, each of which runs a program.",
      "skos:altLabel": "JCL Job"
    },
    {
      "@id": "cc:ScreenMap",
      "@type": "owl:Class",
      "rdfs:label": "Screen Map",
      "rdfs:comment": "A BMS screen map (with its mapset) that an online program displays under a CICS transaction.",
      "skos:altLabel": "BMS Map"
    },
    {
      "@id": "cc:DatabaseTable",
      "@type": "owl:Class",
      "rdfs:label": "Database Table",
      "rdfs:comment": "A relational table in the legacy DB2 database or in a target PostgreSQL database, identified by its schema-qualified name."
    },
    {
      "@id": "cc:Interface",
      "@type": "owl:Class",
      "rdfs:label": "Interface",
      "rdfs:comment": "A data feed or integration from a source system to a target system, with a protocol, format, schedule and owner. An interface can depend on upstream interfaces."
    },
    {
      "@id": "cc:Service",
      "@type": "owl:Class",
      "rdfs:label": "Service",
      "rdfs:comment": "A microservice of the target claims platform (Java/Spring on OpenShift) that owns its own database tables, exposes APIs and publishes or consumes Kafka topics.",
      "skos:altLabel": "Microservice"
    },
    {
      "@id": "cc:KafkaTopic",
      "@type": "owl:Class",
      "rdfs:label": "Kafka Topic",
      "rdfs:comment": "A topic on the event streaming platform, with partitions and a retention period, published and consumed by services."
    },
    {
      "@id": "cc:BusinessRule",
      "@type": "owl:Class",
      "rdfs:label": "Business Rule",
      "rdfs:comment": "A claims business rule identified by a rule id within a functional area (fraud, reserving, triage, settlement and so on). Its wording, parameters, status and effective dates belong to its Rule Versions."
    },
    {
      "@id": "cc:RuleVersion",
      "@type": "owl:Class",
      "rdfs:label": "Rule Version",
      "rdfs:comment": "One numbered version of a Business Rule, with its own status (draft, approved, superseded or withdrawn), effective dates, rule text and parameters. A draft version has no effective dates."
    },
    {
      "@id": "cc:Regulation",
      "@type": "owl:Class",
      "rdfs:label": "Regulation",
      "rdfs:comment": "A circular or other requirement issued by the regulator, with publication and effective dates. Business rules are governed by it.",
      "skos:altLabel": "Regulatory Circular"
    },
    {
      "@id": "cc:RegulatoryReport",
      "@type": "owl:Class",
      "rdfs:label": "Regulatory Report",
      "rdfs:comment": "A periodic return submitted to the regulator, prepared by a named person and fed by interfaces.",
      "skos:altLabel": "Regulatory Return"
    },
    {
      "@id": "cc:Product",
      "@type": "owl:Class",
      "rdfs:label": "Product",
      "rdfs:comment": "An insurance product sold in one region, with a line of business, currency, Excess and policy wordings. A product covers a set of Claim Types."
    },
    {
      "@id": "cc:ClaimType",
      "@type": "owl:Class",
      "rdfs:label": "Claim Type",
      "rdfs:comment": "The classification of a claim by the kind of event that caused the damage, with a short code and local-language names."
    },
    {
      "@id": "cc:ProcessStage",
      "@type": "owl:Class",
      "rdfs:label": "Process Stage",
      "rdfs:comment": "One of the ordered top-level stages of the end-to-end claims process, with an accountable owner who can change over time."
    },
    {
      "@id": "cc:ProcessStep",
      "@type": "owl:Class",
      "rdfs:label": "Process Step",
      "rdfs:comment": "An ordered activity within a process stage, with a service level, RACI assignments, the systems it is performed in and decision branches to the next steps."
    },
    {
      "@id": "cc:ClaimsAssessor",
      "@type": "owl:Class",
      "rdfs:label": "Claims Assessor",
      "rdfs:comment": "A person or panel firm that inspects or desk-assesses a loss and reports an estimate and a view on cover. Internal Claims Assessors are employees of the insurer; external Claims Assessors come from panel vendor firms."
    },
    {
      "@id": "cc:Claim",
      "@type": "owl:Class",
      "rdfs:label": "Claim",
      "rdfs:comment": "An individual insurance claim with a claim reference, Claim Type, product, dates, Reserve, payments, Fraud Score and appointed Claims Assessor."
    },
    {
      "@id": "cc:Incident",
      "@type": "owl:Class",
      "rdfs:label": "Incident",
      "rdfs:comment": "A production incident with a number, severity, date, root cause and status. It affects systems, programs or interfaces and is fixed through tickets."
    },
    {
      "@id": "cc:ArchitectureDecision",
      "@type": "owl:Class",
      "rdfs:label": "Architecture Decision",
      "rdfs:comment": "An architecture decision record with an id, title, date, status and deciders. A later decision can supersede an earlier one.",
      "skos:altLabel": "Architecture Decision Record"
    },
    {
      "@id": "cc:Ticket",
      "@type": "owl:Class",
      "rdfs:label": "Ticket",
      "rdfs:comment": "A work item in the programme's issue tracker (bug, story or task) with a key, summary, status, assignee and fix version."
    },
    {
      "@id": "cc:Milestone",
      "@type": "owl:Class",
      "rdfs:label": "Milestone",
      "rdfs:comment": "A dated programme milestone: a go-live, a migration wave, a parallel run or a decommission target."
    },
    {
      "@id": "cc:reportsTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "REPORTS_TO",
      "rdfs:comment": "The subject person's line manager is the object person. Reporting lines change over time; take the one the source states for its own date.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Person"
      }
    },
    {
      "@id": "cc:memberOf",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "MEMBER_OF",
      "rdfs:comment": "The person works in the team.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Team"
      }
    },
    {
      "@id": "cc:leads",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "LEADS",
      "rdfs:comment": "The person is the lead of the team (time-dependent).",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Team"
      }
    },
    {
      "@id": "cc:headsDepartment",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "HEADS_DEPARTMENT",
      "rdfs:comment": "The person is the head of the department (time-dependent).",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Department"
      }
    },
    {
      "@id": "cc:partOfDepartment",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "PART_OF_DEPARTMENT",
      "rdfs:comment": "The team sits inside the department.",
      "rdfs:domain": {
        "@id": "cc:Team"
      },
      "rdfs:range": {
        "@id": "cc:Department"
      }
    },
    {
      "@id": "cc:locatedIn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "LOCATED_IN",
      "rdfs:comment": "The person's work location (office or external site).",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Location"
      }
    },
    {
      "@id": "cc:employedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "EMPLOYED_BY",
      "rdfs:comment": "The organisation that employs the person: the insurer, a consultancy, a supplier or the regulator.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Organisation"
      }
    },
    {
      "@id": "cc:ownsSystem",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "OWNS_SYSTEM",
      "rdfs:comment": "The person is the accountable owner of the system.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:System"
      }
    },
    {
      "@id": "cc:ownsProcess",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "OWNS_PROCESS",
      "rdfs:comment": "The person is the accountable owner of the process stage. Owners change over time; take the one the source states for its own date.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:ProcessStage"
      }
    },
    {
      "@id": "cc:ownsInterface",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "OWNS_INTERFACE",
      "rdfs:comment": "The person is the accountable owner of the interface.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:Interface"
      }
    },
    {
      "@id": "cc:ownsService",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "OWNS_SERVICE",
      "rdfs:comment": "The team owns, builds and runs the service (time-dependent).",
      "rdfs:domain": {
        "@id": "cc:Team"
      },
      "rdfs:range": {
        "@id": "cc:Service"
      }
    },
    {
      "@id": "cc:ownsRule",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "OWNS_RULE",
      "rdfs:comment": "The person is the business owner of the rule.",
      "rdfs:domain": {
        "@id": "cc:Person"
      },
      "rdfs:range": {
        "@id": "cc:BusinessRule"
      }
    },
    {
      "@id": "cc:ownsTable",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "OWNS_TABLE",
      "rdfs:comment": "The service owns the table in its own database (one database per service).",
      "rdfs:domain": {
        "@id": "cc:Service"
      },
      "rdfs:range": {
        "@id": "cc:DatabaseTable"
      }
    },
    {
      "@id": "cc:writesToTable",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "WRITES_TO_TABLE",
      "rdfs:comment": "The program inserts, updates or deletes rows in the table.",
      "rdfs:domain": {
        "@id": "cc:Program"
      },
      "rdfs:range": {
        "@id": "cc:DatabaseTable"
      }
    },
    {
      "@id": "cc:readsFromTable",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "READS_FROM_TABLE",
      "rdfs:comment": "The program reads rows from the table.",
      "rdfs:domain": {
        "@id": "cc:Program"
      },
      "rdfs:range": {
        "@id": "cc:DatabaseTable"
      }
    },
    {
      "@id": "cc:callsProgram",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "CALLS_PROGRAM",
      "rdfs:comment": "The subject program calls the object program (a COBOL CALL or a CICS LINK).",
      "rdfs:domain": {
        "@id": "cc:Program"
      },
      "rdfs:range": {
        "@id": "cc:Program"
      }
    },
    {
      "@id": "cc:usesCopybook",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "USES_COPYBOOK",
      "rdfs:comment": "The program includes the copybook.",
      "rdfs:domain": {
        "@id": "cc:Program"
      },
      "rdfs:range": {
        "@id": "cc:Copybook"
      }
    },
    {
      "@id": "cc:runsProgram",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "RUNS_PROGRAM",
      "rdfs:comment": "A step of the batch job runs the program.",
      "rdfs:domain": {
        "@id": "cc:BatchJob"
      },
      "rdfs:range": {
        "@id": "cc:Program"
      }
    },
    {
      "@id": "cc:displaysMap",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "DISPLAYS_MAP",
      "rdfs:comment": "The online program sends and receives the screen map.",
      "rdfs:domain": {
        "@id": "cc:Program"
      },
      "rdfs:range": {
        "@id": "cc:ScreenMap"
      }
    },
    {
      "@id": "cc:partOfSystem",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "PART_OF_SYSTEM",
      "rdfs:comment": "The component (program, service, table, batch job, screen map, copybook or Kafka topic) is part of the system.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:Program"
            },
            {
              "@id": "cc:Service"
            },
            {
              "@id": "cc:DatabaseTable"
            },
            {
              "@id": "cc:BatchJob"
            },
            {
              "@id": "cc:ScreenMap"
            },
            {
              "@id": "cc:Copybook"
            },
            {
              "@id": "cc:KafkaTopic"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "cc:System"
      }
    },
    {
      "@id": "cc:sourceSystem",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "SOURCE_SYSTEM",
      "rdfs:comment": "The system the interface takes its data from.",
      "rdfs:domain": {
        "@id": "cc:Interface"
      },
      "rdfs:range": {
        "@id": "cc:System"
      }
    },
    {
      "@id": "cc:targetSystem",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "TARGET_SYSTEM",
      "rdfs:comment": "The system the interface delivers its data to.",
      "rdfs:domain": {
        "@id": "cc:Interface"
      },
      "rdfs:range": {
        "@id": "cc:System"
      }
    },
    {
      "@id": "cc:dependsOnInterface",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "DEPENDS_ON_INTERFACE",
      "rdfs:comment": "The subject interface needs the output of the object (upstream) interface; a change to the object interface can break the subject.",
      "rdfs:domain": {
        "@id": "cc:Interface"
      },
      "rdfs:range": {
        "@id": "cc:Interface"
      }
    },
    {
      "@id": "cc:consumesInterface",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "CONSUMES_INTERFACE",
      "rdfs:comment": "The team uses the data the interface delivers.",
      "rdfs:domain": {
        "@id": "cc:Team"
      },
      "rdfs:range": {
        "@id": "cc:Interface"
      }
    },
    {
      "@id": "cc:feedsReport",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "FEEDS_REPORT",
      "rdfs:comment": "The interface supplies data used to produce the regulatory report.",
      "rdfs:domain": {
        "@id": "cc:Interface"
      },
      "rdfs:range": {
        "@id": "cc:RegulatoryReport"
      }
    },
    {
      "@id": "cc:suppliedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "SUPPLIED_BY",
      "rdfs:comment": "The organisation that supplies or licenses the system.",
      "rdfs:domain": {
        "@id": "cc:System"
      },
      "rdfs:range": {
        "@id": "cc:Organisation"
      }
    },
    {
      "@id": "cc:replacesProgram",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "REPLACES_PROGRAM",
      "rdfs:comment": "The service takes over the function of the legacy program.",
      "rdfs:domain": {
        "@id": "cc:Service"
      },
      "rdfs:range": {
        "@id": "cc:Program"
      }
    },
    {
      "@id": "cc:replacesSystem",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "REPLACES_SYSTEM",
      "rdfs:comment": "The subject system takes over the function of the object system.",
      "rdfs:domain": {
        "@id": "cc:System"
      },
      "rdfs:range": {
        "@id": "cc:System"
      }
    },
    {
      "@id": "cc:renamedTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "RENAMED_TO",
      "rdfs:comment": "Links an entity under its former name to the same entity under its new name. Both ends are the same kind of entity (a system, service, program, team or person).",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:Person"
            },
            {
              "@id": "cc:Team"
            },
            {
              "@id": "cc:System"
            },
            {
              "@id": "cc:Program"
            },
            {
              "@id": "cc:Service"
            }
          ]
        }
      },
      "rdfs:range": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:Person"
            },
            {
              "@id": "cc:Team"
            },
            {
              "@id": "cc:System"
            },
            {
              "@id": "cc:Program"
            },
            {
              "@id": "cc:Service"
            }
          ]
        }
      }
    },
    {
      "@id": "cc:publishesTopic",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "PUBLISHES_TOPIC",
      "rdfs:comment": "The service produces events to the topic.",
      "rdfs:domain": {
        "@id": "cc:Service"
      },
      "rdfs:range": {
        "@id": "cc:KafkaTopic"
      }
    },
    {
      "@id": "cc:consumesTopic",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "CONSUMES_TOPIC",
      "rdfs:comment": "The service consumes events from the topic.",
      "rdfs:domain": {
        "@id": "cc:Service"
      },
      "rdfs:range": {
        "@id": "cc:KafkaTopic"
      }
    },
    {
      "@id": "cc:implementsRule",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "IMPLEMENTS_RULE",
      "rdfs:comment": "The program or service contains the logic that applies the business rule.",
      "rdfs:domain": {
        "@type": "owl:Class",
        "owl:unionOf": {
          "@list": [
            {
              "@id": "cc:Program"
            },
            {
              "@id": "cc:Service"
            }
          ]
        }
      },
      "rdfs:range": {
        "@id": "cc:BusinessRule"
      }
    },
    {
      "@id": "cc:hasVersion",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "HAS_VERSION",
      "rdfs:comment": "The rule has this numbered version. Each version carries its own text, parameters, status and effective dates.",
      "rdfs:domain": {
        "@id": "cc:BusinessRule"
      },
      "rdfs:range": {
        "@id": "cc:RuleVersion"
      }
    },
    {
      "@id": "cc:supersedes",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "SUPERSEDES",
      "rdfs:comment": "The subject rule replaces the object rule, a different rule id, which stops applying. For a newer version of the same rule replacing an older one, use SUPERSEDES_VERSION.",
      "rdfs:domain": {
        "@id": "cc:BusinessRule"
      },
      "rdfs:range": {
        "@id": "cc:BusinessRule"
      }
    },
    {
      "@id": "cc:supersedesVersion",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "SUPERSEDES_VERSION",
      "rdfs:comment": "The subject version of a rule replaces the object (earlier) version of the same rule.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "cc:RuleVersion"
      }
    },
    {
      "@id": "cc:approvedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "APPROVED_BY",
      "rdfs:comment": "A person who approved this version of the rule.",
      "rdfs:domain": {
        "@id": "cc:RuleVersion"
      },
      "rdfs:range": {
        "@id": "cc:Person"
      }
    },
    {
      "@id": "cc:governedBy",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "GOVERNED_BY",
      "rdfs:comment": "The rule exists to meet, or is constrained by, the regulation.",
      "rdfs:domain": {
        "@id": "cc:BusinessRule"
      },
      "rdfs:range": {
        "@id": "cc:Regulation"
      }
    },
    {
      "@id": "cc:appliesToClaimType",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "APPLIES_TO_CLAIM_TYPE",
      "rdfs:comment": "The rule applies to claims of this Claim Type.",
      "rdfs:domain": {
