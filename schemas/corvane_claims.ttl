cc:rootCause a owl:DatatypeProperty ;
    rdfs:label "rootCause" ;
    rdfs:comment "The root cause of the incident." ;
    rdfs:domain cc:Incident ;
    rdfs:range xsd:string .

cc:ruleArea a owl:DatatypeProperty ;
    rdfs:label "ruleArea" ;
    rdfs:comment "The functional area of the rule, for example fraud, reserving, triage or settlement." ;
    rdfs:domain cc:BusinessRule ;
    rdfs:range xsd:string .

cc:ruleText a owl:DatatypeProperty ;
    rdfs:label "ruleText" ;
    rdfs:comment "The wording of the rule in this version." ;
    rdfs:domain cc:RuleVersion ;
    rdfs:range xsd:string .

cc:runsProgram a owl:ObjectProperty ;
    rdfs:label "RUNS_PROGRAM" ;
    rdfs:comment "A step of the batch job runs the program." ;
    rdfs:domain cc:BatchJob ;
    rdfs:range cc:Program .

cc:schedule a owl:DatatypeProperty ;
    rdfs:label "schedule" ;
    rdfs:comment "When the interface or batch job runs, as stated (for example a daily time). Schedules change over time." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cc:Interface cc:BatchJob ) ] ;
    rdfs:range xsd:string .

cc:schemaName a owl:DatatypeProperty ;
    rdfs:label "schemaName" ;
    rdfs:comment "The database schema that qualifies the table name." ;
    rdfs:domain cc:DatabaseTable ;
    rdfs:range xsd:string .

cc:sequenceNumber a owl:DatatypeProperty ;
    rdfs:label "sequenceNumber" ;
    rdfs:comment "Position of the stage or step in the process order." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cc:ProcessStage cc:ProcessStep ) ] ;
    rdfs:range xsd:integer .

cc:serviceLevel a owl:DatatypeProperty ;
    rdfs:label "serviceLevel" ;
    rdfs:comment "The service-level target of the step, for example a number of business days." ;
    rdfs:domain cc:ProcessStep ;
    rdfs:range xsd:string .

cc:severity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:comment "Severity rating of the incident." ;
    rdfs:domain cc:Incident ;
    rdfs:range xsd:string .

cc:sourceSystem a owl:ObjectProperty ;
    rdfs:label "SOURCE_SYSTEM" ;
    rdfs:comment "The system the interface takes its data from." ;
    rdfs:domain cc:Interface ;
    rdfs:range cc:System .

cc:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "Lifecycle or workflow status as the source states it, for example legacy, target or retired for a system; draft, approved, superseded or withdrawn for a rule version; open, in review or done for a ticket. Time-dependent." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cc:System cc:Program cc:Service cc:Interface cc:BatchJob cc:RuleVersion cc:ArchitectureDecision cc:Incident cc:Ticket cc:Milestone cc:Claim ) ] ;
    rdfs:range xsd:string .

cc:subrogationFlag a owl:DatatypeProperty ;
    rdfs:label "subrogationFlag" ;
    rdfs:comment "True when Subrogation is being pursued for the claim." ;
    rdfs:domain cc:Claim ;
    rdfs:range xsd:boolean .

cc:supersedes a owl:ObjectProperty ;
    rdfs:label "SUPERSEDES" ;
    rdfs:comment "The subject rule replaces the object rule, a different rule id, which stops applying. For a newer version of the same rule replacing an older one, use SUPERSEDES_VERSION." ;
    rdfs:domain cc:BusinessRule ;
    rdfs:range cc:BusinessRule .

cc:supersedesDecision a owl:ObjectProperty ;
    rdfs:label "SUPERSEDES_DECISION" ;
    rdfs:comment "The subject decision replaces the object (earlier) decision." ;
    rdfs:domain cc:ArchitectureDecision ;
    rdfs:range cc:ArchitectureDecision .

cc:supersedesVersion a owl:ObjectProperty ;
    rdfs:label "SUPERSEDES_VERSION" ;
    rdfs:comment "The subject version of a rule replaces the object (earlier) version of the same rule." ;
    rdfs:domain cc:RuleVersion ;
    rdfs:range cc:RuleVersion .

cc:suppliedBy a owl:ObjectProperty ;
    rdfs:label "SUPPLIED_BY" ;
    rdfs:comment "The organisation that supplies or licenses the system." ;
    rdfs:domain cc:System ;
    rdfs:range cc:Organisation .

cc:targetSystem a owl:ObjectProperty ;
    rdfs:label "TARGET_SYSTEM" ;
    rdfs:comment "The system the interface delivers its data to." ;
    rdfs:domain cc:Interface ;
    rdfs:range cc:System .

cc:technology a owl:DatatypeProperty ;
    rdfs:label "technology" ;
    rdfs:comment "The technology stack of the system." ;
    rdfs:domain cc:System ;
    rdfs:range xsd:string .

cc:threshold a owl:DatatypeProperty ;
    rdfs:label "threshold" ;
    rdfs:comment "The main numeric trigger value set by the rule version, for example a score or a monetary limit. Pair a monetary threshold with currency." ;
    rdfs:domain cc:RuleVersion ;
    rdfs:range xsd:decimal .

cc:ticketType a owl:DatatypeProperty ;
    rdfs:label "ticketType" ;
    rdfs:comment "Type of the ticket, for example bug, story or task." ;
    rdfs:domain cc:Ticket ;
    rdfs:range xsd:string .

cc:tier a owl:DatatypeProperty ;
    rdfs:label "tier" ;
    rdfs:comment "The complexity tier of the claim (1 to 3); tier 3 marks a Tier-3 Claim." ;
    rdfs:domain cc:Claim ;
    rdfs:range xsd:integer .

cc:tier3Threshold a owl:DatatypeProperty ;
    rdfs:label "tier3Threshold" ;
    rdfs:comment "A threshold that applies only to Tier-3 Claims, where the rule version sets one that differs from the main threshold." ;
    rdfs:domain cc:RuleVersion ;
    rdfs:range xsd:decimal .

cc:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:comment "The title or summary line of a rule, regulation, decision record, incident, ticket or screen." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cc:BusinessRule cc:Regulation cc:ArchitectureDecision cc:Incident cc:Ticket cc:ScreenMap ) ] ;
    rdfs:range xsd:string .

cc:transactionCode a owl:DatatypeProperty ;
    rdfs:label "transactionCode" ;
    rdfs:comment "The CICS transaction id that starts the program or shows the screen map." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( cc:Program cc:ScreenMap ) ] ;
    rdfs:range xsd:string .

cc:usesCopybook a owl:ObjectProperty ;
    rdfs:label "USES_COPYBOOK" ;
    rdfs:comment "The program includes the copybook." ;
    rdfs:domain cc:Program ;
    rdfs:range cc:Copybook .

cc:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "The version number of the rule version." ;
    rdfs:domain cc:RuleVersion ;
    rdfs:range xsd:string .

cc:writesToTable a owl:ObjectProperty ;
    rdfs:label "WRITES_TO_TABLE" ;
    rdfs:comment "The program inserts, updates or deletes rows in the table." ;
    rdfs:domain cc:Program ;
    rdfs:range cc:DatabaseTable .

cc:ClaimsAssessor a owl:Class ;
    rdfs:label "Claims Assessor" ;
    rdfs:comment "A person or panel firm that inspects or desk-assesses a loss and reports an estimate and a view on cover. Internal Claims Assessors are employees of the insurer; external Claims Assessors come from panel vendor firms." .

cc:Copybook a owl:Class ;
    rdfs:label "Copybook" ;
    rdfs:comment "A COBOL copybook: a shared record layout included by programs, usually the layout of one database table or one interface record." .

cc:BatchJob a owl:Class ;
    rdfs:label "Batch Job" ;
    rdfs:comment "A scheduled JCL batch job made of steps, each of which runs a program." ;
    skos:altLabel "JCL Job" .

cc:Department a owl:Class ;
    rdfs:label "Department" ;
    rdfs:comment "A top-level division of the insurer that groups teams and has a head." .

cc:ProcessStage a owl:Class ;
    rdfs:label "Process Stage" ;
    rdfs:comment "One of the ordered top-level stages of the end-to-end claims process, with an accountable owner who can change over time." .

cc:KafkaTopic a owl:Class ;
    rdfs:label "Kafka Topic" ;
    rdfs:comment "A topic on the event streaming platform, with partitions and a retention period, published and consumed by services." .

cc:Milestone a owl:Class ;
    rdfs:label "Milestone" ;
    rdfs:comment "A dated programme milestone: a go-live, a migration wave, a parallel run or a decommission target." .

cc:RegulatoryReport a owl:Class ;
    rdfs:label "Regulatory Report" ;
    rdfs:comment "A periodic return submitted to the regulator, prepared by a named person and fed by interfaces." ;
    skos:altLabel "Regulatory Return" .

cc:ScreenMap a owl:Class ;
    rdfs:label "Screen Map" ;
    rdfs:comment "A BMS screen map (with its mapset) that an online program displays under a CICS transaction." ;
    skos:altLabel "BMS Map" .

cc:ClaimType a owl:Class ;
    rdfs:label "Claim Type" ;
    rdfs:comment "The classification of a claim by the kind of event that caused the damage, with a short code and local-language names." .

cc:Regulation a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:comment "A circular or other requirement issued by the regulator, with publication and effective dates. Business rules are governed by it." ;
    skos:altLabel "Regulatory Circular" .

cc:ArchitectureDecision a owl:Class ;
    rdfs:label "Architecture Decision" ;
    rdfs:comment "An architecture decision record with an id, title, date, status and deciders. A later decision can supersede an earlier one." ;
    skos:altLabel "Architecture Decision Record" .

cc:DatabaseTable a owl:Class ;
    rdfs:label "Database Table" ;
    rdfs:comment "A relational table in the legacy DB2 database or in a target PostgreSQL database, identified by its schema-qualified name." .

cc:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A physical site: an office, a data centre, or an office of an external organisation." .

cc:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    rdfs:comment "A legal entity: the insurer itself, a supplier or panel firm, a consultancy, a reinsurer, a bank or the regulator." ;
    skos:altLabel "Organization" .

cc:Ticket a owl:Class ;
    rdfs:label "Ticket" ;
    rdfs:comment "A work item in the programme's issue tracker (bug, story or task) with a key, summary, status, assignee and fix version." .

cc:Incident a owl:Class ;
    rdfs:label "Incident" ;
    rdfs:comment "A production incident with a number, severity, date, root cause and status. It affects systems, programs or interfaces and is fixed through tickets." .

cc:ProcessStep a owl:Class ;
    rdfs:label "Process Step" ;
    rdfs:comment "An ordered activity within a process stage, with a service level, RACI assignments, the systems it is performed in and decision branches to the next steps." .

cc:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "An insurance product sold in one region, with a line of business, currency, Excess and policy wordings. A product covers a set of Claim Types." .

cc:Team a owl:Class ;
    rdfs:label "Team" ;
    rdfs:comment "A named working group with a lead and staff, inside a department. Team names and leads change over time." .

cc:BusinessRule a owl:Class ;
    rdfs:label "Business Rule" ;
    rdfs:comment "A claims business rule identified by a rule id within a functional area (fraud, reserving, triage, settlement and so on). Its wording, parameters, status and effective dates belong to its Rule Versions." .

cc:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A microservice of the target claims platform (Java/Spring on OpenShift) that owns its own database tables, exposes APIs and publishes or consumes Kafka topics." ;
    skos:altLabel "Microservice" .

cc:RuleVersion a owl:Class ;
    rdfs:label "Rule Version" ;
    rdfs:comment "One numbered version of a Business Rule, with its own status (draft, approved, superseded or withdrawn), effective dates, rule text and parameters. A draft version has no effective dates." .

cc:Interface a owl:Class ;
    rdfs:label "Interface" ;
    rdfs:comment "A data feed or integration from a source system to a target system, with a protocol, format, schedule and owner. An interface can depend on upstream interfaces." .

cc:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:comment "An application or platform, legacy or target: the core claims platforms, a fraud-scoring engine, a portal, a data warehouse, a scheduler. Programs, services, tables, batch jobs and topics are parts of a system." .

cc:Claim a owl:Class ;
    rdfs:label "Claim" ;
    rdfs:comment "An individual insurance claim with a claim reference, Claim Type, product, dates, Reserve, payments, Fraud Score and appointed Claims Assessor." .

cc:Program a owl:Class ;
    rdfs:label "Program" ;
    rdfs:comment "A COBOL program of the legacy claims platform, identified by its eight-character program name. Online programs run under a CICS transaction; batch programs run as steps of batch jobs." ;
    skos:altLabel "COBOL Program" .

cc:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "An individual: an employee of the insurer, a consultant, a contact at a supplier, or someone who works for the regulator. Job titles and role names are values of jobTitle, never separate Person nodes." .

