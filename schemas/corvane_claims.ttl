cc:affectedProgram a owl:ObjectProperty ;
    rdfs:label "AFFECTED_PROGRAM" ;
    rdfs:comment "The incident involved the program." ;
    rdfs:domain cc:Incident ;
    rdfs:range cc:Program .

cc:affectedSystem a owl:ObjectProperty ;
    rdfs:label "AFFECTED_SYSTEM" ;
    rdfs:comment "The incident affected the system." ;
    rdfs:domain cc:Incident ;
    rdfs:range cc:System .

