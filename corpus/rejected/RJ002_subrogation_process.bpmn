<bpmn:process id="Process_Subrogation" name="Recovery &amp; Subrogation" isExecutable="false"><bpmn:documentation>Recovery &amp; Subrogation (stage S7). Process owner: Freya Lindahl, Head of Recoveries &amp; Subrogation. Model version 1.2, 2025-10-02. Systems: Subrogation Tracker (SUBTRAK) and CLARA.</bpmn:documentation><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_Team" name="Recoveries &amp; Subrogation (Group)"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Potential</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Salvage</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Open</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_Pursue</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Receipt</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Head" name="Head of Recoveries &amp; Subrogation"><bpmn:flowNodeRef>Task_WriteOff</bpmn:flowNodeRef><bpmn:flowNodeRef>End_None</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Solicitor" name="Quarryhill Solicitors LLP (external)"><bpmn:flowNodeRef>Task_Solicitor</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_1" name="Recovery potential flagged on claim"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="Task_Identify" name="Identify recovery potential"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Gw_Potential" name="Recovery route?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Task_Salvage" name="Salvage disposal"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:task id="Task_Open" name="Open subrogation case and demand"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOut_Open"><bpmn:targetRef>