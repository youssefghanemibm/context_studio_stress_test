  "definitions": [
    {
      "term": "Fraud Referral",
      "definition": "Referral of a claim to the Counter-Fraud & SIU team for investigation.",
      "source": "Programme glossary G-002"
    },
    {
      "term": "Tier-3 Claim",
      "definition": "A claim meeting the Tier-3 definition in BR-TRI-003 (v3 from 2025-01-01).",
      "source": "Programme glossary G-008"
    },
    {
      "term": "Fraud Score",
      "definition": "Sentinel score from 0 to 100.",
      "source": "Programme glossary G-009"
    },
    {
      "term": "Customer Referral Notice",
      "definition": "Written notice to the customer that a claim is subject to additional checks (BR-FRD-032).",
      "source": "Programme glossary G-021"
    },
    {
      "term": "Counter-Fraud & SIU",
      "definition": "The Special Investigations Unit (renamed Counter-Fraud & SIU on 2025-09-01).",
      "source": "Programme glossary G-012"
    },
    {
      "term": "BR-FRD-031 v1",
      "definition": "Refer a claim to SIU when the Sentinel score is 65 or more (all tiers).",
      "source": "NISA Circular 2026/04 §3.3; Claims Handling Manual v7.2 §28.3"
    },
    {
      "term": "BR-FRD-032 v2",
      "definition": "Notify the customer in writing within 10 business days of a fraud referral that the claim is subject to additional checks, unless the notice is deferred under BR-FRD-036.",
      "source": "NISA Circular 2026/04 §3.2; APPROVED BRD v1.0 (2026-03-12); Claims Handling Manual v7.2 §29.1"
    },
    {
      "term": "BR-FRD-033 v1",
      "definition": "No claim may be declined, reduced or repudiated on the basis of an automated fraud score alone; every adverse outcome requires a documented human review by SIU.",
      "source": "NISA Circular 2026/04 §3.1; Claims Handling Manual v7.2 §28.6"
    },
    {
      "term": "BR-FRD-034 v1",
      "definition": "Submit the NISA-FR1 fraud referral return within 30 calendar days after each quarter end; first return for Q2 2026 due 2026-07-30.",
      "source": "NISA Circular 2026/04 §3.4"
    },
    {
      "term": "BR-FRD-035 v2",
      "definition": "SIU must triage a new referral within 3 business days.",
      "source": "Claims Handling Manual v7.2 §30.1"
    }
  ],
  "lineage": [
    {
      "step": 1,
      "what": "Referral records in CLR.T_FRAUD_REFERRAL and fraud.referral (Claims Hub, migrated products PRD-HOM-DK, PRD-MOT-DK, PRD-MOT-UK)"
