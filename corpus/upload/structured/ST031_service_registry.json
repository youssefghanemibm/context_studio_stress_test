      "id": "SVC01",
      "name": "claim-core-svc",
      "description": "Claim aggregate (claim header, parties, status); system of record for migrated claims",
      "status": "live",
      "goLive": "2025-11-03",
      "owner": {
        "team": "Hub Squad – Intake & Triage",
        "teamId": "T27",
        "lead": "Sofie Bak"
      },
      "runtime": {
        "namespace": "chub-core",
        "replicas": 3,
        "image": "registry.corvane.internal/chub/claim-core-svc",
        "cluster": "ocp-prd-lon1",
        "drCluster": "ocp-dr-lds1"
      },
      "endpoints": {
        "internal": "http://claim-core-svc.chub-core.svc.cluster.local:8080",
        "route": "https://claim-core-svc.apps.ocp-prd-lon1.corvane.internal",
        "openapi": "https://claim-core-svc.apps.ocp-prd-lon1.corvane.internal/v3/api-docs",
        "health": "/actuator/health"
      },
      "apis": [
        {
          "method": "GET",
          "path": "/claims/{claimId}",
          "summary": "Get a claim by reference (CLM-UK-2025-118204 format)"
        },
        {
          "method": "POST",
          "path": "/claims",
          "summary": "Create a claim from an FNOL"
        },
        {
          "method": "PATCH",
