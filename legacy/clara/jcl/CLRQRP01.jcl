//CLRQRP01 JOB (CLR,PROD),'QUARTERLY NISA EXTRA',CLASS=B,MSGCLASS=X,
//             MSGLEVEL=(1,1),REGION=0M,NOTIFY=&SYSUID
//* ------------------------------------------------------------------*
//* JOB       : CLRQRP01                                              *
//* FUNCTION  : QUARTERLY NISA EXTRACTS                               *
//* SCHEDULE  : QUARTERLY, 4TH BUSINESS DAY AFTER QUARTER END (BATCH  *
//*             SCHEDULER)                                            *
//* SUPPORT   : MAINFRAME BATCH OPERATIONS                            *
//* STEPS     : STEP010 CLRRP030 NISA-TP2 DATA EXTRACT                *
//*             STEP020 CLRRP040 NISA-CT1 CLAIMS TIMELINESS EXTRACT   *
//*                              (CLX-IF-032)                         *
//*             STEP030 CLRRP060 FRAUD REFERRAL MI (NISA-FR1          *
//*                              SUPPORT)                             *
//* ------------------------------------------------------------------*
//* SITE SYMBOLS (HLQS, DB2 SUBSYSTEM AND PLAN) COME FROM THE INCLUDE
//         INCLUDE MEMBER=CLRSYMS
//JOBLIB   DD DSN=&CLRHLQ..LOADLIB,DISP=SHR
//         DD DSN=&DB2HLQ..SDSNLOAD,DISP=SHR
//*
//* STEP010 - NISA-TP2 DATA EXTRACT
//*
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//RPTOUT   DD SYSOUT=*
//EXTOUT   DD DSN=&CLRHLQ..CLRRP030.EXTOUT(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&DB2SSID)
  RUN PROGRAM(CLRRP030) PLAN(&DB2PLAN) -
      LIB('&CLRHLQ..LOADLIB')
  END
/*
//*
//* STEP020 - NISA-CT1 CLAIMS TIMELINESS EXTRACT (CLX-IF-032)
//*
//STEP020  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//RPTOUT   DD SYSOUT=*
//EXTOUT   DD DSN=&CLRHLQ..CLRRP040.EXTOUT(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(5,5),RLSE),DCB=(RECFM=FB,LRECL=400,BLKSIZE=0)
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&DB2SSID)
  RUN PROGRAM(CLRRP040) PLAN(&DB2PLAN) -
      LIB('&CLRHLQ..LOADLIB')
  END
/*
//*
//* STEP030 - FRAUD REFERRAL MI (NISA-FR1 SUPPORT)
//*
//STEP030  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT)
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=D
//RPTOUT   DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&DB2SSID)
  RUN PROGRAM(CLRRP060) PLAN(&DB2PLAN) -
      LIB('&CLRHLQ..LOADLIB')
  END
/*
//
