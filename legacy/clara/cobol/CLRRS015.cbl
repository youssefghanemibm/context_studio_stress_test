014900* ---------------------------------------------------------------*
015000 2300-READ-USER.
015100     MOVE WS-USER-ID TO USRR-USER-ID
015200     SET WS-ROW-FOUND TO TRUE
015300     EXEC SQL
015400         SELECT USER_ID, USER_NAME, TEAM_CD, RSV_AUTH_LEVEL
015500                , PAY_AUTH_LEVEL
015600           INTO :USRR-USER-ID, :USRR-USER-NAME, :USRR-TEAM-CD
015700                , :USRR-RSV-AUTH-LEVEL, :USRR-PAY-AUTH-LEVEL
015800           FROM CLR.T_USER
015900          WHERE USER_ID = :USRR-USER-ID
016000     END-EXEC
016100     EVALUATE SQLCODE
016200        WHEN 0
016300           ADD 1 TO WS-USER-READ
016400        WHEN +100
016500           SET WS-ROW-NOT-FOUND TO TRUE
016600        WHEN OTHER
016700           MOVE 'READ CLR.T_USER' TO ERR-PARA
