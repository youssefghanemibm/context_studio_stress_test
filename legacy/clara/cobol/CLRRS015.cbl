010300* ---------------------------------------------------------------*
010400* 1200-CHECK-PARAMETERS                                          *
010500* PARAMETER TABLE SANITY CHECK                                   *
010600* ---------------------------------------------------------------*
010700 1200-CHECK-PARAMETERS.
010800     EXEC SQL
010900         SELECT COUNT(*)
011000           INTO :WS-PARM-ROWS
011100           FROM CLR.T_PARAM
011200          WHERE PARAM_KEY LIKE 'RSV_%'
011300            AND VALID_FROM <= CURRENT DATE
011400            AND (VALID_TO IS NULL OR VALID_TO >= CURRENT DATE)
011500     END-EXEC
011600     EVALUATE SQLCODE
011700        WHEN 0
011800           CONTINUE
011900        WHEN OTHER
012000           MOVE '1200-CHECK-PARAMETERS' TO ERR-PARA
012100           PERFORM 8000-SQL-ERROR
012200     END-EVALUATE
012300     IF WS-PARM-ROWS = ZERO
012400        DISPLAY WS-PGM-ID ' NO CURRENT PARAMETERS FOUND'
012500        SET WS-ERROR-FOUND TO TRUE
012600     END-IF
012700     .
012800 1200-CHECK-PARAMETERS-EXIT.
012900     EXIT.
