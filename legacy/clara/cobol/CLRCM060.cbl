009300* --- 2300-READ-CODE-LOOKUP: LOOK UP CLR.T_CODE_LOOKUP
009400 2300-READ-CODE-LOOKUP.
009500     SET WS-ROW-FOUND TO TRUE
009600     EXEC SQL
009700         SELECT CODE_TYPE, CODE_VALUE, CODE_DESC_EN
009800           INTO :CODE-CODE-TYPE, :CODE-CODE-VALUE
009900                , :CODE-CODE-DESC-EN
010000           FROM CLR.T_CODE_LOOKUP
010100          WHERE CODE_TYPE = :CODE-CODE-TYPE
010200            AND CODE_VALUE = :CODE-CODE-VALUE
010300     END-EXEC
010400     EVALUATE SQLCODE
010500         WHEN 0
010600             ADD 1 TO WS-CODE-LOOKUP-READ
010700         WHEN +100
010800             SET WS-ROW-NOT-FOUND TO TRUE
010900         WHEN OTHER
011000             MOVE 'READ CLR.T_CODE_LOOKUP' TO ERR-PARA
011100             PERFORM 8000-SQL-ERROR
011200     END-EVALUATE
011300     .
011400 2300-READ-CODE-LOOKUP-EXIT.
011500     EXIT.
011600* --- 2500-EDIT-CODE-LOOKUP: FIELD EDITS FOR CLR.T_CODE_LOOKUP
011700 2500-EDIT-CODE-LOOKUP.
011800     IF CODE-CODE-TYPE = SPACES OR LOW-VALUES
011900         ADD 1 TO WS-REJECT-CNT
012000         MOVE 'CODE_TYPE MISSING' TO ERR-TEXT
012100     END-IF
012200     IF CODE-CODE-VALUE = SPACES OR LOW-VALUES
012300         ADD 1 TO WS-REJECT-CNT
012400         MOVE 'CODE_VALUE MISSING' TO ERR-TEXT
012500     END-IF
012600     IF CODE-CODE-DESC-EN = SPACES OR LOW-VALUES
012700         ADD 1 TO WS-REJECT-CNT
012800         MOVE 'CODE_DESC_EN MISSING' TO ERR-TEXT
012900     END-IF
013000     .
013100 2500-EDIT-CODE-LOOKUP-EXIT.
013200     EXIT.
013300* --- 2510-EDIT-CODE-LOOKUP-2: CHECK MANDATORY FIELDS IN CLR.T_COD
013400 2510-EDIT-CODE-LOOKUP-2.
013500     IF CODE-ACTIVE-FLAG = SPACES OR LOW-VALUES
013600         ADD 1 TO WS-REJECT-CNT
013700         MOVE 'ACTIVE_FLAG MISSING' TO ERR-TEXT
013800     END-IF
013900     .
014000 2510-EDIT-CODE-LOOKUP-2-EXIT.
014100     EXIT.
014200* --- 9000-RETURN: COPY RESULTS BACK TO THE CALLER
014300 9000-RETURN.
014400     MOVE CLR-ERROR-BLOCK TO LS-ERROR-BLOCK
014500     GOBACK.
014600 9000-RETURN-EXIT.
014700     EXIT.
014800* --- 8000-SQL-ERROR: DB2 ERROR HANDLING
014900 8000-SQL-ERROR.
015000     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
015100     MOVE WS-PGM-ID TO ERR-PGM
015200     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
015300         ERR-TEXT
015400     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
015500     GO TO 9000-RETURN.
015600 8000-SQL-ERROR-EXIT.
015700     EXIT.
