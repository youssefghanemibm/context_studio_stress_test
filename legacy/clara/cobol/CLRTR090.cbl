016200* --- 2300-READ-CLAIM-TIER: READ CLR.T_CLAIM_TIER
016300 2300-READ-CLAIM-TIER.
016400     MOVE CA-CLAIM-ID TO TIR-CLAIM-ID
016500     SET WS-ROW-FOUND TO TRUE
016600     EXEC SQL
016700         SELECT CLAIM_ID, TIER_FROM_TS, TIER_CD
016800                , TIER_REASON_CD
016900           INTO :TIR-CLAIM-ID, :TIR-TIER-FROM-TS
017000                , :TIR-TIER-CD, :TIR-TIER-REASON-CD
017100           FROM CLR.T_CLAIM_TIER
017200          WHERE CLAIM_ID = :TIR-CLAIM-ID
017300            AND TIER_FROM_TS = :TIR-TIER-FROM-TS
017400     END-EXEC
017500     EVALUATE SQLCODE
017600         WHEN 0
017700             ADD 1 TO WS-CLAIM-TIER-READ
017800         WHEN +100
017900             SET WS-ROW-NOT-FOUND TO TRUE
018000         WHEN OTHER
018100             MOVE 'READ CLR.T_CLAIM_TIER' TO ERR-PARA
018200             PERFORM 8000-SQL-ERROR
018300     END-EVALUATE
