008500 PROCEDURE DIVISION USING LS-DIARY-PARMS LS-ERROR-BLOCK.
008600* --- 0000-MAIN: ENTRY
008700 0000-MAIN.
008800     INITIALIZE CLR-ERROR-BLOCK
008900     MOVE 'CLRCM090' TO ERR-PGM
009000     PERFORM 2300-READ-CODE-LOOKUP THRU 2300-READ-CODE-LOOKUP-EXIT
009100     PERFORM 2500-EDIT-CODE-LOOKUP THRU 2500-EDIT-CODE-LOOKUP-EXIT
009200     PERFORM 2510-EDIT-DIARY THRU 2510-EDIT-DIARY-EXIT
009300     PERFORM 2520-EDIT-CODE-LOOKUP-2 THRU
009400         2520-EDIT-CODE-LOOKUP-2-EXIT
009500     PERFORM 2530-EDIT-DIARY-2 THRU 2530-EDIT-DIARY-2-EXIT
009600     PERFORM 4100-INSERT-DIARY THRU 4100-INSERT-DIARY-EXIT
009700     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
009800     .
009900 0000-MAIN-EXIT.
010000     EXIT.
010100* --- 2300-READ-CODE-LOOKUP: FETCH CLR.T_CODE_LOOKUP
010200 2300-READ-CODE-LOOKUP.
010300     SET WS-ROW-FOUND TO TRUE
010400     EXEC SQL
010500         SELECT CODE_TYPE, CODE_VALUE, CODE_DESC_EN
010600                , CODE_DESC_LOCAL, ACTIVE_FLAG
010700           INTO :CODE-CODE-TYPE, :CODE-CODE-VALUE
010800                , :CODE-CODE-DESC-EN, :CODE-CODE-DESC-LOCAL
010900                , :CODE-ACTIVE-FLAG
011000           FROM CLR.T_CODE_LOOKUP
011100          WHERE CODE_TYPE = :CODE-CODE-TYPE
011200            AND CODE_VALUE = :CODE-CODE-VALUE
011300     END-EXEC
011400     EVALUATE SQLCODE
011500         WHEN 0
011600             ADD 1 TO WS-CODE-LOOKUP-READ
011700         WHEN +100
011800             SET WS-ROW-NOT-FOUND TO TRUE
011900         WHEN OTHER
012000             MOVE 'READ CLR.T_CODE_LOOKUP' TO ERR-PARA
012100             PERFORM 8000-SQL-ERROR
012200     END-EVALUATE
012300     .
012400 2300-READ-CODE-LOOKUP-EXIT.
012500     EXIT.
012600* --- 2500-EDIT-CODE-LOOKUP: FIELD EDITS FOR CLR.T_CODE_LOOKUP
012700 2500-EDIT-CODE-LOOKUP.
012800     IF CODE-CODE-TYPE = SPACES OR LOW-VALUES
012900         ADD 1 TO WS-REJECT-CNT
013000         MOVE 'CODE_TYPE MISSING' TO ERR-TEXT
013100     END-IF
013200     IF CODE-CODE-VALUE = SPACES OR LOW-VALUES
013300         ADD 1 TO WS-REJECT-CNT
013400         MOVE 'CODE_VALUE MISSING' TO ERR-TEXT
013500     END-IF
013600     IF CODE-CODE-DESC-EN = SPACES OR LOW-VALUES
013700         ADD 1 TO WS-REJECT-CNT
013800         MOVE 'CODE_DESC_EN MISSING' TO ERR-TEXT
013900     END-IF
014000     .
014100 2500-EDIT-CODE-LOOKUP-EXIT.
014200     EXIT.
014300* --- 2510-EDIT-DIARY: FIELD EDITS FOR CLR.T_DIARY
014400 2510-EDIT-DIARY.
014500     IF DIAR-CLAIM-ID = SPACES OR LOW-VALUES
014600         ADD 1 TO WS-REJECT-CNT
014700         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
014800     END-IF
014900     IF DIAR-DUE-DT NOT = SPACES AND DIAR-DUE-DT(5:1) NOT = '-'
015000         MOVE 'DUE_DT BAD DATE' TO ERR-TEXT
015100         ADD 1 TO WS-REJECT-CNT
015200     END-IF
015300     IF DIAR-DIARY-TYPE-CD NOT = 'RREV' AND DIAR-DIARY-TYPE-CD NOT
015400         = 'LIMT' AND DIAR-DIARY-TYPE-CD NOT = 'CHAS'
015500         ADD 1 TO WS-REJECT-CNT
015600         MOVE 'DIARY_TYPE_CD INVALID' TO ERR-TEXT
015700     END-IF
015800     .
015900 2510-EDIT-DIARY-EXIT.
016000     EXIT.
016100* --- 2520-EDIT-CODE-LOOKUP-2: FIELD EDITS FOR CLR.T_CODE_LOOKUP
016200 2520-EDIT-CODE-LOOKUP-2.
016300     IF CODE-ACTIVE-FLAG = SPACES OR LOW-VALUES
016400         ADD 1 TO WS-REJECT-CNT
016500         MOVE 'ACTIVE_FLAG MISSING' TO ERR-TEXT
016600     END-IF
016700     .
016800 2520-EDIT-CODE-LOOKUP-2-EXIT.
016900     EXIT.
017000* --- 2530-EDIT-DIARY-2: VALIDATE CLR.T_DIARY
017100 2530-EDIT-DIARY-2.
017200     IF DIAR-OWNER-USER = SPACES OR LOW-VALUES
017300         ADD 1 TO WS-REJECT-CNT
017400         MOVE 'OWNER_USER MISSING' TO ERR-TEXT
017500     END-IF
017600     IF DIAR-DONE-FLAG = SPACES OR LOW-VALUES
017700         ADD 1 TO WS-REJECT-CNT
017800         MOVE 'DONE_FLAG MISSING' TO ERR-TEXT
017900     END-IF
018000     .
018100 2530-EDIT-DIARY-2-EXIT.
018200     EXIT.
018300* --- 4100-INSERT-DIARY: INSERT CLR.T_DIARY
018400 4100-INSERT-DIARY.
018500     MOVE 'RREV' TO DIAR-DIARY-TYPE-CD
018600     EXEC SQL
018700         INSERT INTO CLR.T_DIARY
018800              ( CLAIM_ID, DUE_DT, DIARY_TYPE_CD, OWNER_USER
018900              , DONE_FLAG, BATCH_RUN_ID, CREATED_TS, VERSION_NO
019000              , LAST_UPD_TS, LAST_UPD_PGM, LAST_UPD_USER )
019100         VALUES
019200              ( :DIAR-CLAIM-ID, :DIAR-DUE-DT
019300              , :DIAR-DIARY-TYPE-CD, :DIAR-OWNER-USER
019400              , :DIAR-DONE-FLAG, :DIAR-BATCH-RUN-ID
019500              , CURRENT TIMESTAMP, :DIAR-VERSION-NO
019600              , CURRENT TIMESTAMP, :WS-PGM-ID, :WS-USER-ID )
019700     END-EXEC
019800     EVALUATE SQLCODE
019900         WHEN 0
020000             ADD 1 TO WS-DIARY-WRITTEN
020100         WHEN +100
020200             SET WS-ROW-NOT-FOUND TO TRUE
020300         WHEN OTHER
020400             MOVE 'INSERT CLR.T_DIARY' TO ERR-PARA
020500             PERFORM 8000-SQL-ERROR
020600     END-EVALUATE
020700     .
020800 4100-INSERT-DIARY-EXIT.
020900     EXIT.
021000* --- 9000-RETURN: COPY RESULTS BACK TO THE CALLER
021100 9000-RETURN.
021200     MOVE CLR-ERROR-BLOCK TO LS-ERROR-BLOCK
021300     GOBACK.
021400 9000-RETURN-EXIT.
021500     EXIT.
021600* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
021700 8000-SQL-ERROR.
021800     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
021900     MOVE WS-PGM-ID TO ERR-PGM
022000     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
022100         ERR-TEXT
022200     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
022300     GO TO 9000-RETURN.
022400 8000-SQL-ERROR-EXIT.
022500     EXIT.
