024300              , :PAYR-CURRENCY-CD, :PAYR-PAY-STATUS
024400              , :PAYR-AUTH-USER, :PAYR-SANCTIONS-RESULT
024500              , :PAYR-COMMENT-TXT, CURRENT TIMESTAMP
024600              , :WS-PGM-ID, :WS-USER-ID )
024700     END-EXEC
