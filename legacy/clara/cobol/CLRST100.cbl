021200         SELECT SETTLE_ID, CLAIM_ID, OFFER_AMT, OFFER_DT
021300                , ACCEPTED_DT
021400           INTO :STLR-SETTLE-ID, :STLR-CLAIM-ID
021500                , :STLR-OFFER-AMT, :STLR-OFFER-DT
021600                , :STLR-ACCEPTED-DT
021700           FROM CLR.T_SETTLEMENT
021800          WHERE CLAIM_ID = :CLM-CLAIM-ID
021900          FETCH FIRST 1 ROW ONLY
022000     END-EXEC
022100     EVALUATE SQLCODE
022200        WHEN 0
022300           ADD 1 TO WS-SETTLEMENT-READ
