023600         INSERT INTO CLR.T_PAYMENT
023700              ( CLAIM_ID, PAYEE_ID, PAY_AMT, CURRENCY_CD
023800              , PAY_STATUS, AUTH_USER, SANCTIONS_RESULT
023900              , COMMENT_TXT, LAST_UPD_TS, LAST_UPD_PGM
024000              , LAST_UPD_USER )
024100         VALUES
