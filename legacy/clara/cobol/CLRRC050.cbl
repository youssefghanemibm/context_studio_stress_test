035900        WHEN 0
036000           ADD 1 TO WS-RECOVERY-WRITTEN
036100        WHEN +100
036200           SET WS-ROW-NOT-FOUND TO TRUE
036300        WHEN OTHER
036400           MOVE '3000-POST-RECEIPT' TO ERR-PARA
036500           PERFORM 8000-SQL-ERROR
036600     END-EVALUATE
036700     MOVE RCVR-CURRENCY-CD TO WS-CCY-FROM
036800     MOVE WS-RECEIPT-AMT TO WS-CCY-AMOUNT
036900     MOVE WS-RUN-DATE TO WS-CCY-RATE-DT
037000     CALL 'CLRCM030' USING WS-CCY-PARMS
037100                      CLR-ERROR-BLOCK
037200     IF ERR-SQLCODE NOT = ZERO
037300        MOVE 'CALL CLRCM030' TO ERR-PARA
037400        PERFORM 8000-SQL-ERROR
037500     END-IF
037600     EXEC SQL
037700         SELECT RSV_ID
037800           INTO :RSV-RSV-ID
037900           FROM FINAL TABLE (
038000         UPDATE CLR.T_RESERVE
038100            SET RSV_RECOVERY_EST_AMT = RSV_RECOVERY_EST_AMT -
038200                :WS-RECEIPT-AMT
038300              , RSV_OUTSTANDING_AMT = RSV_OUTSTANDING_AMT -
038400                  :WS-RECEIPT-AMT
038500              , RSV_GBP_EQUIV_AMT = RSV_GBP_EQUIV_AMT -
038600                  :WS-CCY-GBP-AMOUNT
