021200* --- 2300-READ-SUBR-CASE: LOOK UP CLR.T_SUBROGATION_CASE
021300 2300-READ-SUBR-CASE.
021400     SET WS-ROW-FOUND TO TRUE
021500     EXEC SQL
021600         SELECT SUBRO_CASE_ID, CLAIM_ID, TP_INSURER_NAME
021700                , TP_REF, DEMAND_AMT
021800           INTO :SUBC-SUBRO-CASE-ID, :SUBC-CLAIM-ID
021900                , :SUBC-TP-INSURER-NAME, :SUBC-TP-REF
022000                , :SUBC-DEMAND-AMT
022100           FROM CLR.T_SUBROGATION_CASE
022200          WHERE SUBRO_CASE_ID = :SUBC-SUBRO-CASE-ID
022300     END-EXEC
022400     EVALUATE SQLCODE
022500        WHEN 0
022600           ADD 1 TO WS-SUBROGATION-CASE-READ
022700        WHEN +100
022800           SET WS-ROW-NOT-FOUND TO TRUE
022900        WHEN OTHER
023000           MOVE 'READ CLR.T_SUBROGATION_CASE' TO ERR-PARA
023100           PERFORM 8000-SQL-ERROR
023200     END-EVALUATE
023300     .
