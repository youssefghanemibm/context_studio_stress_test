041300         INSERT INTO CLR.T_RESERVE_MOVEMENT
041400              ( RSV_ID, CLAIM_ID, MOVE_TS, MOVE_TYPE_CD
041500              , MOVE_AMT, MOVE_GBP_AMT, REASON_CD, USER_ID
041600              , PGM_ID, EXTRACTED_FLAG )
041700         VALUES
