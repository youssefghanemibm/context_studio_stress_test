010900* DRIVING CURSOR ON CLR.T_CURRENCY_RATE
011000     EXEC SQL
011100         DECLARE C-CURRENCY-RATE CURSOR WITH HOLD FOR
011200         SELECT CURRENCY_CD, RATE_DT, RATE_TO_GBP
011300                , RATE_TYPE_CD
011400           FROM CLR.T_CURRENCY_RATE
011500          WHERE RATE_TYPE_CD = 'YE'
011600            AND RATE_DT = :WS-RATE-DT
011700            AND CURRENCY_CD IN ('NOK', 'SEK', 'DKK')
011800          ORDER BY CURRENCY_CD, RATE_DT
011900          FOR FETCH ONLY
012000     END-EXEC.
