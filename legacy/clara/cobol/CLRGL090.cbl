017900           INTO :GLPE-GL-PERIOD, :GLPE-PERIOD-STATUS
018000                , :GLPE-CLOSED-TS
018100           FROM CLR.T_GL_PERIOD
018200          WHERE GL_PERIOD = :GLPE-GL-PERIOD
018300     END-EXEC
