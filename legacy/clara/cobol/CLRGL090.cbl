025400* ---------------------------------------------------------------*
025500* 3000-REVALUE                                                   *
025600* REVALUE RESERVES IN ONE CURRENCY                               *
025700* ---------------------------------------------------------------*
025800 3000-REVALUE.
025900* REVALUE OPEN NORDIC RESERVES TO GBP AT THE YEAR-END RATE.
026000* THE GBP EQUIVALENT IS UPDATED IN PLACE ON CLR.T_RESERVE; NO ROW
026100* IS INSERTED INTO CLR.T_RESERVE_MOVEMENT FOR A REVALUATION.
026200     MOVE CURR-CURRENCY-CD TO WS-CCY-FROM
026300     MOVE 1 TO WS-CCY-AMOUNT
026400     MOVE CURR-RATE-DT TO WS-CCY-RATE-DT
026500     CALL 'CLRCM030' USING WS-CCY-PARMS
026600                      CLR-ERROR-BLOCK
026700     IF ERR-SQLCODE NOT = ZERO
026800         MOVE 'CALL CLRCM030' TO ERR-PARA
026900         PERFORM 8000-SQL-ERROR
027000     END-IF
027100     EXEC SQL
027200         UPDATE CLR.T_RESERVE
027300            SET RSV_GBP_EQUIV_AMT =
027400                ROUND(RSV_OUTSTANDING_AMT * :CURR-RATE-TO-GBP, 2)
027500              , RSV_LAST_REVAL_DT = :CURR-RATE-DT
027600              , LAST_UPD_TS = CURRENT TIMESTAMP
027700              , LAST_UPD_PGM = :WS-PGM-ID
027800              , LAST_UPD_USER = :WS-USER-ID
027900          WHERE CURRENCY_CD = :CURR-CURRENCY-CD
028000            AND RSV_STATUS = 'O'
028100     END-EXEC
028200     EVALUATE SQLCODE
028300         WHEN 0
028400             ADD 1 TO WS-RESERVE-WRITTEN
028500         WHEN +100
028600             SET WS-ROW-NOT-FOUND TO TRUE
028700         WHEN OTHER
028800             MOVE '3000-REVALUE' TO ERR-PARA
028900             PERFORM 8000-SQL-ERROR
029000     END-EVALUATE
029100     EXEC SQL
029200         GET DIAGNOSTICS :WS-ROWS-AFFECTED = ROW_COUNT
029300     END-EXEC
029400     ADD WS-ROWS-AFFECTED TO WS-REVAL-COUNT
029500     .
