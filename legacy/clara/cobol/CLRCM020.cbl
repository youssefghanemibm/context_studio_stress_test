009800* --- 2300-READ-CODE-LOOKUP: FETCH CLR.T_CODE_LOOKUP
009900 2300-READ-CODE-LOOKUP.
010000     SET WS-ROW-FOUND TO TRUE
010100     EXEC SQL
010200         SELECT CODE_TYPE, CODE_VALUE, CODE_DESC_EN
010300                , CODE_DESC_LOCAL, ACTIVE_FLAG
010400           INTO :CODE-CODE-TYPE, :CODE-CODE-VALUE
010500                , :CODE-CODE-DESC-EN, :CODE-CODE-DESC-LOCAL
010600                , :CODE-ACTIVE-FLAG
010700           FROM CLR.T_CODE_LOOKUP
010800          WHERE CODE_TYPE = :CODE-CODE-TYPE
010900            AND CODE_VALUE = :CODE-CODE-VALUE
011000     END-EXEC
011100     EVALUATE SQLCODE
011200         WHEN 0
011300             ADD 1 TO WS-CODE-LOOKUP-READ
011400         WHEN +100
011500             SET WS-ROW-NOT-FOUND TO TRUE
011600         WHEN OTHER
011700             MOVE 'READ CLR.T_CODE_LOOKUP' TO ERR-PARA
011800             PERFORM 8000-SQL-ERROR
011900     END-EVALUATE
012000     .
012100* --- 2320-READ-USER: READ CLR.T_USER
012200 2320-READ-USER.
012300     MOVE WS-USER-ID TO USRR-USER-ID
012400     SET WS-ROW-FOUND TO TRUE
012500     EXEC SQL
012600         SELECT USER_ID, USER_NAME, TEAM_CD, RSV_AUTH_LEVEL
012700                , PAY_AUTH_LEVEL
012800           INTO :USRR-USER-ID, :USRR-USER-NAME, :USRR-TEAM-CD
012900                , :USRR-RSV-AUTH-LEVEL, :USRR-PAY-AUTH-LEVEL
013000           FROM CLR.T_USER
013100          WHERE USER_ID = :USRR-USER-ID
013200     END-EXEC
013300     EVALUATE SQLCODE
013400         WHEN 0
013500             ADD 1 TO WS-USER-READ
013600         WHEN +100
013700             SET WS-ROW-NOT-FOUND TO TRUE
013800         WHEN OTHER
013900             MOVE 'READ CLR.T_USER' TO ERR-PARA
014000             PERFORM 8000-SQL-ERROR
014100     END-EVALUATE
014200     .
014300* --- 4100-INSERT-AUDIT: INSERT CLR.T_AUDIT
014400 4100-INSERT-AUDIT.
014500     MOVE 'Y' TO AUDR-ARCHIVE-FLAG
014600     EXEC SQL
014700         INSERT INTO CLR.T_AUDIT
014800              ( AUDIT_TS, USER_ID, PGM_ID, TABLE_NAME
014900              , KEY_VALUE, ACTION_CD, ARCHIVE_FLAG, BRANCH_CD
015000              , EXT_REF, LAST_UPD_TS, LAST_UPD_PGM
015100              , LAST_UPD_USER )
015200         VALUES
015300              ( CURRENT TIMESTAMP, :AUDR-USER-ID, :AUDR-PGM-ID
015400              , :AUDR-TABLE-NAME, :AUDR-KEY-VALUE
015500              , :AUDR-ACTION-CD, :AUDR-ARCHIVE-FLAG
015600              , :AUDR-BRANCH-CD, :AUDR-EXT-REF
015700              , CURRENT TIMESTAMP, :WS-PGM-ID, :WS-USER-ID )
015800     END-EXEC
015900     EVALUATE SQLCODE
016000         WHEN 0
016100             ADD 1 TO WS-AUDIT-WRITTEN
016200         WHEN +100
016300             SET WS-ROW-NOT-FOUND TO TRUE
016400         WHEN OTHER
016500             MOVE 'INSERT CLR.T_AUDIT' TO ERR-PARA
016600             PERFORM 8000-SQL-ERROR
016700     END-EVALUATE
016800     .
