034200             INSERT INTO CLR.T_RESERVE_MOVEMENT
034300                  ( RSV_ID, CLAIM_ID, MOVE_TS, MOVE_TYPE_CD
034400                  , MOVE_AMT, MOVE_GBP_AMT, REASON_CD, USER_ID
034500                  , PGM_ID, EXTRACTED_FLAG )
