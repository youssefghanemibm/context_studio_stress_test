020200         SELECT RSV_ID, CLAIM_ID, RSV_TYPE_CD, CURRENCY_CD
020300                , RSV_INITIAL_AMT, RSV_OUTSTANDING_AMT
020400           INTO :RSV-RSV-ID, :RSV-CLAIM-ID, :RSV-RSV-TYPE-CD
020500                , :RSV-CURRENCY-CD, :RSV-RSV-INITIAL-AMT
020600                , :RSV-RSV-OUTSTANDING-AMT
020700           FROM CLR.T_RESERVE
020800          WHERE RSV_ID = :RSV-RSV-ID
020900     END-EXEC
021000     EVALUATE SQLCODE
021100         WHEN 0
021200             ADD 1 TO WS-RESERVE-READ
021300         WHEN +100
021400             SET WS-ROW-NOT-FOUND TO TRUE
021500         WHEN OTHER
021600             MOVE 'READ CLR.T_RESERVE' TO ERR-PARA
021700             PERFORM 8000-SQL-ERROR
021800     END-EVALUATE
021900     .
022000* --- 2500-EDIT-RESERVE: FIELD EDITS FOR CLR.T_RESERVE
022100 2500-EDIT-RESERVE.
022200     IF RSV-CLAIM-ID = SPACES OR LOW-VALUES
022300         ADD 1 TO WS-REJECT-CNT
022400         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
022500     END-IF
022600     IF RSV-RSV-TYPE-CD NOT = 'ID' AND RSV-RSV-TYPE-CD NOT = 'EX'
022700         AND RSV-RSV-TYPE-CD NOT = 'LG'
022800         ADD 1 TO WS-REJECT-CNT
022900         MOVE 'RSV_TYPE_CD INVALID' TO ERR-TEXT
023000     END-IF
023100     IF RSV-CURRENCY-CD = SPACES OR LOW-VALUES
