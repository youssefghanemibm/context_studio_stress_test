025400     IF RSVM-MOVE-TYPE-CD NOT = 'IN' AND RSVM-MOVE-TYPE-CD NOT =
025500         'AD' AND RSVM-MOVE-TYPE-CD NOT = 'IX' AND
025600         RSVM-MOVE-TYPE-CD NOT = 'RV' AND RSVM-MOVE-TYPE-CD NOT =
