034700                  ( :RSVM-RSV-ID, :RSVM-CLAIM-ID, CURRENT
034800                      TIMESTAMP
034900                  , :RSVM-MOVE-TYPE-CD, :RSVM-MOVE-AMT
035000                  , :RSVM-MOVE-GBP-AMT, :RSVM-REASON-CD
035100                  , :RSVM-USER-ID, :RSVM-PGM-ID
035200                  , :RSVM-EXTRACTED-FLAG )
035300         END-EXEC
