015000 PROCEDURE DIVISION.
015100* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
015200 0000-MAIN.
015300     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
015400     IF EIBCALEN = ZERO
015500        INITIALIZE CLR-COMMAREA
015600        MOVE 'FN15' TO CA-TRANID
015700        PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
015800     ELSE
015900        MOVE DFHCOMMAREA TO CLR-COMMAREA
016000        PERFORM 2000-PROCESS-INPUT THRU 2000-PROCESS-INPUT-EXIT
016100     END-IF
016200     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
016300     GOBACK.
016400 0000-MAIN-EXIT.
016500     EXIT.
016600* --- 1000-FIRST-TIME: SEND THE EMPTY SCREEN
016700 1000-FIRST-TIME.
016800     MOVE LOW-VALUES TO CLRM015O
016900     EXEC CICS SEND MAP('CLRM015') MAPSET('CLRMS01')
017000        ERASE FREEKB RESP(WS-RESP) END-EXEC
017100     .
017200 1000-FIRST-TIME-EXIT.
017300     EXIT.
017400* --- 2000-PROCESS-INPUT: INPUT PROCESSING
017500 2000-PROCESS-INPUT.
017600     EXEC CICS RECEIVE MAP('CLRM015') MAPSET('CLRMS01')
017700        INTO(CLRM015I) RESP(WS-RESP) END-EXEC
017800     EVALUATE TRUE
017900        WHEN EIBAID = AID-PF3
018000        WHEN EIBAID = AID-CLEAR
018100           MOVE ZERO TO CA-RETURN-CD
018200           EXEC CICS RETURN END-EXEC
018300        WHEN EIBAID = AID-PF12
018400           PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
018500        WHEN EIBAID = AID-ENTER
018600           PERFORM 2100-EDIT-INPUT THRU 2100-EDIT-INPUT-EXIT
018700           IF WS-NO-ERROR
018800              PERFORM 2200-APPLY THRU 2200-APPLY-EXIT
018900           END-IF
019000        WHEN OTHER
019100           MOVE 'INVALID KEY PRESSED' TO MSGO
019200     END-EVALUATE
019300     EXEC CICS SEND MAP('CLRM015') MAPSET('CLRMS01')
019400        DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
019500     .
019600 2000-PROCESS-INPUT-EXIT.
019700     EXIT.
019800* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
019900 2100-EDIT-INPUT.
020000     SET WS-NO-ERROR TO TRUE
020100     IF POLINOL = ZERO OR POLINOI = SPACES
020200        SET WS-ERROR-FOUND TO TRUE
020300        MOVE WS-MSG-01 TO MSGO
020400        MOVE -1 TO POLINOL
020500     ELSE
020600        CONTINUE
020700     END-IF
020800     PERFORM 1500-CHECK-AUTHORITY THRU 1500-CHECK-AUTHORITY-EXIT
020900     .
021000 2100-EDIT-INPUT-EXIT.
021100     EXIT.
021200* --- 1500-CHECK-AUTHORITY: CONFIRM THE USER MAY RUN THIS FUNCTION
021300 1500-CHECK-AUTHORITY.
021400     MOVE WS-USER-ID TO WS-AUTH-USER
021500     MOVE 'CLRFN015' TO WS-AUTH-FUNCTION
021600     CALL 'CLRCM070' USING WS-AUTH-PARMS
021700                      CLR-ERROR-BLOCK
021800     IF ERR-SQLCODE NOT = ZERO
021900        MOVE 'CALL CLRCM070' TO ERR-PARA
022000        PERFORM 8000-SQL-ERROR
022100     END-IF
022200     IF WS-AUTH-ALLOWED NOT = 'Y'
022300        SET WS-ERROR-FOUND TO TRUE
022400        MOVE 8 TO CA-RETURN-CD
022500        MOVE 'NOT AUTHORISED FOR THIS FUNCTION' TO CA-MSG
022600     END-IF
022700     .
022800 1500-CHECK-AUTHORITY-EXIT.
022900     EXIT.
023000* --- 2200-APPLY: BUSINESS PROCESSING
023100 2200-APPLY.
023200     PERFORM 2300-READ-FNOL-EVENT THRU 2300-READ-FNOL-EVENT-EXIT
023300     IF WS-NO-ERROR
023400        MOVE ZERO TO CA-RETURN-CD
023500     END-IF
023600     .
023700 2200-APPLY-EXIT.
023800     EXIT.
023900* --- 2300-READ-FNOL-EVENT: LOOK UP CLR.T_FNOL_EVENT
024000 2300-READ-FNOL-EVENT.
024100     SET WS-ROW-FOUND TO TRUE
024200     EXEC SQL
024300         SELECT FNOL_ID, CLAIM_ID, CHANNEL_CD
024400           INTO :FNL-FNOL-ID, :FNL-CLAIM-ID, :FNL-CHANNEL-CD
024500           FROM CLR.T_FNOL_EVENT
024600          WHERE FNOL_ID = :FNL-FNOL-ID
024700     END-EXEC
024800     EVALUATE SQLCODE
024900        WHEN 0
025000           ADD 1 TO WS-FNOL-EVENT-READ
025100        WHEN +100
025200           SET WS-ROW-NOT-FOUND TO TRUE
025300        WHEN OTHER
025400           MOVE 'READ CLR.T_FNOL_EVENT' TO ERR-PARA
025500           PERFORM 8000-SQL-ERROR
025600     END-EVALUATE
025700     .
025800 2300-READ-FNOL-EVENT-EXIT.
025900     EXIT.
026000* --- 9000-RETURN: RETURN TO CICS
026100 9000-RETURN.
026200     EXEC CICS RETURN TRANSID('FN15') COMMAREA(CLR-COMMAREA)
026300        LENGTH(LENGTH OF CLR-COMMAREA) END-EXEC
026400     .
026500 9000-RETURN-EXIT.
026600     EXIT.
026700* --- 8000-SQL-ERROR: UNEXPECTED SQLCODE
026800 8000-SQL-ERROR.
026900     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
027000     MOVE WS-PGM-ID TO ERR-PGM
027100     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
027200         ERR-TEXT
027300     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
027400     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
027500     MOVE 16 TO CA-RETURN-CD
027600     MOVE ERR-TEXT TO CA-MSG
027700     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
027800     .
027900 8000-SQL-ERROR-EXIT.
028000     EXIT.
