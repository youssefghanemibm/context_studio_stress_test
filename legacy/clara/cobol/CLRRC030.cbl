009900* DRIVING CURSOR ON CLR.T_SUBROGATION_CASE
010000     EXEC SQL
010100         DECLARE C-SUBR-CASE CURSOR WITH HOLD FOR
010200         SELECT SUBRO_CASE_ID, CLAIM_ID, TP_INSURER_NAME
010300                , TP_REF, DEMAND_AMT, DEMAND_DT
010400                , SOLICITOR_VENDOR_CD
010500           FROM CLR.T_SUBROGATION_CASE
010600          WHERE CASE_STATUS <> 'WO'
010700          ORDER BY SUBRO_CASE_ID
010800          FOR FETCH ONLY
010900     END-EXEC.
