013000 PROCEDURE DIVISION.
013100* --- 0000-MAINLINE: CONTROL FLOW
013200 0000-MAINLINE.
013300     PERFORM 1000-INITIALISE
013400     PERFORM 2000-PROCESS
013500     PERFORM 9000-TERMINATE
013600     GOBACK.
013700* --- 1000-INITIALISE: INITIALISATION
013800 1000-INITIALISE.
013900     MOVE FUNCTION CURRENT-DATE(1:8) TO WS-RUN-TS
014000     STRING WS-RUN-TS(1:4) '-' WS-RUN-TS(5:2) '-' WS-RUN-TS(7:2)
014100         DELIMITED BY SIZE INTO WS-RUN-DATE
014200     MOVE 'CLRBATCH' TO WS-USER-ID
014300     OPEN OUTPUT REPORT-FILE
014400     IF WS-RPTOUT-STATUS NOT = '00'
014500         DISPLAY 'CLRRC030 OPEN FAILED RPTOUT ' WS-RPTOUT-STATUS
014600         MOVE 16 TO RETURN-CODE
014700         GOBACK
014800     END-IF
014900     OPEN OUTPUT EXTRACT-FILE
015000     IF WS-EXTOUT-STATUS NOT = '00'
015100         DISPLAY 'CLRRC030 OPEN FAILED EXTOUT ' WS-EXTOUT-STATUS
015200         MOVE 16 TO RETURN-CODE
015300         GOBACK
015400     END-IF
015500     MOVE WS-RUN-DATE TO RH1-RUN-DATE
015600     WRITE REPORT-RECORD FROM WS-RPT-HEAD-1
015700     .
015800* --- 2000-PROCESS: PROCESS LOOP
015900 2000-PROCESS.
016000     EXEC SQL
016100         OPEN C-SUBR-CASE
016200     END-EXEC
016300     EVALUATE SQLCODE
016400         WHEN 0
016500             CONTINUE
016600         WHEN OTHER
016700             MOVE '2000-OPEN-C-SUBR-CASE' TO ERR-PARA
016800             PERFORM 8000-SQL-ERROR
016900     END-EVALUATE
017000     PERFORM 2100-FETCH-NEXT
017100     PERFORM UNTIL WS-END-OF-DATA
017200         PERFORM 2200-PROCESS-ROW
017300         PERFORM 2100-FETCH-NEXT
017400     END-PERFORM
017500     EXEC SQL
017600         CLOSE C-SUBR-CASE
017700     END-EXEC
017800     .
017900* --- 2100-FETCH-NEXT: FETCH THE NEXT DRIVING ROW
018000 2100-FETCH-NEXT.
018100     EXEC SQL
018200         FETCH C-SUBR-CASE
018300          INTO :SUBC-SUBRO-CASE-ID, :SUBC-CLAIM-ID
018400               , :SUBC-TP-INSURER-NAME, :SUBC-TP-REF
018500               , :SUBC-DEMAND-AMT, :SUBC-DEMAND-DT
018600               , :SUBC-SOLICITOR-VENDOR-CD
018700     END-EXEC
018800     EVALUATE SQLCODE
018900         WHEN 0
019000             ADD 1 TO WS-SUBROGATION-CASE-READ
019100         WHEN +100
019200             SET WS-END-OF-DATA TO TRUE
019300         WHEN OTHER
019400             MOVE '2100-FETCH-NEXT' TO ERR-PARA
019500             PERFORM 8000-SQL-ERROR
019600     END-EVALUATE
019700     .
019800* --- 2200-PROCESS-ROW: ONE UNIT OF WORK
019900 2200-PROCESS-ROW.
020000     SET WS-NO-ERROR TO TRUE
020100     PERFORM 2500-EDIT-SUBR-CASE
020200     PERFORM 2510-EDIT-SUBR-CASE-2
020300     PERFORM 5000-WRITE-EXTRACT
020400     .
020500* --- 2500-EDIT-SUBR-CASE: FIELD EDITS FOR CLR.T_SUBROGATION_CASE
020600 2500-EDIT-SUBR-CASE.
020700     IF SUBC-SUBRO-CASE-ID = SPACES OR LOW-VALUES
020800         ADD 1 TO WS-REJECT-CNT
020900         MOVE 'SUBRO_CASE_ID MISSING' TO ERR-TEXT
021000     END-IF
021100     IF SUBC-CLAIM-ID = SPACES OR LOW-VALUES
021200         ADD 1 TO WS-REJECT-CNT
021300         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
021400     END-IF
021500     IF SUBC-TP-INSURER-NAME = SPACES OR LOW-VALUES
021600         ADD 1 TO WS-REJECT-CNT
021700         MOVE 'TP_INSURER_NAME MISSING' TO ERR-TEXT
021800     END-IF
021900     IF SUBC-DEMAND-AMT NOT NUMERIC
022000         MOVE ZERO TO SUBC-DEMAND-AMT
022100         ADD 1 TO WS-REJECT-CNT
022200     END-IF
022300     .
022400* --- 2510-EDIT-SUBR-CASE-2: CHECK MANDATORY FIELDS IN CLR.T_SUBRO
022500 2510-EDIT-SUBR-CASE-2.
022600     IF SUBC-DEMAND-DT NOT = SPACES AND SUBC-DEMAND-DT(5:1) NOT =
022700         '-'
022800         MOVE 'DEMAND_DT BAD DATE' TO ERR-TEXT
022900         ADD 1 TO WS-REJECT-CNT
023000     END-IF
023100     IF SUBC-LIMITATION-DT NOT = SPACES AND
023200         SUBC-LIMITATION-DT(5:1) NOT = '-'
023300         MOVE 'LIMITATION_DT BAD DATE' TO ERR-TEXT
023400         ADD 1 TO WS-REJECT-CNT
023500     END-IF
023600     IF SUBC-CASE-STATUS NOT = 'LT' AND SUBC-CASE-STATUS NOT =
023700         'ST' AND SUBC-CASE-STATUS NOT = 'WO'
023800         ADD 1 TO WS-REJECT-CNT
023900         MOVE 'CASE_STATUS INVALID' TO ERR-TEXT
024000     END-IF
024100     .
024200* --- 5000-WRITE-EXTRACT: WRITE THE OUTBOUND RECORD
024300 5000-WRITE-EXTRACT.
024400     MOVE SPACES TO EXTRACT-RECORD
024500     MOVE SUBC-CLAIM-ID TO EXTRACT-RECORD(1:12)
024600     WRITE EXTRACT-RECORD
024700     IF WS-EXTOUT-STATUS NOT = '00'
024800         DISPLAY WS-PGM-ID ' WRITE FAILED EXTOUT '
024900             WS-EXTOUT-STATUS
025000         ADD 1 TO WS-REJECT-CNT
025100     END-IF
025200     .
025300* --- 9000-TERMINATE: END OF RUN
025400 9000-TERMINATE.
025500     PERFORM 7010-LIST-SUBR-CASE
025600     MOVE 'CLR.T_SUBROGATION_CASE ROWS READ' TO RT-LABEL
025700     MOVE WS-SUBROGATION-CASE-READ TO RT-COUNT
025800     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
025900     CLOSE REPORT-FILE
026000     CLOSE EXTRACT-FILE
026100     IF WS-REJECT-CNT > ZERO
026200         MOVE 4 TO RETURN-CODE
026300     END-IF
026400     .
026500* --- 7010-LIST-SUBR-CASE: LIST CLR.T_SUBROGATION_CASE FIELDS ON T
026600 7010-LIST-SUBR-CASE.
026700     MOVE 'LAST CLR.T_SUBROGATION_CASE ROW' TO RD-LABEL
026800     MOVE SPACES TO RD-VALUE
026900     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
027000     MOVE '  SUBRO_CASE_ID' TO RD-LABEL
027100     MOVE SUBC-SUBRO-CASE-ID TO RD-VALUE
027200     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
027300     MOVE '  CLAIM_ID' TO RD-LABEL
027400     MOVE SUBC-CLAIM-ID TO RD-VALUE
027500     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
027600     MOVE '  TP_INSURER_NAME' TO RD-LABEL
027700     MOVE SUBC-TP-INSURER-NAME TO RD-VALUE
027800     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
027900     MOVE '  TP_REF' TO RD-LABEL
028000     MOVE SUBC-TP-REF TO RD-VALUE
028100     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
028200     MOVE '  DEMAND_DT' TO RD-LABEL
028300     MOVE SUBC-DEMAND-DT TO RD-VALUE
028400     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
028500     MOVE '  SOLICITOR_VENDOR_CD' TO RD-LABEL
028600     MOVE SUBC-SOLICITOR-VENDOR-CD TO RD-VALUE
028700     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
028800     .
028900* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
029000 8000-SQL-ERROR.
029100     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
029200     MOVE WS-PGM-ID TO ERR-PGM
029300     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
029400         ERR-TEXT
029500     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
029600     MOVE 16 TO RETURN-CODE
029700     CLOSE REPORT-FILE
029800     CLOSE EXTRACT-FILE
029900     GOBACK.
