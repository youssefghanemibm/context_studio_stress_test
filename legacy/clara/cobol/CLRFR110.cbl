024200     SET WS-ROW-FOUND TO TRUE
024300     EXEC SQL
024400         SELECT REF_ID, CLAIM_ID, REF_TS, REF_SCORE
024500                , REF_THRESHOLD_APPLIED
024600           INTO :FRDR-REF-ID, :FRDR-CLAIM-ID, :FRDR-REF-TS
024700                , :FRDR-REF-SCORE
024800                , :FRDR-REF-THRESHOLD-APPLIED
024900           FROM CLR.T_FRAUD_REFERRAL
025000          WHERE REF_ID = :FRDR-REF-ID
025100     END-EXEC
025200     EVALUATE SQLCODE
025300         WHEN 0
025400             ADD 1 TO WS-FRAUD-REFERRAL-READ
025500         WHEN +100
025600             SET WS-ROW-NOT-FOUND TO TRUE
025700         WHEN OTHER
025800             MOVE 'READ CLR.T_FRAUD_REFERRAL' TO ERR-PARA
025900             PERFORM 8000-SQL-ERROR
026000     END-EVALUATE
026100     .
026200 2320-READ-FRAU-REFE-EXIT.
026300     EXIT.
