014100 PROCEDURE DIVISION.
014200* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
014300 0000-MAIN.
014400     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
014500     IF EIBCALEN = ZERO
014600         INITIALIZE CLR-COMMAREA
014700         MOVE 'RC02' TO CA-TRANID
014800         PERFORM 1000-FIRST-TIME
014900     ELSE
015000         MOVE DFHCOMMAREA TO CLR-COMMAREA
015100         PERFORM 2000-PROCESS-INPUT
015200     END-IF
015300     PERFORM 9000-RETURN
015400     GOBACK.
015500* --- 1000-FIRST-TIME: SEND THE EMPTY SCREEN
015600 1000-FIRST-TIME.
015700     MOVE LOW-VALUES TO CLRM620O
015800     EXEC CICS SEND MAP('CLRM620') MAPSET('CLRMS07')
015900         ERASE FREEKB RESP(WS-RESP) END-EXEC
016000     .
016100* --- 2000-PROCESS-INPUT: INPUT PROCESSING
016200 2000-PROCESS-INPUT.
016300     EXEC CICS RECEIVE MAP('CLRM620') MAPSET('CLRMS07')
016400         INTO(CLRM620I) RESP(WS-RESP) END-EXEC
016500     EVALUATE TRUE
016600         WHEN EIBAID = AID-PF3
016700         WHEN EIBAID = AID-CLEAR
016800             MOVE ZERO TO CA-RETURN-CD
016900             EXEC CICS RETURN END-EXEC
017000         WHEN EIBAID = AID-PF12
017100             PERFORM 1000-FIRST-TIME
017200         WHEN EIBAID = AID-ENTER
017300             PERFORM 2100-EDIT-INPUT
017400             IF WS-NO-ERROR
017500                 PERFORM 2200-APPLY
017600             END-IF
017700         WHEN OTHER
017800             MOVE 'INVALID KEY PRESSED' TO MSGO
017900     END-EVALUATE
018000     EXEC CICS SEND MAP('CLRM620') MAPSET('CLRMS07')
018100         DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
018200     .
018300* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
018400 2100-EDIT-INPUT.
018500     SET WS-NO-ERROR TO TRUE
018600     IF CASEIDL = ZERO OR CASEIDI = SPACES
018700         SET WS-ERROR-FOUND TO TRUE
018800         MOVE WS-MSG-01 TO MSGO
018900         MOVE -1 TO CASEIDL
019000     ELSE
019100         CONTINUE
019200     END-IF
019300     PERFORM 1200-CHECK-PARAMETERS
019400     PERFORM 1300-GET-PARAMETERS
019500     PERFORM 1400-GET-BUSINESS-DATE
019600     .
019700* --- 1200-CHECK-PARAMETERS: PARAMETER TABLE SANITY CHECK
019800 1200-CHECK-PARAMETERS.
019900     EXEC SQL
020000         SELECT COUNT(*)
020100           INTO :WS-PARM-ROWS
020200           FROM CLR.T_PARAM
020300          WHERE PARAM_KEY LIKE 'REC_%'
020400            AND VALID_FROM <= CURRENT DATE
020500            AND (VALID_TO IS NULL OR VALID_TO >= CURRENT DATE)
020600     END-EXEC
020700     EVALUATE SQLCODE
020800         WHEN 0
020900             CONTINUE
021000         WHEN OTHER
021100             MOVE '1200-CHECK-PARAMETERS' TO ERR-PARA
021200             PERFORM 8000-SQL-ERROR
021300     END-EVALUATE
021400     IF WS-PARM-ROWS = ZERO
021500         DISPLAY WS-PGM-ID ' NO CURRENT PARAMETERS FOUND'
021600         SET WS-ERROR-FOUND TO TRUE
021700     END-IF
021800     .
021900* --- 1300-GET-PARAMETERS: READ BUSINESS PARAMETERS VIA CLRCM040
022000 1300-GET-PARAMETERS.
022100     MOVE 'REC_PURSUE_MIN_GBP' TO PARM-PARAM-KEY
022200     CALL 'CLRCM040' USING PARMREC1-REC
022300                      CLR-ERROR-BLOCK
022400     IF ERR-SQLCODE NOT = ZERO
022500         MOVE 'CALL CLRCM040' TO ERR-PARA
022600         PERFORM 8000-SQL-ERROR
022700     END-IF
022800     MOVE FUNCTION NUMVAL(PARM-PARAM-VALUE) TO WS-PURSUE-MIN-GBP
022900     .
023000* --- 1400-GET-BUSINESS-DATE: DETERMINE PROCESSING DATE
023100 1400-GET-BUSINESS-DATE.
023200     MOVE WS-RUN-DATE TO DW-IN-DATE
023300     MOVE 'UK' TO DW-CALENDAR
023400     MOVE ZERO TO DW-BUS-DAYS
023500     CALL 'CLRCM010' USING CLR-DATE-WORK
023600                      CLR-ERROR-BLOCK
023700     IF ERR-SQLCODE NOT = ZERO
023800         MOVE 'CALL CLRCM010' TO ERR-PARA
023900         PERFORM 8000-SQL-ERROR
024000     END-IF
024100     .
024200* --- 2200-APPLY: APPLY THE CHANGE
024300 2200-APPLY.
024400     PERFORM 4100-INSERT-SUBR-CASE
024500     IF WS-NO-ERROR
024600         EXEC CICS SYNCPOINT END-EXEC
024700         MOVE ZERO TO CA-RETURN-CD
024800     END-IF
024900     .
025000* --- 4100-INSERT-SUBR-CASE: INSERT CLR.T_SUBROGATION_CASE
025100 4100-INSERT-SUBR-CASE.
025200     MOVE CA-CLAIM-ID TO SUBC-CLAIM-ID
025300     MOVE 'LT' TO SUBC-CASE-STATUS
025400     EXEC SQL
025500         INSERT INTO CLR.T_SUBROGATION_CASE
025600              ( SUBRO_CASE_ID, CLAIM_ID, TP_INSURER_NAME
025700              , TP_REF, DEMAND_AMT, DEMAND_DT
025800              , SOLICITOR_VENDOR_CD, LIMITATION_DT, CASE_STATUS
025900              , SUBTRAK_REF, LAST_UPD_TS, LAST_UPD_PGM
026000              , LAST_UPD_USER )
026100         VALUES
026200              ( :SUBC-SUBRO-CASE-ID, :SUBC-CLAIM-ID
026300              , :SUBC-TP-INSURER-NAME, :SUBC-TP-REF
026400              , :SUBC-DEMAND-AMT, :SUBC-DEMAND-DT
026500              , :SUBC-SOLICITOR-VENDOR-CD, :SUBC-LIMITATION-DT
026600              , :SUBC-CASE-STATUS, :SUBC-SUBTRAK-REF
026700              , CURRENT TIMESTAMP, :WS-PGM-ID, :WS-USER-ID )
026800     END-EXEC
026900     EVALUATE SQLCODE
027000         WHEN 0
027100             ADD 1 TO WS-SUBROGATION-CASE-WRITTEN
027200         WHEN +100
027300             SET WS-ROW-NOT-FOUND TO TRUE
027400         WHEN OTHER
027500             MOVE 'INSERT CLR.T_SUBROGATION_CASE' TO ERR-PARA
027600             PERFORM 8000-SQL-ERROR
027700     END-EVALUATE
027800     .
027900* --- 9000-RETURN: RETURN TO CICS
028000 9000-RETURN.
028100     EXEC CICS RETURN TRANSID('RC02') COMMAREA(CLR-COMMAREA)
028200         LENGTH(LENGTH OF CLR-COMMAREA) END-EXEC
028300     .
028400* --- 8000-SQL-ERROR: DB2 ERROR HANDLING
028500 8000-SQL-ERROR.
028600     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
028700     MOVE WS-PGM-ID TO ERR-PGM
028800     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
028900         ERR-TEXT
029000     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
029100     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
029200     MOVE 16 TO CA-RETURN-CD
029300     MOVE ERR-TEXT TO CA-MSG
029400     PERFORM 9000-RETURN
029500     .
