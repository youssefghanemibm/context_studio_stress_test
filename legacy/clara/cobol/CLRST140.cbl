014400 PROCEDURE DIVISION.
014500* --- 0000-MAINLINE: PROGRAM CONTROL
014600 0000-MAINLINE.
014700     PERFORM 1000-INITIALISE
014800     PERFORM 2000-PROCESS
014900     PERFORM 9000-TERMINATE
015000     GOBACK.
015100* --- 1000-INITIALISE: START OF RUN
015200 1000-INITIALISE.
015300     MOVE FUNCTION CURRENT-DATE(1:8) TO WS-RUN-TS
015400     STRING WS-RUN-TS(1:4) '-' WS-RUN-TS(5:2) '-' WS-RUN-TS(7:2)
015500         DELIMITED BY SIZE INTO WS-RUN-DATE
015600     MOVE 'CLRBATCH' TO WS-USER-ID
015700     OPEN OUTPUT REPORT-FILE
015800     IF WS-RPTOUT-STATUS NOT = '00'
015900         DISPLAY 'CLRST140 OPEN FAILED RPTOUT ' WS-RPTOUT-STATUS
016000         MOVE 16 TO RETURN-CODE
016100         GOBACK
016200     END-IF
016300     OPEN OUTPUT EXTRACT-FILE
016400     IF WS-EXTOUT-STATUS NOT = '00'
016500         DISPLAY 'CLRST140 OPEN FAILED EXTOUT ' WS-EXTOUT-STATUS
016600         MOVE 16 TO RETURN-CODE
016700         GOBACK
016800     END-IF
016900     MOVE WS-RUN-DATE TO RH1-RUN-DATE
017000     WRITE REPORT-RECORD FROM WS-RPT-HEAD-1
017100     .
017200* --- 2000-PROCESS: PROCESS LOOP
017300 2000-PROCESS.
017400     EXEC SQL
017500         OPEN C-CLAIM
017600     END-EXEC
017700     EVALUATE SQLCODE
017800         WHEN 0
017900             CONTINUE
018000         WHEN OTHER
018100             MOVE '2000-OPEN-C-CLAIM' TO ERR-PARA
018200             PERFORM 8000-SQL-ERROR
018300     END-EVALUATE
018400     PERFORM 2100-FETCH-NEXT
018500     PERFORM UNTIL WS-END-OF-DATA
018600         PERFORM 2200-PROCESS-ROW
018700         PERFORM 2100-FETCH-NEXT
018800     END-PERFORM
018900     EXEC SQL
019000         CLOSE C-CLAIM
019100     END-EXEC
019200     .
019300* --- 2100-FETCH-NEXT: FETCH THE NEXT DRIVING ROW
019400 2100-FETCH-NEXT.
019500     EXEC SQL
019600         FETCH C-CLAIM
019700          INTO :CLM-CLAIM-ID, :CLM-POLICY-NO, :CLM-PRODUCT-CD
019800               , :CLM-PERIL-CD, :CLM-LOSS-DT
019900     END-EXEC
020000     EVALUATE SQLCODE
020100         WHEN 0
020200             ADD 1 TO WS-CLAIM-READ
020300         WHEN +100
020400             SET WS-END-OF-DATA TO TRUE
020500         WHEN OTHER
020600             MOVE '2100-FETCH-NEXT' TO ERR-PARA
020700             PERFORM 8000-SQL-ERROR
020800     END-EVALUATE
020900     .
021000* --- 2200-PROCESS-ROW: PROCESS ONE ROW
021100 2200-PROCESS-ROW.
021200     SET WS-NO-ERROR TO TRUE
021300     PERFORM 4100-INSERT-PAYMENT-BATCH
021400     PERFORM 4900-WRITE-AUDIT
021500     PERFORM 5000-WRITE-EXTRACT
021600     PERFORM 6000-COMMIT-CHECK
021700     .
021800* --- 4100-INSERT-PAYMENT-BATCH: INSERT CLR.T_PAYMENT_BATCH
021900 4100-INSERT-PAYMENT-BATCH.
022000     EXEC SQL
022100         INSERT INTO CLR.T_PAYMENT_BATCH
022200              ( BATCH_ID, BATCH_DT, PAY_COUNT, TOTAL_AMT
022300              , CPG_FILE_NAME, CPG_ACK_TS, LAST_UPD_TS
022400              , LAST_UPD_PGM, LAST_UPD_USER )
022500         VALUES
022600              ( :PAYB-BATCH-ID, :PAYB-BATCH-DT, :PAYB-PAY-COUNT
022700              , :PAYB-TOTAL-AMT, :PAYB-CPG-FILE-NAME
022800              , :PAYB-CPG-ACK-TS, CURRENT TIMESTAMP, :WS-PGM-ID
022900              , :WS-USER-ID )
023000     END-EXEC
023100     EVALUATE SQLCODE
023200         WHEN 0
023300             ADD 1 TO WS-PAYMENT-BATCH-WRITTEN
023400         WHEN +100
023500             SET WS-ROW-NOT-FOUND TO TRUE
023600         WHEN OTHER
023700             MOVE 'INSERT CLR.T_PAYMENT_BATCH' TO ERR-PARA
023800             PERFORM 8000-SQL-ERROR
023900     END-EVALUATE
024000     .
024100* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
024200 4900-WRITE-AUDIT.
024300     MOVE 'CLR.T_PAYMENT_BATCH' TO WS-AUD-TABLE
024400     MOVE CLM-CLAIM-ID TO WS-AUD-KEY
024500     MOVE 'U' TO WS-AUD-ACTION
024600     MOVE WS-USER-ID TO WS-AUD-USER
024700     MOVE WS-PGM-ID TO WS-AUD-PGM
024800     CALL 'CLRCM020' USING WS-AUDIT-PARMS
024900                      CLR-ERROR-BLOCK
025000     IF ERR-SQLCODE NOT = ZERO
025100         ADD 1 TO WS-REJECT-CNT
025200     END-IF
025300     .
025400* --- 5000-WRITE-EXTRACT: WRITE THE OUTBOUND RECORD
025500 5000-WRITE-EXTRACT.
025600     MOVE SPACES TO EXTRACT-RECORD
025700     MOVE CLM-CLAIM-ID TO EXTRACT-RECORD(1:12)
025800     WRITE EXTRACT-RECORD
025900     IF WS-EXTOUT-STATUS NOT = '00'
026000         DISPLAY WS-PGM-ID ' WRITE FAILED EXTOUT '
026100             WS-EXTOUT-STATUS
026200         ADD 1 TO WS-REJECT-CNT
026300     END-IF
026400     .
026500* --- 6000-COMMIT-CHECK: PERIODIC COMMIT
026600 6000-COMMIT-CHECK.
026700     ADD 1 TO WS-SINCE-COMMIT
026800     IF WS-SINCE-COMMIT >= WS-COMMIT-FREQ
026900         EXEC SQL
027000             COMMIT
027100         END-EXEC
027200         MOVE ZERO TO WS-SINCE-COMMIT
027300     END-IF
027400     .
027500* --- 9000-TERMINATE: TERMINATION AND TOTALS
027600 9000-TERMINATE.
027700     EXEC SQL
027800         COMMIT
027900     END-EXEC
028000     MOVE 'CLR.T_CLAIM ROWS READ' TO RT-LABEL
028100     MOVE WS-CLAIM-READ TO RT-COUNT
028200     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
028300     MOVE 'CLR.T_PAYMENT_BATCH ROWS WRITTEN' TO RT-LABEL
028400     MOVE WS-PAYMENT-BATCH-WRITTEN TO RT-COUNT
028500     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
028600     CLOSE REPORT-FILE
028700     CLOSE EXTRACT-FILE
028800     IF WS-REJECT-CNT > ZERO
028900         MOVE 4 TO RETURN-CODE
029000     END-IF
029100     .
029200* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
029300 8000-SQL-ERROR.
029400     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
029500     MOVE WS-PGM-ID TO ERR-PGM
029600     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
029700         ERR-TEXT
029800     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
029900     EXEC SQL
030000         ROLLBACK
030100     END-EXEC
030200     MOVE 16 TO RETURN-CODE
030300     CLOSE REPORT-FILE
030400     CLOSE EXTRACT-FILE
030500     GOBACK.
