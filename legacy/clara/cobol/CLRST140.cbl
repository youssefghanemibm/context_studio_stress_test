011400* DRIVING CURSOR ON CLR.T_CLAIM
011500     EXEC SQL
011600         DECLARE C-CLAIM CURSOR WITH HOLD FOR
011700         SELECT CLAIM_ID, POLICY_NO, PRODUCT_CD, PERIL_CD
011800                , LOSS_DT
011900           FROM CLR.T_CLAIM
012000          WHERE CLAIM_STATUS IN ('OP', 'RO', 'RC')
012100          ORDER BY CLAIM_ID
012200          FOR FETCH ONLY
012300     END-EXEC.
