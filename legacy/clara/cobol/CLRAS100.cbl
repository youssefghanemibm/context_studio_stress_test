018800     EXEC SQL
018900         FETCH C-ASSE-ASSI
019000          INTO :ASG-ASSIGN-ID, :ASG-CLAIM-ID
019100               , :ASG-ASSESSOR-ID, :ASG-VENDOR-CD
019200               , :ASG-APPOINTED-TS, :ASG-SLA-DUE-DT
019300     END-EXEC
