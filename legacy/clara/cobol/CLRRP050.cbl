035600     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
035700         ERR-TEXT
035800     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
035900     EXEC SQL
036000         ROLLBACK
036100     END-EXEC
036200     MOVE 16 TO RETURN-CODE
036300     CLOSE REPORT-FILE
036400     GOBACK.
