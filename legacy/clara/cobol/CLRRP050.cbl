013200 PROCEDURE DIVISION.
013300* --- 0000-MAINLINE: CONTROL FLOW
013400 0000-MAINLINE.
013500     PERFORM 1000-INITIALISE
013600     PERFORM 2000-PROCESS
013700     PERFORM 9000-TERMINATE
013800     GOBACK.
013900* --- 1000-INITIALISE: INITIALISATION
014000 1000-INITIALISE.
014100     MOVE FUNCTION CURRENT-DATE(1:8) TO WS-RUN-TS
014200     STRING WS-RUN-TS(1:4) '-' WS-RUN-TS(5:2) '-' WS-RUN-TS(7:2)
014300        DELIMITED BY SIZE INTO WS-RUN-DATE
014400     MOVE 'CLRBATCH' TO WS-USER-ID
014500     OPEN OUTPUT REPORT-FILE
014600     IF WS-RPTOUT-STATUS NOT = '00'
014700        DISPLAY 'CLRRP050 OPEN FAILED RPTOUT ' WS-RPTOUT-STATUS
014800        MOVE 16 TO RETURN-CODE
014900        GOBACK
015000     END-IF
015100     MOVE WS-RUN-DATE TO RH1-RUN-DATE
015200     WRITE REPORT-RECORD FROM WS-RPT-HEAD-1
015300     .
015400* --- 2000-PROCESS: MAIN PROCESSING LOOP
015500 2000-PROCESS.
015600     EXEC SQL
015700         OPEN C-ASSE-ASSI
015800     END-EXEC
015900     EVALUATE SQLCODE
016000        WHEN 0
016100           CONTINUE
016200        WHEN OTHER
016300           MOVE '2000-OPEN-C-ASSE-ASSI' TO ERR-PARA
016400           PERFORM 8000-SQL-ERROR
016500     END-EVALUATE
016600     PERFORM 2100-FETCH-NEXT
016700     PERFORM UNTIL WS-END-OF-DATA
016800        PERFORM 2200-PROCESS-ROW
016900        PERFORM 2100-FETCH-NEXT
017000     END-PERFORM
017100     EXEC SQL
017200         CLOSE C-ASSE-ASSI
017300     END-EXEC
017400     .
017500* --- 2100-FETCH-NEXT: FETCH THE NEXT DRIVING ROW
017600 2100-FETCH-NEXT.
017700     EXEC SQL
017800         FETCH C-ASSE-ASSI
017900          INTO :ASG-ASSIGN-ID, :ASG-CLAIM-ID
018000               , :ASG-ASSESSOR-ID, :ASG-VENDOR-CD
018100     END-EXEC
018200     EVALUATE SQLCODE
018300        WHEN 0
018400           ADD 1 TO WS-ASSESSOR-ASSIGNMENT-READ
018500        WHEN +100
018600           SET WS-END-OF-DATA TO TRUE
018700        WHEN OTHER
018800           MOVE '2100-FETCH-NEXT' TO ERR-PARA
018900           PERFORM 8000-SQL-ERROR
019000     END-EVALUATE
019100     .
019200* --- 2200-PROCESS-ROW: ONE UNIT OF WORK
019300 2200-PROCESS-ROW.
019400     SET WS-NO-ERROR TO TRUE
019500     PERFORM 2500-EDIT-ASSE-ASSI
019600     PERFORM 2510-EDIT-REPORT-RUN
019700     PERFORM 2520-EDIT-ASSE-ASSI-2
019800     PERFORM 2530-EDIT-REPORT-RUN-2
019900     PERFORM 2540-EDIT-ASSE-ASSI-3
020000     PERFORM 4100-INSERT-REPORT-RUN
020100     PERFORM 4900-WRITE-AUDIT
020200     PERFORM 6000-COMMIT-CHECK
020300     .
020400* --- 2500-EDIT-ASSE-ASSI: VALIDATE CLR.T_ASSESSOR_ASSIGNMENT
020500 2500-EDIT-ASSE-ASSI.
020600     IF ASG-CLAIM-ID = SPACES OR LOW-VALUES
020700        ADD 1 TO WS-REJECT-CNT
020800        MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
020900     END-IF
021000     IF ASG-ASSESSOR-ID = SPACES OR LOW-VALUES
021100        ADD 1 TO WS-REJECT-CNT
021200        MOVE 'ASSESSOR_ID MISSING' TO ERR-TEXT
021300     END-IF
021400     .
021500* --- 2510-EDIT-REPORT-RUN: CHECK MANDATORY FIELDS IN CLR.T_REPORT
021600 2510-EDIT-REPORT-RUN.
021700     IF RPTR-RUN-ID NOT NUMERIC
021800        MOVE ZERO TO RPTR-RUN-ID
021900        ADD 1 TO WS-REJECT-CNT
022000     END-IF
022100     IF RPTR-REPORT-CD = SPACES OR LOW-VALUES
022200        ADD 1 TO WS-REJECT-CNT
022300        MOVE 'REPORT_CD MISSING' TO ERR-TEXT
022400     END-IF
022500     .
022600* --- 2520-EDIT-ASSE-ASSI-2: CHECK MANDATORY FIELDS IN CLR.T_ASSES
022700 2520-EDIT-ASSE-ASSI-2.
022800     IF ASG-SLA-DUE-DT NOT = SPACES AND ASG-SLA-DUE-DT(5:1) NOT =
022900         '-'
023000        MOVE 'SLA_DUE_DT BAD DATE' TO ERR-TEXT
023100        ADD 1 TO WS-REJECT-CNT
023200     END-IF
023300     .
023400* --- 2530-EDIT-REPORT-RUN-2: VALIDATE CLR.T_REPORT_RUN
023500 2530-EDIT-REPORT-RUN-2.
023600     IF RPTR-ROW-COUNT NOT NUMERIC
023700        MOVE ZERO TO RPTR-ROW-COUNT
023800        ADD 1 TO WS-REJECT-CNT
023900     END-IF
024000     IF RPTR-RUN-STATUS = SPACES OR LOW-VALUES
024100        ADD 1 TO WS-REJECT-CNT
024200        MOVE 'RUN_STATUS MISSING' TO ERR-TEXT
024300     END-IF
024400     .
024500* --- 2540-EDIT-ASSE-ASSI-3: VALIDATE CLR.T_ASSESSOR_ASSIGNMENT
024600 2540-EDIT-ASSE-ASSI-3.
024700     IF ASG-VERSION-NO NOT NUMERIC
024800        MOVE ZERO TO ASG-VERSION-NO
024900        ADD 1 TO WS-REJECT-CNT
025000     END-IF
025100     .
025200* --- 4100-INSERT-REPORT-RUN: INSERT CLR.T_REPORT_RUN
025300 4100-INSERT-REPORT-RUN.
025400     EXEC SQL
025500         INSERT INTO CLR.T_REPORT_RUN
025600              ( RUN_ID, REPORT_CD, RUN_TS, ROW_COUNT
025700              , RUN_STATUS, LAST_UPD_TS, LAST_UPD_PGM
025800              , LAST_UPD_USER )
025900         VALUES
026000              ( :RPTR-RUN-ID, :RPTR-REPORT-CD
026100              , CURRENT TIMESTAMP, :RPTR-ROW-COUNT
026200              , :RPTR-RUN-STATUS, CURRENT TIMESTAMP, :WS-PGM-ID
026300              , :WS-USER-ID )
026400     END-EXEC
026500     EVALUATE SQLCODE
026600        WHEN 0
026700           ADD 1 TO WS-REPORT-RUN-WRITTEN
026800        WHEN +100
026900           SET WS-ROW-NOT-FOUND TO TRUE
027000        WHEN OTHER
027100           MOVE 'INSERT CLR.T_REPORT_RUN' TO ERR-PARA
027200           PERFORM 8000-SQL-ERROR
027300     END-EVALUATE
027400     .
027500* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
027600 4900-WRITE-AUDIT.
027700     MOVE 'CLR.T_REPORT_RUN' TO WS-AUD-TABLE
027800     MOVE ASG-CLAIM-ID TO WS-AUD-KEY
027900     MOVE 'I' TO WS-AUD-ACTION
028000     MOVE WS-USER-ID TO WS-AUD-USER
028100     MOVE WS-PGM-ID TO WS-AUD-PGM
028200     CALL 'CLRCM020' USING WS-AUDIT-PARMS
028300                      CLR-ERROR-BLOCK
028400     IF ERR-SQLCODE NOT = ZERO
028500        ADD 1 TO WS-REJECT-CNT
028600     END-IF
028700     .
028800* --- 6000-COMMIT-CHECK: PERIODIC COMMIT
028900 6000-COMMIT-CHECK.
029000     ADD 1 TO WS-SINCE-COMMIT
029100     IF WS-SINCE-COMMIT >= WS-COMMIT-FREQ
029200        EXEC SQL
029300            COMMIT
029400        END-EXEC
029500        MOVE ZERO TO WS-SINCE-COMMIT
029600     END-IF
029700     .
029800* --- 9000-TERMINATE: TERMINATION AND TOTALS
029900 9000-TERMINATE.
030000     PERFORM 7010-LIST-ASSE-ASSI
030100     PERFORM 7030-LIST-REPORT-RUN
030200     EXEC SQL
030300         COMMIT
030400     END-EXEC
030500     MOVE 'CLR.T_ASSESSOR_ASSIGNMENT ROWS READ' TO RT-LABEL
030600     MOVE WS-ASSESSOR-ASSIGNMENT-READ TO RT-COUNT
030700     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
030800     MOVE 'CLR.T_REPORT_RUN ROWS WRITTEN' TO RT-LABEL
030900     MOVE WS-REPORT-RUN-WRITTEN TO RT-COUNT
031000     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
031100     CLOSE REPORT-FILE
031200     IF WS-REJECT-CNT > ZERO
031300        MOVE 4 TO RETURN-CODE
031400     END-IF
031500     .
031600* --- 7010-LIST-ASSE-ASSI: LIST CLR.T_ASSESSOR_ASSIGNMENT FIELDS O
031700 7010-LIST-ASSE-ASSI.
031800     MOVE 'LAST CLR.T_ASSESSOR_ASSIGNMENT ROW' TO RD-LABEL
031900     MOVE SPACES TO RD-VALUE
032000     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
032100     MOVE '  CLAIM_ID' TO RD-LABEL
032200     MOVE ASG-CLAIM-ID TO RD-VALUE
032300     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
032400     MOVE '  ASSESSOR_ID' TO RD-LABEL
032500     MOVE ASG-ASSESSOR-ID TO RD-VALUE
032600     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
032700     MOVE '  VENDOR_CD' TO RD-LABEL
032800     MOVE ASG-VENDOR-CD TO RD-VALUE
032900     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
033000     MOVE '  APPOINTED_TS' TO RD-LABEL
033100     MOVE ASG-APPOINTED-TS TO RD-VALUE
033200     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
033300     MOVE '  SLA_DUE_DT' TO RD-LABEL
033400     MOVE ASG-SLA-DUE-DT TO RD-VALUE
033500     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
033600     .
033700* --- 7030-LIST-REPORT-RUN: LIST CLR.T_REPORT_RUN FIELDS ON THE RE
033800 7030-LIST-REPORT-RUN.
033900     MOVE 'LAST CLR.T_REPORT_RUN ROW' TO RD-LABEL
034000     MOVE SPACES TO RD-VALUE
034100     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
034200     MOVE '  REPORT_CD' TO RD-LABEL
034300     MOVE RPTR-REPORT-CD TO RD-VALUE
034400     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
034500     MOVE '  RUN_TS' TO RD-LABEL
034600     MOVE RPTR-RUN-TS TO RD-VALUE
034700     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
034800     MOVE '  RUN_STATUS' TO RD-LABEL
034900     MOVE RPTR-RUN-STATUS TO RD-VALUE
035000     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
035100     .
035200* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
035300 8000-SQL-ERROR.
