010300* DRIVING CURSOR ON CLR.T_ASSESSOR_ASSIGNMENT
010400     EXEC SQL
010500         DECLARE C-ASSE-ASSI CURSOR WITH HOLD FOR
010600         SELECT ASSIGN_ID, CLAIM_ID, ASSESSOR_ID, VENDOR_CD
010700           FROM CLR.T_ASSESSOR_ASSIGNMENT
010800          WHERE LAST_UPD_TS >= :WS-LAST-RUN-TS
010900          ORDER BY ASSIGN_ID
011000          FOR FETCH ONLY
011100     END-EXEC.
