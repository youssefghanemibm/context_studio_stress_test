014300 PROCEDURE DIVISION.
014400* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
014500 0000-MAIN.
014600     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
014700     IF EIBCALEN = ZERO
014800        INITIALIZE CLR-COMMAREA
014900        MOVE 'RC01' TO CA-TRANID
015000        PERFORM 1000-FIRST-TIME
015100     ELSE
015200        MOVE DFHCOMMAREA TO CLR-COMMAREA
015300        PERFORM 2000-PROCESS-INPUT
015400     END-IF
015500     PERFORM 9000-RETURN
015600     GOBACK.
015700* --- 1000-FIRST-TIME: SEND THE EMPTY SCREEN
015800 1000-FIRST-TIME.
015900     MOVE LOW-VALUES TO CLRM610O
016000     EXEC CICS SEND MAP('CLRM610') MAPSET('CLRMS07')
016100        ERASE FREEKB RESP(WS-RESP) END-EXEC
016200     .
016300* --- 2000-PROCESS-INPUT: PROCESS THE REQUEST
016400 2000-PROCESS-INPUT.
016500     EXEC CICS RECEIVE MAP('CLRM610') MAPSET('CLRMS07')
016600        INTO(CLRM610I) RESP(WS-RESP) END-EXEC
016700     EVALUATE TRUE
016800        WHEN EIBAID = AID-PF3
016900        WHEN EIBAID = AID-CLEAR
017000           MOVE ZERO TO CA-RETURN-CD
017100           EXEC CICS RETURN END-EXEC
017200        WHEN EIBAID = AID-PF12
017300           PERFORM 1000-FIRST-TIME
017400        WHEN EIBAID = AID-ENTER
017500           PERFORM 2100-EDIT-INPUT
017600           IF WS-NO-ERROR
017700              PERFORM 2200-APPLY
017800           END-IF
017900        WHEN OTHER
018000           MOVE 'INVALID KEY PRESSED' TO MSGO
018100     END-EVALUATE
018200     EXEC CICS SEND MAP('CLRM610') MAPSET('CLRMS07')
018300        DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
018400     .
018500* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
018600 2100-EDIT-INPUT.
018700     SET WS-NO-ERROR TO TRUE
018800     IF CLAIMIDL = ZERO OR CLAIMIDI = SPACES
018900        SET WS-ERROR-FOUND TO TRUE
019000        MOVE WS-MSG-01 TO MSGO
019100        MOVE -1 TO CLAIMIDL
019200     ELSE
019300        MOVE CLAIMIDI TO CA-CLAIM-ID
019400     END-IF
019500     PERFORM 1500-CHECK-AUTHORITY
019600     .
019700* --- 1500-CHECK-AUTHORITY: CONFIRM THE USER MAY RUN THIS FUNCTION
019800 1500-CHECK-AUTHORITY.
019900     MOVE WS-USER-ID TO WS-AUTH-USER
020000     MOVE 'CLRRC010' TO WS-AUTH-FUNCTION
020100     CALL 'CLRCM070' USING WS-AUTH-PARMS
020200                      CLR-ERROR-BLOCK
020300     IF ERR-SQLCODE NOT = ZERO
020400        MOVE 'CALL CLRCM070' TO ERR-PARA
020500        PERFORM 8000-SQL-ERROR
020600     END-IF
020700     IF WS-AUTH-ALLOWED NOT = 'Y'
020800        SET WS-ERROR-FOUND TO TRUE
020900        MOVE 8 TO CA-RETURN-CD
021000        MOVE 'NOT AUTHORISED FOR THIS FUNCTION' TO CA-MSG
021100     END-IF
021200     .
021300* --- 2200-APPLY: CARRY OUT THE REQUEST
021400 2200-APPLY.
021500     PERFORM 2300-READ-RECOVERY
021600     PERFORM 2500-EDIT-RECOVERY
021700     PERFORM 2510-EDIT-CLAIM
021800     PERFORM 2520-EDIT-RECOVERY-2
021900     PERFORM 2530-EDIT-CLAIM-2
022000     PERFORM 2540-EDIT-CLAIM-3
022100     PERFORM 4100-UPDATE-CLAIM
022200     IF WS-NO-ERROR
022300        EXEC CICS SYNCPOINT END-EXEC
022400        MOVE ZERO TO CA-RETURN-CD
022500     END-IF
022600     .
022700* --- 2300-READ-RECOVERY: LOOK UP CLR.T_RECOVERY
022800 2300-READ-RECOVERY.
022900     SET WS-ROW-FOUND TO TRUE
023000     EXEC SQL
023100         SELECT RCV_ID, CLAIM_ID, SUBRO_CASE_ID, RCV_TYPE_CD
023200           INTO :RCVR-RCV-ID, :RCVR-CLAIM-ID
023300                , :RCVR-SUBRO-CASE-ID, :RCVR-RCV-TYPE-CD
023400           FROM CLR.T_RECOVERY
023500          WHERE RCV_ID = :RCVR-RCV-ID
023600     END-EXEC
023700     EVALUATE SQLCODE
023800        WHEN 0
023900           ADD 1 TO WS-RECOVERY-READ
024000        WHEN +100
024100           SET WS-ROW-NOT-FOUND TO TRUE
024200        WHEN OTHER
024300           MOVE 'READ CLR.T_RECOVERY' TO ERR-PARA
024400           PERFORM 8000-SQL-ERROR
024500     END-EVALUATE
024600     .
024700* --- 2500-EDIT-RECOVERY: FIELD EDITS FOR CLR.T_RECOVERY
024800 2500-EDIT-RECOVERY.
024900     IF RCVR-CLAIM-ID = SPACES OR LOW-VALUES
025000        ADD 1 TO WS-REJECT-CNT
025100        MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
025200     END-IF
025300     IF RCVR-RCV-TYPE-CD NOT = 'SB' AND RCVR-RCV-TYPE-CD NOT =
025400         'SV' AND RCVR-RCV-TYPE-CD NOT = 'EX'
025500        ADD 1 TO WS-REJECT-CNT
025600        MOVE 'RCV_TYPE_CD INVALID' TO ERR-TEXT
025700     END-IF
025800     IF RCVR-RCV-EXPECTED-AMT NOT NUMERIC
025900        MOVE ZERO TO RCVR-RCV-EXPECTED-AMT
026000        ADD 1 TO WS-REJECT-CNT
026100     END-IF
026200     .
026300* --- 2510-EDIT-CLAIM: FIELD EDITS FOR CLR.T_CLAIM
026400 2510-EDIT-CLAIM.
026500     IF CLM-CLAIM-ID = SPACES OR LOW-VALUES
026600        ADD 1 TO WS-REJECT-CNT
026700        MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
026800     END-IF
026900     IF CLM-POLICY-NO = SPACES OR LOW-VALUES
027000        ADD 1 TO WS-REJECT-CNT
027100        MOVE 'POLICY_NO MISSING' TO ERR-TEXT
027200     END-IF
027300     IF CLM-PRODUCT-CD = SPACES OR LOW-VALUES
027400        ADD 1 TO WS-REJECT-CNT
027500        MOVE 'PRODUCT_CD MISSING' TO ERR-TEXT
027600     END-IF
027700     IF CLM-PERIL-CD = SPACES OR LOW-VALUES
027800        ADD 1 TO WS-REJECT-CNT
027900        MOVE 'PERIL_CD MISSING' TO ERR-TEXT
028000     END-IF
028100     IF CLM-LOSS-DT NOT = SPACES AND CLM-LOSS-DT(5:1) NOT = '-'
028200        MOVE 'LOSS_DT BAD DATE' TO ERR-TEXT
028300        ADD 1 TO WS-REJECT-CNT
028400     END-IF
028500     IF CLM-CHANNEL-CD NOT = 'PH' AND CLM-CHANNEL-CD NOT = 'WB'
028600         AND CLM-CHANNEL-CD NOT = 'AP' AND CLM-CHANNEL-CD NOT =
028700         'BR' AND CLM-CHANNEL-CD NOT = 'TL'
028800        ADD 1 TO WS-REJECT-CNT
028900        MOVE 'CHANNEL_CD INVALID' TO ERR-TEXT
029000     END-IF
029100     IF CLM-CLAIM-STATUS NOT = 'OP' AND CLM-CLAIM-STATUS NOT =
029200         'CS' AND CLM-CLAIM-STATUS NOT = 'CN' AND CLM-CLAIM-STATUS
029300         NOT = 'RO' AND CLM-CLAIM-STATUS NOT = 'RC'
029400        ADD 1 TO WS-REJECT-CNT
029500        MOVE 'CLAIM_STATUS INVALID' TO ERR-TEXT
029600     END-IF
029700     IF CLM-TIER-CD NOT = '1' AND CLM-TIER-CD NOT = '2' AND
029800         CLM-TIER-CD NOT = '3'
029900        ADD 1 TO WS-REJECT-CNT
030000        MOVE 'TIER_CD INVALID' TO ERR-TEXT
030100     END-IF
030200     .
030300* --- 2520-EDIT-RECOVERY-2: CHECK MANDATORY FIELDS IN CLR.T_RECOVE
030400 2520-EDIT-RECOVERY-2.
030500     IF RCVR-RCV-RECEIVED-AMT NOT NUMERIC
030600        MOVE ZERO TO RCVR-RCV-RECEIVED-AMT
030700        ADD 1 TO WS-REJECT-CNT
030800     END-IF
030900     IF RCVR-RCV-STATUS NOT = 'OP' AND RCVR-RCV-STATUS NOT = 'PT'
031000         AND RCVR-RCV-STATUS NOT = 'CL' AND RCVR-RCV-STATUS NOT =
031100         'WO'
031200        ADD 1 TO WS-REJECT-CNT
031300        MOVE 'RCV_STATUS INVALID' TO ERR-TEXT
031400     END-IF
031500     IF RCVR-CURRENCY-CD = SPACES OR LOW-VALUES
031600        ADD 1 TO WS-REJECT-CNT
031700        MOVE 'CURRENCY_CD MISSING' TO ERR-TEXT
031800     END-IF
031900     .
032000* --- 2530-EDIT-CLAIM-2: FIELD EDITS FOR CLR.T_CLAIM
032100 2530-EDIT-CLAIM-2.
032200     IF CLM-REGION-CD NOT = 'UK' AND CLM-REGION-CD NOT = 'NO' AND
032300         CLM-REGION-CD NOT = 'SE' AND CLM-REGION-CD NOT = 'DK'
032400        ADD 1 TO WS-REJECT-CNT
032500        MOVE 'REGION_CD INVALID' TO ERR-TEXT
032600     END-IF
032700     IF CLM-CURRENCY-CD NOT = 'GBP' AND CLM-CURRENCY-CD NOT =
032800         'NOK' AND CLM-CURRENCY-CD NOT = 'SEK' AND CLM-CURRENCY-CD
032900         NOT = 'DKK'
033000        ADD 1 TO WS-REJECT-CNT
033100        MOVE 'CURRENCY_CD INVALID' TO ERR-TEXT
033200     END-IF
033300     IF CLM-CLAIMANT-ID = SPACES OR LOW-VALUES
033400        ADD 1 TO WS-REJECT-CNT
033500        MOVE 'CLAIMANT_ID MISSING' TO ERR-TEXT
033600     END-IF
033700     IF CLM-HANDLER-USER-ID = SPACES OR LOW-VALUES
033800        ADD 1 TO WS-REJECT-CNT
033900        MOVE 'HANDLER_USER_ID MISSING' TO ERR-TEXT
034000     END-IF
034100     IF CLM-FRAUD-FLAG NOT = 'Y' AND CLM-FRAUD-FLAG NOT = 'N'
034200        ADD 1 TO WS-REJECT-CNT
034300        MOVE 'FRAUD_FLAG INVALID' TO ERR-TEXT
034400     END-IF
034500     IF CLM-RECOVERY-FLAG NOT = 'Y' AND CLM-RECOVERY-FLAG NOT =
034600         'N'
034700        ADD 1 TO WS-REJECT-CNT
034800        MOVE 'RECOVERY_FLAG INVALID' TO ERR-TEXT
034900     END-IF
035000     IF CLM-LOSS-DESC = SPACES OR LOW-VALUES
035100        ADD 1 TO WS-REJECT-CNT
035200        MOVE 'LOSS_DESC MISSING' TO ERR-TEXT
035300     END-IF
035400     .
035500* --- 2540-EDIT-CLAIM-3: CHECK MANDATORY FIELDS IN CLR.T_CLAIM
035600 2540-EDIT-CLAIM-3.
035700     IF CLM-CLOSED-DT NOT = SPACES AND CLM-CLOSED-DT(5:1) NOT =
035800         '-'
035900        MOVE 'CLOSED_DT BAD DATE' TO ERR-TEXT
036000        ADD 1 TO WS-REJECT-CNT
036100     END-IF
036200     .
036300* --- 4100-UPDATE-CLAIM: UPDATE CLR.T_CLAIM
036400 4100-UPDATE-CLAIM.
036500     EXEC SQL
036600         UPDATE CLR.T_CLAIM
036700            SET RECOVERY_FLAG = 'Y'
036800              , LAST_UPD_TS = CURRENT TIMESTAMP
036900              , LAST_UPD_PGM = :WS-PGM-ID
037000              , LAST_UPD_USER = :WS-USER-ID
037100          WHERE CLAIM_ID = :CA-CLAIM-ID
037200     END-EXEC
037300     EVALUATE SQLCODE
037400        WHEN 0
037500           ADD 1 TO WS-CLAIM-WRITTEN
037600        WHEN +100
037700           SET WS-ROW-NOT-FOUND TO TRUE
037800        WHEN OTHER
037900           MOVE 'UPDATE CLR.T_CLAIM' TO ERR-PARA
038000           PERFORM 8000-SQL-ERROR
038100     END-EVALUATE
038200     .
038300* --- 9000-RETURN: RETURN TO CICS
038400 9000-RETURN.
038500     EXEC CICS RETURN TRANSID('RC01') COMMAREA(CLR-COMMAREA)
038600        LENGTH(LENGTH OF CLR-COMMAREA) END-EXEC
038700     .
038800* --- 8000-SQL-ERROR: UNEXPECTED SQLCODE
038900 8000-SQL-ERROR.
039000     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
039100     MOVE WS-PGM-ID TO ERR-PGM
039200     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
039300         ERR-TEXT
039400     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
039500     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
039600     MOVE 16 TO CA-RETURN-CD
039700     MOVE ERR-TEXT TO CA-MSG
039800     PERFORM 9000-RETURN
039900     .
