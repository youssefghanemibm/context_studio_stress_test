009700 PROCEDURE DIVISION.
009800* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
009900 0000-MAIN.
010000     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
010100     IF EIBCALEN = ZERO
010200        INITIALIZE CLR-COMMAREA
010300        MOVE 'FR10' TO CA-TRANID
010400        MOVE 12 TO CA-RETURN-CD
010500        MOVE 'NO COMMAREA SUPPLIED' TO CA-MSG
010600        PERFORM 9000-RETURN
010700     ELSE
010800        MOVE DFHCOMMAREA TO CLR-COMMAREA
010900        PERFORM 2000-PROCESS-INPUT
011000     END-IF
011100     PERFORM 9000-RETURN
011200     GOBACK.
011300* --- 2000-PROCESS-INPUT: INPUT PROCESSING
011400 2000-PROCESS-INPUT.
011500     PERFORM 2100-EDIT-INPUT
011600     IF WS-NO-ERROR
011700        PERFORM 2200-APPLY
011800     END-IF
011900     .
012000* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
012100 2100-EDIT-INPUT.
012200     SET WS-NO-ERROR TO TRUE
012300     IF CA-CLAIM-ID = SPACES OR LOW-VALUES
012400        SET WS-ERROR-FOUND TO TRUE
012500        MOVE 8 TO CA-RETURN-CD
012600        MOVE 'CLAIM ID IS REQUIRED' TO CA-MSG
012700     END-IF
012800     PERFORM 1500-CHECK-AUTHORITY
012900     .
013000* --- 1500-CHECK-AUTHORITY: CONFIRM THE USER MAY RUN THIS FUNCTION
013100 1500-CHECK-AUTHORITY.
013200     MOVE WS-USER-ID TO WS-AUTH-USER
013300     MOVE 'CLRFR100' TO WS-AUTH-FUNCTION
013400     CALL 'CLRCM070' USING WS-AUTH-PARMS
013500                      CLR-ERROR-BLOCK
013600     IF ERR-SQLCODE NOT = ZERO
013700        MOVE 'CALL CLRCM070' TO ERR-PARA
013800        PERFORM 8000-SQL-ERROR
013900     END-IF
014000     IF WS-AUTH-ALLOWED NOT = 'Y'
014100        SET WS-ERROR-FOUND TO TRUE
014200        MOVE 8 TO CA-RETURN-CD
014300        MOVE 'NOT AUTHORISED FOR THIS FUNCTION' TO CA-MSG
014400     END-IF
014500     .
014600* --- 2200-APPLY: CARRY OUT THE REQUEST
014700 2200-APPLY.
014750     PERFORM 2300-READ-FRAU-NOTI
014800     PERFORM 2320-READ-FRAU-REFE
014900     IF WS-NO-ERROR
015000        MOVE ZERO TO CA-RETURN-CD
015100     END-IF
015200     .
015204* --- 2300-READ-FRAU-NOTI: LOOK UP CLR.T_FRAUD_NOTIFICATION
015208 2300-READ-FRAU-NOTI.
015212     SET WS-ROW-FOUND TO TRUE
015216     EXEC SQL
015220         SELECT NOTICE_ID, REF_ID, CLAIM_ID
015224                , NOTICE_CHANNEL_CD, NOTICE_DUE_DT
015228           INTO :FRDN-NOTICE-ID, :FRDN-REF-ID, :FRDN-CLAIM-ID
015232                , :FRDN-NOTICE-CHANNEL-CD
015236                , :FRDN-NOTICE-DUE-DT
015240           FROM CLR.T_FRAUD_NOTIFICATION
015244          WHERE NOTICE_ID = :FRDN-NOTICE-ID
015248     END-EXEC
015252     EVALUATE SQLCODE
015256        WHEN 0
015260           ADD 1 TO WS-FRAUD-NOTIFICATION-READ
015264        WHEN +100
015268           SET WS-ROW-NOT-FOUND TO TRUE
015272        WHEN OTHER
015276           MOVE 'READ CLR.T_FRAUD_NOTIFICATION' TO ERR-PARA
015280           PERFORM 8000-SQL-ERROR
015284     END-EVALUATE
015288     .
015300* --- 2320-READ-FRAU-REFE: READ CLR.T_FRAUD_REFERRAL
015400 2320-READ-FRAU-REFE.
015500     SET WS-ROW-FOUND TO TRUE
015600     EXEC SQL
015700         SELECT REF_ID, CLAIM_ID, REF_TS, REF_SCORE
015800           INTO :FRDR-REF-ID, :FRDR-CLAIM-ID, :FRDR-REF-TS
015900                , :FRDR-REF-SCORE
016000           FROM CLR.T_FRAUD_REFERRAL
016100          WHERE REF_ID = :FRDR-REF-ID
016200     END-EXEC
016300     EVALUATE SQLCODE
016400        WHEN 0
016500           ADD 1 TO WS-FRAUD-REFERRAL-READ
016600        WHEN +100
016700           SET WS-ROW-NOT-FOUND TO TRUE
016800        WHEN OTHER
016900           MOVE 'READ CLR.T_FRAUD_REFERRAL' TO ERR-PARA
017000           PERFORM 8000-SQL-ERROR
017100     END-EVALUATE
017200     .
017300* --- 9000-RETURN: RETURN TO CICS
017400 9000-RETURN.
017500     MOVE CLR-COMMAREA TO DFHCOMMAREA
017600     EXEC CICS RETURN END-EXEC
017700     .
017800* --- 8000-SQL-ERROR: UNEXPECTED SQLCODE
017900 8000-SQL-ERROR.
018000     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
018100     MOVE WS-PGM-ID TO ERR-PGM
018200     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
018300         ERR-TEXT
018400     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
018500     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
018600     MOVE 16 TO CA-RETURN-CD
018700     MOVE ERR-TEXT TO CA-MSG
018800     PERFORM 9000-RETURN
018900     .
