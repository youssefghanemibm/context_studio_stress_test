014300* --- 2300-READ-CODE-LOOKUP: LOOK UP CLR.T_CODE_LOOKUP
014400 2300-READ-CODE-LOOKUP.
014500     SET WS-ROW-FOUND TO TRUE
014600     EXEC SQL
014700         SELECT CODE_TYPE, CODE_VALUE, CODE_DESC_EN
014800                , CODE_DESC_LOCAL, ACTIVE_FLAG
014900           INTO :CODE-CODE-TYPE, :CODE-CODE-VALUE
015000                , :CODE-CODE-DESC-EN, :CODE-CODE-DESC-LOCAL
015100                , :CODE-ACTIVE-FLAG
015200           FROM CLR.T_CODE_LOOKUP
015300          WHERE CODE_TYPE = :CODE-CODE-TYPE
015400            AND CODE_VALUE = :CODE-CODE-VALUE
015500     END-EXEC
015600     EVALUATE SQLCODE
015700        WHEN 0
015800           ADD 1 TO WS-CODE-LOOKUP-READ
015900        WHEN +100
016000           SET WS-ROW-NOT-FOUND TO TRUE
016100        WHEN OTHER
016200           MOVE 'READ CLR.T_CODE_LOOKUP' TO ERR-PARA
016300           PERFORM 8000-SQL-ERROR
016400     END-EVALUATE
016500     .
016600* --- 2320-READ-USER: READ CLR.T_USER
016700 2320-READ-USER.
016800     MOVE WS-USER-ID TO USRR-USER-ID
016900     SET WS-ROW-FOUND TO TRUE
017000     EXEC SQL
017100         SELECT USER_ID, USER_NAME, TEAM_CD, RSV_AUTH_LEVEL
017200                , PAY_AUTH_LEVEL
017300           INTO :USRR-USER-ID, :USRR-USER-NAME, :USRR-TEAM-CD
017400                , :USRR-RSV-AUTH-LEVEL, :USRR-PAY-AUTH-LEVEL
017500           FROM CLR.T_USER
017600          WHERE USER_ID = :USRR-USER-ID
017700     END-EXEC
017800     EVALUATE SQLCODE
017900        WHEN 0
018000           ADD 1 TO WS-USER-READ
018100        WHEN +100
018200           SET WS-ROW-NOT-FOUND TO TRUE
018300        WHEN OTHER
018400           MOVE 'READ CLR.T_USER' TO ERR-PARA
018500           PERFORM 8000-SQL-ERROR
018600     END-EVALUATE
018700     .
018800* --- 4100-DELETE-INTERFACE-LOG: DELETE CLR.T_INTERFACE_LOG
018900 4100-DELETE-INTERFACE-LOG.
019000     EXEC SQL
019100         DELETE FROM CLR.T_INTERFACE_LOG
019200          WHERE RUN_TS < :WS-PURGE-BEFORE-TS
019300     END-EXEC
019400     EVALUATE SQLCODE
019500        WHEN 0
019600           ADD 1 TO WS-INTERFACE-LOG-WRITTEN
019700        WHEN +100
019800           SET WS-ROW-NOT-FOUND TO TRUE
019900        WHEN OTHER
