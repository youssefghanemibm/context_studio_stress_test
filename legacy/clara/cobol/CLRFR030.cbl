025200* --- 2000-GET-THRESHOLDS: REFERRAL THRESHOLDS FROM CLR.T_PARAM
025300 2000-GET-THRESHOLDS.
025400* REFERRAL THRESHOLDS ARE READ FROM CLR.T_PARAM THROUGH CLRCM040
025500*   WITH
025600* VALIDITY DATES. FRD_REFER_T3_THRESH APPLIES TO TIER-3 CLAIMS
025700*   ONLY.
025800     MOVE 'FRD_REFER_THRESH' TO PARM-PARAM-KEY
025900     CALL 'CLRCM040' USING PARMREC1-REC
026000                      CLR-ERROR-BLOCK
026100     IF ERR-SQLCODE NOT = ZERO
026200         MOVE 'CALL CLRCM040' TO ERR-PARA
026300         PERFORM 8000-SQL-ERROR
026400     END-IF
026500     MOVE FUNCTION NUMVAL(PARM-PARAM-VALUE) TO WS-REFER-THRESHOLD
026600     MOVE 'FRD_REFER_T3_THRESH' TO PARM-PARAM-KEY
026700     CALL 'CLRCM040' USING PARMREC1-REC
026800                      CLR-ERROR-BLOCK
026900     IF ERR-SQLCODE NOT = ZERO
027000         MOVE 'CALL CLRCM040' TO ERR-PARA
027100         PERFORM 8000-SQL-ERROR
027200     END-IF
027300     IF ERR-SQLCODE = ZERO AND PARM-PARAM-VALUE NOT = SPACES
027400         MOVE FUNCTION NUMVAL(PARM-PARAM-VALUE) TO
027500             WS-REFER-T3-THRESHOLD
027600     ELSE
027700         MOVE WS-REFER-THRESHOLD TO WS-REFER-T3-THRESHOLD
027800     END-IF
027900     EXEC SQL
028000         SELECT PARAM_DESC
028100           INTO :PARM-PARAM-DESC
028200           FROM CLR.T_PARAM
028300          WHERE PARAM_KEY = 'FRD_REFER_THRESH'
028400            AND VALID_FROM <= CURRENT DATE
028500            AND (VALID_TO IS NULL OR VALID_TO >= CURRENT DATE)
028600     END-EXEC
028700     EVALUATE SQLCODE
028800         WHEN 0
028900             CONTINUE
029000         WHEN +100
029100             SET WS-ROW-NOT-FOUND TO TRUE
029200         WHEN OTHER
029300             MOVE '2000-GET-THRESHOLDS' TO ERR-PARA
029400             PERFORM 8000-SQL-ERROR
029500     END-EVALUATE
029600     .
