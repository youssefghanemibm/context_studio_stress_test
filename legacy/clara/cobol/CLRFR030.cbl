048500     IF FRDR-OUTCOME-CD NOT = 'NF' AND FRDR-OUTCOME-CD NOT = 'CF'
048600         AND FRDR-OUTCOME-CD NOT = 'WD'
048700         ADD 1 TO WS-REJECT-CNT
048800         MOVE 'OUTCOME_CD INVALID' TO ERR-TEXT
048900     END-IF
049000     IF FRDR-OUTCOME-DT NOT = SPACES AND FRDR-OUTCOME-DT(5:1) NOT
049100         = '-'
049200         MOVE 'OUTCOME_DT BAD DATE' TO ERR-TEXT
049300         ADD 1 TO WS-REJECT-CNT
049400     END-IF
049500     .
049600* --- 2580-EDIT-CLAIM-TIER-3: VALIDATE CLR.T_CLAIM_TIER
049700 2580-EDIT-CLAIM-TIER-3.
049800* --- 2590-EDIT-FRAUD-SCORE-3: CHECK MANDATORY FIELDS IN CLR.T_FRA
049900 2590-EDIT-FRAUD-SCORE-3.
050000* --- 2600-EDIT-PARAM-3: VALIDATE CLR.T_PARAM
050100 2600-EDIT-PARAM-3.
050200     IF PARM-CHANGED-BY = SPACES OR LOW-VALUES
050300         ADD 1 TO WS-REJECT-CNT
050400         MOVE 'CHANGED_BY MISSING' TO ERR-TEXT
050500     END-IF
050600     .
050700* --- 3000-DECIDE-REFERRAL: COMPARE THE SENTINEL SCORE
050800 3000-DECIDE-REFERRAL.
050900     IF TIR-TIER-CD = '3'
051000         MOVE WS-REFER-T3-THRESHOLD TO WS-APPLIED-THRESHOLD
051100     ELSE
051200         MOVE WS-REFER-THRESHOLD TO WS-APPLIED-THRESHOLD
051300     END-IF
051400     MOVE WS-APPLIED-THRESHOLD TO THREO
051500     IF FRDS-SCORE >= WS-APPLIED-THRESHOLD
051600         PERFORM 4000-CREATE-REFERRAL
051700         PERFORM 4500-NOTIFY-SIU
051800     ELSE
051900         MOVE 'SCORE BELOW REFERRAL THRESHOLD' TO MSGO
052000     END-IF
052100     .
052200* --- 9000-RETURN: RETURN TO CICS
052300 9000-RETURN.
052400     EXEC CICS RETURN TRANSID('FR03') COMMAREA(CLR-COMMAREA)
052500         LENGTH(LENGTH OF CLR-COMMAREA) END-EXEC
052600     .
052700* --- 4000-CREATE-REFERRAL: INSERT THE REFERRAL
052800 4000-CREATE-REFERRAL.
052900     MOVE CA-CLAIM-ID TO FRDR-CLAIM-ID
053000     MOVE FRDS-SCORE TO FRDR-REF-SCORE
053100     MOVE WS-APPLIED-THRESHOLD TO FRDR-REF-THRESHOLD-APPLIED
053200     MOVE 'ON' TO FRDR-REF-SOURCE-CD
053300     MOVE TIR-TIER-CD TO FRDR-TIER-CD
053400     MOVE 'OP' TO FRDR-REF-STATUS
053500     MOVE 'N' TO FRDR-CUSTOMER-NOTICE-DEFER-FLAG
053600     EXEC SQL
053700         INSERT INTO CLR.T_FRAUD_REFERRAL
053800              ( CLAIM_ID, REF_TS, REF_SCORE
053900              , REF_THRESHOLD_APPLIED, REF_SOURCE_CD
054000              , REF_REASON_CD, RULE_ID, TIER_CD, SIU_CASE_ID
054100              , REF_STATUS, CUSTOMER_NOTICE_DUE_DT
054200              , CUSTOMER_NOTICE_DEFER_FLAG, DEFER_APPROVED_BY
054300              , OUTCOME_CD, OUTCOME_DT, LAST_UPD_TS
054400              , LAST_UPD_PGM, LAST_UPD_USER )
054500         VALUES
054600              ( :FRDR-CLAIM-ID, CURRENT TIMESTAMP
054700              , :FRDR-REF-SCORE, :FRDR-REF-THRESHOLD-APPLIED
054800              , :FRDR-REF-SOURCE-CD, :FRDR-REF-REASON-CD
054900              , :FRDR-RULE-ID, :FRDR-TIER-CD, :FRDR-SIU-CASE-ID
055000              , :FRDR-REF-STATUS, :FRDR-CUSTOMER-NOTICE-DUE-DT
055100              , :FRDR-CUSTOMER-NOTICE-DEFER-FLAG
055200              , :FRDR-DEFER-APPROVED-BY, :FRDR-OUTCOME-CD
055300              , :FRDR-OUTCOME-DT, CURRENT TIMESTAMP, :WS-PGM-ID
055400              , :WS-USER-ID )
055500     END-EXEC
055600     EVALUATE SQLCODE
055700         WHEN 0
055800             ADD 1 TO WS-FRAUD-REFERRAL-WRITTEN
055900         WHEN +100
056000             SET WS-ROW-NOT-FOUND TO TRUE
056100         WHEN OTHER
056200             MOVE '4000-CREATE-REFERRAL' TO ERR-PARA
056300             PERFORM 8000-SQL-ERROR
056400     END-EVALUATE
056500     MOVE 'CLR.T_FRAUD_REFERRAL' TO WS-AUD-TABLE
056600     MOVE CA-CLAIM-ID TO WS-AUD-KEY
056700     MOVE 'U' TO WS-AUD-ACTION
056800     MOVE WS-USER-ID TO WS-AUD-USER
056900     MOVE WS-PGM-ID TO WS-AUD-PGM
057000     CALL 'CLRCM020' USING WS-AUDIT-PARMS
057100                      CLR-ERROR-BLOCK
057200     IF ERR-SQLCODE NOT = ZERO
057300         ADD 1 TO WS-REJECT-CNT
057400     END-IF
057500     .
057600* --- 4500-NOTIFY-SIU: REFERRAL MESSAGE TO SIU CASE MANAGER
057700 4500-NOTIFY-SIU.
057800     MOVE 'MQPUT' TO WS-MQ-FUNCTION
057900     MOVE 'CLR.SIUREF.OUT' TO MQ-QUEUE-NAME
058000     MOVE FRDREF01-REC TO WS-MQ-BUFFER
058100     MOVE LENGTH OF FRDREF01-REC TO WS-MQ-BUFFER-LEN
058200     CALL 'CLRCM110' USING CLR-MQ-AREA
058300                      WS-MQ-PARMS
058400                      CLR-ERROR-BLOCK
058500     IF ERR-SQLCODE NOT = ZERO
058600         MOVE 'CALL CLRCM110' TO ERR-PARA
058700         PERFORM 8000-SQL-ERROR
058800     END-IF
058900     .
059000* --- 8000-SQL-ERROR: UNEXPECTED SQLCODE
059100 8000-SQL-ERROR.
059200     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
059300     MOVE WS-PGM-ID TO ERR-PGM
059400     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
059500         ERR-TEXT
059600     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
059700     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
059800     MOVE 16 TO CA-RETURN-CD
059900     MOVE ERR-TEXT TO CA-MSG
060000     PERFORM 9000-RETURN
060100     .
