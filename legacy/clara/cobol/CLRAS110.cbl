010100 PROCEDURE DIVISION.
010200* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
010300 0000-MAIN.
010400     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
010500     IF EIBCALEN = ZERO
010600         INITIALIZE CLR-COMMAREA
010700         MOVE 'AS11' TO CA-TRANID
010800         MOVE 12 TO CA-RETURN-CD
010900         MOVE 'NO COMMAREA SUPPLIED' TO CA-MSG
011000         PERFORM 9000-RETURN
011100     ELSE
011200         MOVE DFHCOMMAREA TO CLR-COMMAREA
011300         PERFORM 2000-PROCESS-INPUT
011400     END-IF
011500     PERFORM 9000-RETURN
011600     GOBACK.
011700* --- 2000-PROCESS-INPUT: HANDLE THE TERMINAL INPUT
011800 2000-PROCESS-INPUT.
011900     PERFORM 2100-EDIT-INPUT
012000     IF WS-NO-ERROR
012100         PERFORM 2200-APPLY
012200     END-IF
012300     .
012400* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
012500 2100-EDIT-INPUT.
012600     SET WS-NO-ERROR TO TRUE
012700     IF CA-CLAIM-ID = SPACES OR LOW-VALUES
012800         SET WS-ERROR-FOUND TO TRUE
012900         MOVE 8 TO CA-RETURN-CD
013000         MOVE 'CLAIM ID IS REQUIRED' TO CA-MSG
013100     END-IF
013200     .
013300* --- 2200-APPLY: CARRY OUT THE REQUEST
013400 2200-APPLY.
013500     PERFORM 2300-READ-INSPECTION
013600     PERFORM 2500-EDIT-INSPECTION
013700     PERFORM 2510-EDIT-ASSESSMENT
013800     PERFORM 2520-EDIT-INSPECTION-2
013900     PERFORM 2530-EDIT-ASSESSMENT-2
014000     PERFORM 4100-INSERT-ASSESSMENT
014100     PERFORM 4900-WRITE-AUDIT
014200     IF WS-NO-ERROR
014300         EXEC CICS SYNCPOINT END-EXEC
014400         MOVE ZERO TO CA-RETURN-CD
014500     END-IF
014600     .
014700* --- 2300-READ-INSPECTION: READ CLR.T_INSPECTION
014800 2300-READ-INSPECTION.
014900     SET WS-ROW-FOUND TO TRUE
015000     EXEC SQL
015100         SELECT INSP_ID, CLAIM_ID, BOOKED_TS, COMPLETED_TS
015200                , INSP_ADDR
015300           INTO :INS-INSP-ID, :INS-CLAIM-ID, :INS-BOOKED-TS
015400                , :INS-COMPLETED-TS, :INS-INSP-ADDR
015500           FROM CLR.T_INSPECTION
015600          WHERE INSP_ID = :INS-INSP-ID
015700     END-EXEC
015800     EVALUATE SQLCODE
015900         WHEN 0
016000             ADD 1 TO WS-INSPECTION-READ
016100         WHEN +100
016200             SET WS-ROW-NOT-FOUND TO TRUE
016300         WHEN OTHER
016400             MOVE 'READ CLR.T_INSPECTION' TO ERR-PARA
016500             PERFORM 8000-SQL-ERROR
016600     END-EVALUATE
016700     .
016800* --- 2500-EDIT-INSPECTION: CHECK MANDATORY FIELDS IN CLR.T_INSPEC
016900 2500-EDIT-INSPECTION.
017000     IF INS-CLAIM-ID = SPACES OR LOW-VALUES
017100         ADD 1 TO WS-REJECT-CNT
017200         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
017300     END-IF
017400     .
017500* --- 2510-EDIT-ASSESSMENT: FIELD EDITS FOR CLR.T_ASSESSMENT
017600 2510-EDIT-ASSESSMENT.
017700     IF ASM-CLAIM-ID = SPACES OR LOW-VALUES
017800         ADD 1 TO WS-REJECT-CNT
017900         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
018000     END-IF
018100     IF ASM-ASSESS-TYPE-CD NOT = 'DK' AND ASM-ASSESS-TYPE-CD NOT =
018200         'SV' AND ASM-ASSESS-TYPE-CD NOT = 'VI'
018300         ADD 1 TO WS-REJECT-CNT
018400         MOVE 'ASSESS_TYPE_CD INVALID' TO ERR-TEXT
018500     END-IF
018600     .
018700* --- 2520-EDIT-INSPECTION-2: CHECK MANDATORY FIELDS IN CLR.T_INSP
018800 2520-EDIT-INSPECTION-2.
018900     IF INS-INSP-ADDR = SPACES OR LOW-VALUES
019000         ADD 1 TO WS-REJECT-CNT
019100         MOVE 'INSP_ADDR MISSING' TO ERR-TEXT
019200     END-IF
019300     .
019400* --- 2530-EDIT-ASSESSMENT-2: VALIDATE CLR.T_ASSESSMENT
019500 2530-EDIT-ASSESSMENT-2.
019600     IF ASM-COVER-DECISION-CD NOT = 'AC' AND ASM-COVER-DECISION-CD
019700         NOT = 'DC' AND ASM-COVER-DECISION-CD NOT = 'PA'
019800         ADD 1 TO WS-REJECT-CNT
019900         MOVE 'COVER_DECISION_CD INVALID' TO ERR-TEXT
020000     END-IF
020100     IF ASM-ESTIMATE-AMT NOT NUMERIC
020200         MOVE ZERO TO ASM-ESTIMATE-AMT
020300         ADD 1 TO WS-REJECT-CNT
020400     END-IF
020500     IF ASM-REPORT-RECEIVED-DT NOT = SPACES AND
020600         ASM-REPORT-RECEIVED-DT(5:1) NOT = '-'
020700         MOVE 'REPORT_RECEIVED_DT BAD DATE' TO ERR-TEXT
020800         ADD 1 TO WS-REJECT-CNT
020900     END-IF
021000     .
021100* --- 4100-INSERT-ASSESSMENT: INSERT CLR.T_ASSESSMENT
021200 4100-INSERT-ASSESSMENT.
021300     MOVE CA-CLAIM-ID TO ASM-CLAIM-ID
021400     MOVE 'AC' TO ASM-COVER-DECISION-CD
021500     EXEC SQL
021600         INSERT INTO CLR.T_ASSESSMENT
021700              ( CLAIM_ID, ASSESS_TYPE_CD, COVER_DECISION_CD
021800              , ESTIMATE_AMT, REPORT_RECEIVED_DT, LAST_UPD_TS
021900              , LAST_UPD_PGM, LAST_UPD_USER )
022000         VALUES
022100              ( :ASM-CLAIM-ID, :ASM-ASSESS-TYPE-CD
022200              , :ASM-COVER-DECISION-CD, :ASM-ESTIMATE-AMT
022300              , :ASM-REPORT-RECEIVED-DT, CURRENT TIMESTAMP
022400              , :WS-PGM-ID, :WS-USER-ID )
022500     END-EXEC
022600     EVALUATE SQLCODE
022700         WHEN 0
022800             ADD 1 TO WS-ASSESSMENT-WRITTEN
022900         WHEN +100
023000             SET WS-ROW-NOT-FOUND TO TRUE
023100         WHEN OTHER
023200             MOVE 'INSERT CLR.T_ASSESSMENT' TO ERR-PARA
023300             PERFORM 8000-SQL-ERROR
023400     END-EVALUATE
023500     .
023600* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
023700 4900-WRITE-AUDIT.
023800     MOVE 'CLR.T_ASSESSMENT' TO WS-AUD-TABLE
023900     MOVE CA-CLAIM-ID TO WS-AUD-KEY
024000     MOVE 'U' TO WS-AUD-ACTION
024100     MOVE WS-USER-ID TO WS-AUD-USER
024200     MOVE WS-PGM-ID TO WS-AUD-PGM
024300     CALL 'CLRCM020' USING WS-AUDIT-PARMS
024400                      CLR-ERROR-BLOCK
024500     IF ERR-SQLCODE NOT = ZERO
024600         ADD 1 TO WS-REJECT-CNT
024700     END-IF
024800     .
024900* --- 9000-RETURN: RETURN TO CICS
025000 9000-RETURN.
025100     MOVE CLR-COMMAREA TO DFHCOMMAREA
025200     EXEC CICS RETURN END-EXEC
025300     .
025400* --- 8000-SQL-ERROR: DB2 ERROR HANDLING
025500 8000-SQL-ERROR.
025600     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
025700     MOVE WS-PGM-ID TO ERR-PGM
025800     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
025900         ERR-TEXT
026000     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
026100     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
026200     MOVE 16 TO CA-RETURN-CD
026300     MOVE ERR-TEXT TO CA-MSG
026400     PERFORM 9000-RETURN
026500     .
