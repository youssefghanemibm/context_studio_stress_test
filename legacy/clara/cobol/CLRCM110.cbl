009300* --- 2300-READ-CODE-LOOKUP: READ CLR.T_CODE_LOOKUP
009400 2300-READ-CODE-LOOKUP.
009500     SET WS-ROW-FOUND TO TRUE
009600     EXEC SQL
009700         SELECT CODE_TYPE, CODE_VALUE, CODE_DESC_EN
009800                , CODE_DESC_LOCAL, ACTIVE_FLAG
009900           INTO :CODE-CODE-TYPE, :CODE-CODE-VALUE
010000                , :CODE-CODE-DESC-EN, :CODE-CODE-DESC-LOCAL
010100                , :CODE-ACTIVE-FLAG
010200           FROM CLR.T_CODE_LOOKUP
010300          WHERE CODE_TYPE = :CODE-CODE-TYPE
010400            AND CODE_VALUE = :CODE-CODE-VALUE
010500     END-EXEC
010600     EVALUATE SQLCODE
010700         WHEN 0
010800             ADD 1 TO WS-CODE-LOOKUP-READ
010900         WHEN +100
011000             SET WS-ROW-NOT-FOUND TO TRUE
011100         WHEN OTHER
011200             MOVE 'READ CLR.T_CODE_LOOKUP' TO ERR-PARA
011300             PERFORM 8000-SQL-ERROR
011400     END-EVALUATE
011500     .
011600 2300-READ-CODE-LOOKUP-EXIT.
011700     EXIT.
011800* --- 2500-EDIT-CODE-LOOKUP: FIELD EDITS FOR CLR.T_CODE_LOOKUP
011900 2500-EDIT-CODE-LOOKUP.
012000     IF CODE-CODE-TYPE = SPACES OR LOW-VALUES
012100         ADD 1 TO WS-REJECT-CNT
012200         MOVE 'CODE_TYPE MISSING' TO ERR-TEXT
012300     END-IF
012400     IF CODE-CODE-VALUE = SPACES OR LOW-VALUES
012500         ADD 1 TO WS-REJECT-CNT
012600         MOVE 'CODE_VALUE MISSING' TO ERR-TEXT
012700     END-IF
012800     IF CODE-CODE-DESC-EN = SPACES OR LOW-VALUES
012900         ADD 1 TO WS-REJECT-CNT
013000         MOVE 'CODE_DESC_EN MISSING' TO ERR-TEXT
013100     END-IF
013200     .
013300 2500-EDIT-CODE-LOOKUP-EXIT.
013400     EXIT.
013500* --- 2510-EDIT-CODE-LOOKUP-2: CHECK MANDATORY FIELDS IN CLR.T_COD
013600 2510-EDIT-CODE-LOOKUP-2.
013700     IF CODE-ACTIVE-FLAG = SPACES OR LOW-VALUES
013800         ADD 1 TO WS-REJECT-CNT
013900         MOVE 'ACTIVE_FLAG MISSING' TO ERR-TEXT
014000     END-IF
014100     .
014200 2510-EDIT-CODE-LOOKUP-2-EXIT.
014300     EXIT.
014400* --- 9000-RETURN: COPY RESULTS BACK TO THE CALLER
014500 9000-RETURN.
014600     MOVE CLR-ERROR-BLOCK TO LS-ERROR-BLOCK
014700     GOBACK.
014800 9000-RETURN-EXIT.
014900     EXIT.
015000* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
015100 8000-SQL-ERROR.
015200     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
015300     MOVE WS-PGM-ID TO ERR-PGM
015400     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
015500         ERR-TEXT
015600     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
015700     GO TO 9000-RETURN.
015800 8000-SQL-ERROR-EXIT.
015900     EXIT.
