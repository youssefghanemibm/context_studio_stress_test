011200* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
011300 0000-MAIN.
011400     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
011500     IF EIBCALEN = ZERO
011600        INITIALIZE CLR-COMMAREA
011700        MOVE 'FN02' TO CA-TRANID
011800        MOVE 12 TO CA-RETURN-CD
011900        MOVE 'NO COMMAREA SUPPLIED' TO CA-MSG
012000        PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
012100     ELSE
012200        MOVE DFHCOMMAREA TO CLR-COMMAREA
012300        PERFORM 2000-PROCESS-INPUT THRU 2000-PROCESS-INPUT-EXIT
012400     END-IF
012500     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
012600     GOBACK.
012700 0000-MAIN-EXIT.
012800     EXIT.
012900* --- 2000-PROCESS-INPUT: PROCESS THE REQUEST
013000 2000-PROCESS-INPUT.
013100     PERFORM 2100-EDIT-INPUT THRU 2100-EDIT-INPUT-EXIT
013200     IF WS-NO-ERROR
013300        PERFORM 2200-APPLY THRU 2200-APPLY-EXIT
013400     END-IF
013500     .
013600 2000-PROCESS-INPUT-EXIT.
013700     EXIT.
013800* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
013900 2100-EDIT-INPUT.
014000     SET WS-NO-ERROR TO TRUE
014100     IF CA-CLAIM-ID = SPACES OR LOW-VALUES
014200        SET WS-ERROR-FOUND TO TRUE
014300        MOVE 8 TO CA-RETURN-CD
014400        MOVE 'CLAIM ID IS REQUIRED' TO CA-MSG
014500     END-IF
014600     PERFORM 1400-GET-BUSINESS-DATE THRU
014700         1400-GET-BUSINESS-DATE-EXIT
014800     .
014900 2100-EDIT-INPUT-EXIT.
015000     EXIT.
015100* --- 1400-GET-BUSINESS-DATE: DETERMINE PROCESSING DATE
015200 1400-GET-BUSINESS-DATE.
015300     MOVE WS-RUN-DATE TO DW-IN-DATE
015400     MOVE CLM-REGION-CD TO DW-CALENDAR
015500     MOVE ZERO TO DW-BUS-DAYS
015600     CALL 'CLRCM010' USING CLR-DATE-WORK
015700                      CLR-ERROR-BLOCK
015800     IF ERR-SQLCODE NOT = ZERO
015900        MOVE 'CALL CLRCM010' TO ERR-PARA
016000        PERFORM 8000-SQL-ERROR
016100     END-IF
016200     .
016300 1400-GET-BUSINESS-DATE-EXIT.
016400     EXIT.
016500* --- 2200-APPLY: APPLY THE CHANGE
016600 2200-APPLY.
016700     PERFORM 2300-READ-CLAIM THRU 2300-READ-CLAIM-EXIT
