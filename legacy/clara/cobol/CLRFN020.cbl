035400              ( CLAIMANT_ID, FAMILY_NAME, GIVEN_NAME, DOB
035500              , NI_NO, ADDR_LINE1, POSTCODE, PHONE_NO
035600              , EMAIL_ADDR, PARTY_ROLE_CD, VULNERABLE_FLAG
