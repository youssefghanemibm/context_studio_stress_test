035900              ( :CLT-CLAIMANT-ID, :CLT-FAMILY-NAME
036000              , :CLT-GIVEN-NAME, :CLT-DOB, :CLT-NI-NO
036100              , :CLT-ADDR-LINE1, :CLT-POSTCODE, :CLT-PHONE-NO
036200              , :CLT-EMAIL-ADDR, :CLT-PARTY-ROLE-CD
036300              , :CLT-VULNERABLE-FLAG, CURRENT TIMESTAMP
036400              , :WS-PGM-ID, :WS-USER-ID )
036500     END-EXEC
