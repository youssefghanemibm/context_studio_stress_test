017800        MOVE ZERO TO CA-RETURN-CD
017900     END-IF
018000     .
018100 2200-APPLY-EXIT.
018200     EXIT.
018300* --- 2300-READ-CLAIM: FETCH CLR.T_CLAIM
018400 2300-READ-CLAIM.
018500     MOVE CA-CLAIM-ID TO CLM-CLAIM-ID
018600     SET WS-ROW-FOUND TO TRUE
018700     EXEC SQL
018800         SELECT CLAIM_ID, POLICY_NO, PRODUCT_CD, PERIL_CD
018900                , LOSS_DT, NOTIFIED_TS
019000           INTO :CLM-CLAIM-ID, :CLM-POLICY-NO
019100                , :CLM-PRODUCT-CD, :CLM-PERIL-CD
019200                , :CLM-LOSS-DT, :CLM-NOTIFIED-TS
019300           FROM CLR.T_CLAIM
019400          WHERE CLAIM_ID = :CLM-CLAIM-ID
019500     END-EXEC
019600     EVALUATE SQLCODE
019700        WHEN 0
019800           ADD 1 TO WS-CLAIM-READ
019900        WHEN +100
020000           SET WS-ROW-NOT-FOUND TO TRUE
020100        WHEN OTHER
020200           MOVE 'READ CLR.T_CLAIM' TO ERR-PARA
020300           PERFORM 8000-SQL-ERROR
020400     END-EVALUATE
020500     .
020600 2300-READ-CLAIM-EXIT.
020700     EXIT.
