010400         SELECT LINK_ID, CLAIM_ID_A, CLAIM_ID_B, LINK_TYPE_CD
010500                , DETECTED_DT
010600           FROM CLR.T_CLAIM_LINK
010700          WHERE LAST_UPD_TS >= :WS-LAST-RUN-TS
010800          ORDER BY LINK_ID
010900          FOR FETCH ONLY
011000     END-EXEC.
