014000         GOBACK
014100     END-IF
014200     MOVE WS-RUN-DATE TO RH1-RUN-DATE
014300     WRITE REPORT-RECORD FROM WS-RPT-HEAD-1
014400     .
014500* --- 2000-PROCESS-RUN: SINGLE-PASS PROCESSING
014600 2000-PROCESS-RUN.
014700     PERFORM 2300-READ-CURRENCY-RATE
014800     PERFORM 2500-EDIT-CURRENCY-RATE
014900     PERFORM 4100-UPDATE-GL-PERIOD
015000     PERFORM 4900-WRITE-AUDIT
015100     .
015200* --- 2300-READ-CURRENCY-RATE: FETCH CLR.T_CURRENCY_RATE
015300 2300-READ-CURRENCY-RATE.
015400     MOVE WS-RUN-DATE TO CURR-RATE-DT
015500     SET WS-ROW-FOUND TO TRUE
015600     EXEC SQL
015700         SELECT CURRENCY_CD, RATE_DT, RATE_TO_GBP
015800           INTO :CURR-CURRENCY-CD, :CURR-RATE-DT
015900                , :CURR-RATE-TO-GBP
016000           FROM CLR.T_CURRENCY_RATE
016100          WHERE CURRENCY_CD = :CURR-CURRENCY-CD
016200            AND RATE_DT = :CURR-RATE-DT
016300     END-EXEC
016400     EVALUATE SQLCODE
016500         WHEN 0
016600             ADD 1 TO WS-CURRENCY-RATE-READ
016700         WHEN +100
016800             SET WS-ROW-NOT-FOUND TO TRUE
016900         WHEN OTHER
017000             MOVE 'READ CLR.T_CURRENCY_RATE' TO ERR-PARA
017100             PERFORM 8000-SQL-ERROR
017200     END-EVALUATE
017300     .
017400* --- 2500-EDIT-CURRENCY-RATE: FIELD EDITS FOR CLR.T_CURRENCY_RATE
017500 2500-EDIT-CURRENCY-RATE.
017600     IF CURR-CURRENCY-CD = SPACES OR LOW-VALUES
017700         ADD 1 TO WS-REJECT-CNT
017800         MOVE 'CURRENCY_CD MISSING' TO ERR-TEXT
017900     END-IF
018000     IF CURR-RATE-DT NOT = SPACES AND CURR-RATE-DT(5:1) NOT = '-'
018100         MOVE 'RATE_DT BAD DATE' TO ERR-TEXT
018200         ADD 1 TO WS-REJECT-CNT
018300     END-IF
018400     IF CURR-RATE-TO-GBP NOT NUMERIC
018500         MOVE ZERO TO CURR-RATE-TO-GBP
018600         ADD 1 TO WS-REJECT-CNT
018700     END-IF
018800     .
018900* --- 4100-UPDATE-GL-PERIOD: UPDATE CLR.T_GL_PERIOD
019000 4100-UPDATE-GL-PERIOD.
019100     EXEC SQL
019200         UPDATE CLR.T_GL_PERIOD
019300            SET PERIOD_STATUS = 'C'
019400              , CLOSED_TS = CURRENT TIMESTAMP
019500              , CLOSED_BY = :GLPE-CLOSED-BY
019600              , LAST_UPD_TS = CURRENT TIMESTAMP
019700              , LAST_UPD_PGM = :WS-PGM-ID
019800              , LAST_UPD_USER = :WS-USER-ID
019900          WHERE GL_PERIOD = :GLPE-GL-PERIOD
020000     END-EXEC
020100     EVALUATE SQLCODE
020200         WHEN 0
020300             ADD 1 TO WS-GL-PERIOD-WRITTEN
020400         WHEN +100
020500             SET WS-ROW-NOT-FOUND TO TRUE
020600         WHEN OTHER
020700             MOVE 'UPDATE CLR.T_GL_PERIOD' TO ERR-PARA
020800             PERFORM 8000-SQL-ERROR
020900     END-EVALUATE
021000     .
021100* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
021200 4900-WRITE-AUDIT.
021300     MOVE 'CLR.T_GL_PERIOD' TO WS-AUD-TABLE
021400     MOVE SPACES TO WS-AUD-KEY
021500     MOVE 'A' TO WS-AUD-ACTION
021600     MOVE WS-USER-ID TO WS-AUD-USER
021700     MOVE WS-PGM-ID TO WS-AUD-PGM
021800     CALL 'CLRCM020' USING WS-AUDIT-PARMS
021900                      CLR-ERROR-BLOCK
022000     IF ERR-SQLCODE NOT = ZERO
022100         ADD 1 TO WS-REJECT-CNT
022200     END-IF
022300     .
022400* --- 9000-TERMINATE: CLOSE DOWN
022500 9000-TERMINATE.
022600     PERFORM 7010-LIST-CURRENCY-RATE
022700     EXEC SQL
022800         COMMIT
022900     END-EXEC
023000     MOVE 'CLR.T_CURRENCY_RATE ROWS READ' TO RT-LABEL
023100     MOVE WS-CURRENCY-RATE-READ TO RT-COUNT
023200     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
023300     MOVE 'CLR.T_GL_PERIOD ROWS WRITTEN' TO RT-LABEL
023400     MOVE WS-GL-PERIOD-WRITTEN TO RT-COUNT
023500     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
023600     CLOSE REPORT-FILE
023700     IF WS-REJECT-CNT > ZERO
023800         MOVE 4 TO RETURN-CODE
023900     END-IF
024000     .
024100* --- 7010-LIST-CURRENCY-RATE: LIST CLR.T_CURRENCY_RATE FIELDS ON
024200 7010-LIST-CURRENCY-RATE.
024300     MOVE 'LAST CLR.T_CURRENCY_RATE ROW' TO RD-LABEL
024400     MOVE SPACES TO RD-VALUE
024500     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
024600     MOVE '  CURRENCY_CD' TO RD-LABEL
024700     MOVE CURR-CURRENCY-CD TO RD-VALUE
024800     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
024900     MOVE '  RATE_DT' TO RD-LABEL
025000     MOVE CURR-RATE-DT TO RD-VALUE
025100     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
025200     MOVE '  RATE_TYPE_CD' TO RD-LABEL
025300     MOVE CURR-RATE-TYPE-CD TO RD-VALUE
025400     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
025500     MOVE '  ARCHIVE_FLAG' TO RD-LABEL
025600     MOVE CURR-ARCHIVE-FLAG TO RD-VALUE
025700     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
025800     MOVE '  COMMENT_TXT' TO RD-LABEL
025900     MOVE CURR-COMMENT-TXT TO RD-VALUE
026000     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
026100     MOVE '  CREATED_TS' TO RD-LABEL
026200     MOVE CURR-CREATED-TS TO RD-VALUE
026300     WRITE REPORT-RECORD FROM WS-RPT-DETAIL
026400     .
