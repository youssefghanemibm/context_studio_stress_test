054200* --- 8500-LOG-RUN: RECORD THE RUN IN CLR.T_INTERFACE_LOG
054300 8500-LOG-RUN.
054400     MOVE WS-RUN-ID TO IFLO-IF-RUN-ID IFLO-BATCH-RUN-ID
054500     MOVE 'CLX-IF-042' TO IFLO-INTERFACE-ID
054600     MOVE WS-PUT-COUNT TO IFLO-RECORD-COUNT
054700     MOVE WS-HASH-TOTAL TO IFLO-HASH-TOTAL
054800     MOVE 'OK' TO IFLO-RUN-STATUS
054900     MOVE 'UK' TO IFLO-BRANCH-CD
055000     MOVE SPACES TO IFLO-COMMENT-TXT
055100     EXEC SQL
055200         INSERT INTO CLR.T_INTERFACE_LOG
055300              ( IF_RUN_ID, INTERFACE_ID, RUN_TS, RECORD_COUNT
055400              , HASH_TOTAL, RUN_STATUS, BATCH_RUN_ID, BRANCH_CD
055500              , COMMENT_TXT, LAST_UPD_TS, LAST_UPD_PGM
055600              , LAST_UPD_USER )
055700         VALUES
055800              ( :IFLO-IF-RUN-ID, :IFLO-INTERFACE-ID
055900              , CURRENT TIMESTAMP, :IFLO-RECORD-COUNT
056000              , :IFLO-HASH-TOTAL, :IFLO-RUN-STATUS
056100              , :IFLO-BATCH-RUN-ID, :IFLO-BRANCH-CD
056200              , :IFLO-COMMENT-TXT, CURRENT TIMESTAMP
056300              , :WS-PGM-ID, :WS-USER-ID )
056400     END-EXEC
056500     EVALUATE SQLCODE
056600         WHEN 0
056700             ADD 1 TO WS-INTERFACE-LOG-WRITTEN
056800         WHEN +100
056900             SET WS-ROW-NOT-FOUND TO TRUE
057000         WHEN OTHER
057100             MOVE '8500-LOG-RUN' TO ERR-PARA
057200             PERFORM 8000-SQL-ERROR
057300     END-EVALUATE
057400     .
057500 8500-LOG-RUN-EXIT.
