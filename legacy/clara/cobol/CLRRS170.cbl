011700* DRIVING CURSOR ON CLR.T_RESERVE_MOVEMENT
011800     EXEC SQL
011900         DECLARE C-RESE-MOVE CURSOR WITH HOLD FOR
012000         SELECT M.MOVE_ID, M.RSV_ID, M.CLAIM_ID, M.MOVE_TYPE_CD,
012100                M.MOVE_AMT, M.MOVE_GBP_AMT, M.MOVE_TS,
012200                C.PRODUCT_CD, C.PERIL_CD, C.TIER_CD, C.CURRENCY_CD
012300           FROM CLR.T_RESERVE_MOVEMENT M
012400           JOIN CLR.T_CLAIM C
012500             ON C.CLAIM_ID = M.CLAIM_ID
012600          WHERE M.EXTRACTED_FLAG = 'N'
012700          ORDER BY M.MOVE_ID
012800          FOR FETCH ONLY
012900     END-EXEC.
