058000     MOVE WS-PGM-ID TO ERR-PGM
058100     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
058200         ERR-TEXT
058300     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
058400     EXEC SQL
058500         ROLLBACK
058600     END-EXEC
058700     MOVE 16 TO RETURN-CODE
058800     CLOSE REPORT-FILE
058900     CLOSE RSVOUT-FILE
059000     GOBACK.
059100 8000-SQL-ERROR-EXIT.
059200     EXIT.
