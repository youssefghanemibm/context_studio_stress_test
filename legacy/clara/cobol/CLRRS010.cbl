018000 PROCEDURE DIVISION.
018100* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
018200 0000-MAIN.
018300     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
018400     IF EIBCALEN = ZERO
018500        INITIALIZE CLR-COMMAREA
018600        MOVE 'RS01' TO CA-TRANID
018700        PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
018800     ELSE
018900        MOVE DFHCOMMAREA TO CLR-COMMAREA
019000        PERFORM 2000-PROCESS-INPUT THRU 2000-PROCESS-INPUT-EXIT
019100     END-IF
019200     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
019300     GOBACK.
019400 0000-MAIN-EXIT.
019500     EXIT.
019600* --- 1000-FIRST-TIME: SEND THE EMPTY SCREEN
019700 1000-FIRST-TIME.
019800     MOVE LOW-VALUES TO CLRM310O
019900     EXEC CICS SEND MAP('CLRM310') MAPSET('CLRMS04')
020000        ERASE FREEKB RESP(WS-RESP) END-EXEC
020100     .
020200 1000-FIRST-TIME-EXIT.
020300     EXIT.
020400* --- 2000-PROCESS-INPUT: PROCESS THE REQUEST
020500 2000-PROCESS-INPUT.
020600     EXEC CICS RECEIVE MAP('CLRM310') MAPSET('CLRMS04')
020700        INTO(CLRM310I) RESP(WS-RESP) END-EXEC
020800     EVALUATE TRUE
020900        WHEN EIBAID = AID-PF3
021000        WHEN EIBAID = AID-CLEAR
021100           MOVE ZERO TO CA-RETURN-CD
021200           EXEC CICS RETURN END-EXEC
021300        WHEN EIBAID = AID-PF12
021400           PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
021500        WHEN EIBAID = AID-ENTER
021600           PERFORM 2100-EDIT-INPUT THRU 2100-EDIT-INPUT-EXIT
021700           IF WS-NO-ERROR
021800              PERFORM 2200-APPLY THRU 2200-APPLY-EXIT
021900           END-IF
022000        WHEN OTHER
022100           MOVE 'INVALID KEY PRESSED' TO MSGO
022200     END-EVALUATE
022300     EXEC CICS SEND MAP('CLRM310') MAPSET('CLRMS04')
022400        DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
022500     .
022600 2000-PROCESS-INPUT-EXIT.
022700     EXIT.
022800* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
022900 2100-EDIT-INPUT.
023000     SET WS-NO-ERROR TO TRUE
023100     IF CLAIMIDL = ZERO OR CLAIMIDI = SPACES
023200        SET WS-ERROR-FOUND TO TRUE
023300        MOVE WS-MSG-01 TO MSGO
023400        MOVE -1 TO CLAIMIDL
023500     ELSE
023600        MOVE CLAIMIDI TO CA-CLAIM-ID
023700     END-IF
023800     PERFORM 1200-CHECK-PARAMETERS THRU 1200-CHECK-PARAMETERS-EXIT
023900     PERFORM 1300-GET-PARAMETERS THRU 1300-GET-PARAMETERS-EXIT
024000     PERFORM 1500-CHECK-AUTHORITY THRU 1500-CHECK-AUTHORITY-EXIT
024100     .
024200 2100-EDIT-INPUT-EXIT.
024300     EXIT.
024400* --- 1200-CHECK-PARAMETERS: PARAMETER TABLE SANITY CHECK
024500 1200-CHECK-PARAMETERS.
024600     EXEC SQL
024700         SELECT COUNT(*)
024800           INTO :WS-PARM-ROWS
024900           FROM CLR.T_PARAM
025000          WHERE PARAM_KEY LIKE 'RSV_%'
025100            AND VALID_FROM <= CURRENT DATE
025200            AND (VALID_TO IS NULL OR VALID_TO >= CURRENT DATE)
025300     END-EXEC
025400     EVALUATE SQLCODE
025500        WHEN 0
025600           CONTINUE
025700        WHEN OTHER
025800           MOVE '1200-CHECK-PARAMETERS' TO ERR-PARA
025900           PERFORM 8000-SQL-ERROR
026000     END-EVALUATE
026100     IF WS-PARM-ROWS = ZERO
026200        DISPLAY WS-PGM-ID ' NO CURRENT PARAMETERS FOUND'
026300        SET WS-ERROR-FOUND TO TRUE
026400     END-IF
026500     .
026600 1200-CHECK-PARAMETERS-EXIT.
026700     EXIT.
026800* --- 1300-GET-PARAMETERS: READ BUSINESS PARAMETERS VIA CLRCM040
026900 1300-GET-PARAMETERS.
027000     MOVE 'RSV_LLNT_GBP' TO PARM-PARAM-KEY
027100     CALL 'CLRCM040' USING PARMREC1-REC
027200                      CLR-ERROR-BLOCK
027300     IF ERR-SQLCODE NOT = ZERO
027400        MOVE 'CALL CLRCM040' TO ERR-PARA
027500        PERFORM 8000-SQL-ERROR
027600     END-IF
027700     MOVE FUNCTION NUMVAL(PARM-PARAM-VALUE) TO WS-LLNT-GBP
027800     .
027900 1300-GET-PARAMETERS-EXIT.
028000     EXIT.
028100* --- 1500-CHECK-AUTHORITY: CONFIRM THE USER MAY RUN THIS FUNCTION
028200 1500-CHECK-AUTHORITY.
028300     MOVE WS-USER-ID TO WS-AUTH-USER
028400     MOVE 'CLRRS010' TO WS-AUTH-FUNCTION
028500     CALL 'CLRCM070' USING WS-AUTH-PARMS
028600                      CLR-ERROR-BLOCK
028700     IF ERR-SQLCODE NOT = ZERO
028800        MOVE 'CALL CLRCM070' TO ERR-PARA
028900        PERFORM 8000-SQL-ERROR
029000     END-IF
029100     IF WS-AUTH-ALLOWED NOT = 'Y'
029200        SET WS-ERROR-FOUND TO TRUE
029300        MOVE 8 TO CA-RETURN-CD
029400        MOVE 'NOT AUTHORISED FOR THIS FUNCTION' TO CA-MSG
029500     END-IF
029600     .
029700 1500-CHECK-AUTHORITY-EXIT.
029800     EXIT.
029900* --- 2200-APPLY: APPLY THE CHANGE
030000 2200-APPLY.
030100     PERFORM 2300-READ-CLAIM THRU 2300-READ-CLAIM-EXIT
030200     PERFORM 2320-READ-CURRENCY-RATE THRU
030300         2320-READ-CURRENCY-RATE-EXIT
030400     PERFORM 3000-SET-INITIAL-RESERVE THRU
030500         3000-SET-INITIAL-RESERVE-EXIT
030600     IF WS-NO-ERROR
030700        EXEC CICS SYNCPOINT END-EXEC
030800        MOVE ZERO TO CA-RETURN-CD
030900     END-IF
031000     .
031100 2200-APPLY-EXIT.
031200     EXIT.
031300* --- 2300-READ-CLAIM: READ CLR.T_CLAIM
031400 2300-READ-CLAIM.
031500     MOVE CA-CLAIM-ID TO CLM-CLAIM-ID
031600     SET WS-ROW-FOUND TO TRUE
031700     EXEC SQL
031800         SELECT CLAIM_ID, POLICY_NO, PRODUCT_CD
031900           INTO :CLM-CLAIM-ID, :CLM-POLICY-NO
032000                , :CLM-PRODUCT-CD
032100           FROM CLR.T_CLAIM
032200          WHERE CLAIM_ID = :CLM-CLAIM-ID
032300     END-EXEC
032400     EVALUATE SQLCODE
032500        WHEN 0
032600           ADD 1 TO WS-CLAIM-READ
032700        WHEN +100
032800           SET WS-ROW-NOT-FOUND TO TRUE
032900        WHEN OTHER
033000           MOVE 'READ CLR.T_CLAIM' TO ERR-PARA
033100           PERFORM 8000-SQL-ERROR
033200     END-EVALUATE
033300     .
033400 2300-READ-CLAIM-EXIT.
033500     EXIT.
033600* --- 2320-READ-CURRENCY-RATE: LOOK UP CLR.T_CURRENCY_RATE
033700 2320-READ-CURRENCY-RATE.
033800     MOVE CLM-CURRENCY-CD TO CURR-CURRENCY-CD
033900     MOVE WS-RUN-DATE TO CURR-RATE-DT
034000     SET WS-ROW-FOUND TO TRUE
034100     EXEC SQL
034200         SELECT CURRENCY_CD, RATE_DT, RATE_TO_GBP
034300           INTO :CURR-CURRENCY-CD, :CURR-RATE-DT
034400                , :CURR-RATE-TO-GBP
034500           FROM CLR.T_CURRENCY_RATE
034600          WHERE CURRENCY_CD = :CURR-CURRENCY-CD
034700            AND RATE_DT = :CURR-RATE-DT
034800     END-EXEC
034900     EVALUATE SQLCODE
035000        WHEN 0
035100           ADD 1 TO WS-CURRENCY-RATE-READ
035200        WHEN +100
035300           SET WS-ROW-NOT-FOUND TO TRUE
035400        WHEN OTHER
035500           MOVE 'READ CLR.T_CURRENCY_RATE' TO ERR-PARA
035600           PERFORM 8000-SQL-ERROR
035700     END-EVALUATE
035800     .
035900 2320-READ-CURRENCY-RATE-EXIT.
036000     EXIT.
036100* --- 3000-SET-INITIAL-RESERVE: SET THE INITIAL RESERVE
036200 3000-SET-INITIAL-RESERVE.
036300* INITIAL RESERVE: AUTHORITY CHECK (CLRRS015), GBP EQUIVALENT
036400* (CLRCM030), INSERT, IN MOVEMENT, AUDIT (CLRCM020).
036500     MOVE WS-USER-ID TO WS-RA-USER
036600     MOVE CLM-CURRENCY-CD TO WS-RA-CURRENCY RSV-CURRENCY-CD
036700     COMPUTE WS-RA-AMOUNT = FUNCTION NUMVAL(RSVAMTI)
036800     CALL 'CLRRS015' USING WS-RSVAUTH-PARMS
036900                      CLR-ERROR-BLOCK
037000     IF ERR-SQLCODE NOT = ZERO
037100        MOVE 'CALL CLRRS015' TO ERR-PARA
037200        PERFORM 8000-SQL-ERROR
037300     END-IF
037400     IF WS-RA-RESULT NOT = 'Y'
037500        SET WS-ERROR-FOUND TO TRUE
037600        MOVE 'AMOUNT ABOVE YOUR RESERVE AUTHORITY' TO MSGO
037700     ELSE
037800        MOVE CLM-CURRENCY-CD TO WS-CCY-FROM
037900        MOVE WS-RA-AMOUNT TO WS-CCY-AMOUNT
038000        MOVE WS-RUN-DATE TO WS-CCY-RATE-DT
038100        CALL 'CLRCM030' USING WS-CCY-PARMS
038200                         CLR-ERROR-BLOCK
038300        IF ERR-SQLCODE NOT = ZERO
038400           MOVE 'CALL CLRCM030' TO ERR-PARA
038500           PERFORM 8000-SQL-ERROR
038600        END-IF
038700        PERFORM 3100-INSERT-RESERVE THRU 3100-INSERT-RESERVE-EXIT
038800     END-IF
038900     .
039000 3000-SET-INITIAL-RESERVE-EXIT.
039100     EXIT.
039200* --- 9000-RETURN: RETURN TO CICS
039300 9000-RETURN.
039400     EXEC CICS RETURN TRANSID('RS01') COMMAREA(CLR-COMMAREA)
039500        LENGTH(LENGTH OF CLR-COMMAREA) END-EXEC
039600     .
039700 9000-RETURN-EXIT.
039800     EXIT.
039900* --- 3100-INSERT-RESERVE: INSERT THE RESERVE ROW
040000 3100-INSERT-RESERVE.
040100     MOVE CA-CLAIM-ID TO RSV-CLAIM-ID
040200     MOVE RSVTYPEI TO RSV-RSV-TYPE-CD
040300     MOVE WS-RA-AMOUNT TO RSV-RSV-INITIAL-AMT
040400         RSV-RSV-OUTSTANDING-AMT
040500     MOVE WS-CCY-GBP-AMOUNT TO RSV-RSV-GBP-EQUIV-AMT
040600     MOVE 'O' TO RSV-RSV-STATUS
040700     MOVE WS-RA-REQUIRED-LVL TO RSV-RSV-AUTH-LEVEL
040800     MOVE WS-USER-ID TO RSV-RSV-SET-BY-USER
040900     EXEC SQL
041000         INSERT INTO CLR.T_RESERVE
041100              ( CLAIM_ID, RSV_TYPE_CD, CURRENCY_CD
041200              , RSV_INITIAL_AMT, RSV_OUTSTANDING_AMT
041300              , RSV_PAID_TO_DATE_AMT, RSV_RECOVERY_EST_AMT
041400              , RSV_GBP_EQUIV_AMT, RSV_STATUS, RSV_AUTH_LEVEL
041500              , RSV_SET_BY_USER, RSV_NEXT_REVIEW_DT
041600              , RSV_INDEX_FACTOR, RSV_LAST_REVAL_DT
041700              , LAST_UPD_TS, LAST_UPD_PGM, LAST_UPD_USER )
041800         VALUES
041900              ( :RSV-CLAIM-ID, :RSV-RSV-TYPE-CD
042000              , :RSV-CURRENCY-CD, :RSV-RSV-INITIAL-AMT
042100              , :RSV-RSV-OUTSTANDING-AMT
042200              , :RSV-RSV-PAID-TO-DATE-AMT
042300              , :RSV-RSV-RECOVERY-EST-AMT
042400              , :RSV-RSV-GBP-EQUIV-AMT, :RSV-RSV-STATUS
042500              , :RSV-RSV-AUTH-LEVEL, :RSV-RSV-SET-BY-USER
042600              , :RSV-RSV-NEXT-REVIEW-DT, :RSV-RSV-INDEX-FACTOR
042700              , :RSV-RSV-LAST-REVAL-DT, CURRENT TIMESTAMP
042800              , :WS-PGM-ID, :WS-USER-ID )
042900     END-EXEC
043000     EVALUATE SQLCODE
043100        WHEN 0
043200           ADD 1 TO WS-RESERVE-WRITTEN
043300        WHEN +100
043400           SET WS-ROW-NOT-FOUND TO TRUE
043500        WHEN OTHER
043600           MOVE '3100-INSERT-RESERVE' TO ERR-PARA
043700           PERFORM 8000-SQL-ERROR
043800     END-EVALUATE
043900     EXEC SQL
044000         VALUES IDENTITY_VAL_LOCAL() INTO :RSV-RSV-ID
044100     END-EXEC
044200     MOVE WS-CCY-GBP-AMOUNT TO RSVM-MOVE-GBP-AMT
044300     MOVE RSV-RSV-ID TO RSVM-RSV-ID
044400     MOVE CA-CLAIM-ID TO RSVM-CLAIM-ID
044500     MOVE 'IN' TO RSVM-MOVE-TYPE-CD
044600     MOVE WS-RA-AMOUNT TO RSVM-MOVE-AMT
044700     MOVE 'INIT' TO RSVM-REASON-CD
044800     MOVE 'N' TO RSVM-EXTRACTED-FLAG
044900     MOVE WS-USER-ID TO RSVM-USER-ID
045000     MOVE WS-PGM-ID TO RSVM-PGM-ID
045100     EXEC SQL
045200         INSERT INTO CLR.T_RESERVE_MOVEMENT
045300              ( RSV_ID, CLAIM_ID, MOVE_TS, MOVE_TYPE_CD
045400              , MOVE_AMT, MOVE_GBP_AMT, REASON_CD, USER_ID
045500              , PGM_ID, EXTRACTED_FLAG )
045600         VALUES
045700              ( :RSVM-RSV-ID, :RSVM-CLAIM-ID, CURRENT TIMESTAMP
045800              , :RSVM-MOVE-TYPE-CD, :RSVM-MOVE-AMT
045900              , :RSVM-MOVE-GBP-AMT, :RSVM-REASON-CD
046000              , :RSVM-USER-ID, :RSVM-PGM-ID
046100              , :RSVM-EXTRACTED-FLAG )
046200     END-EXEC
046300     EVALUATE SQLCODE
046400        WHEN 0
046500           ADD 1 TO WS-RESERVE-MOVEMENT-WRITTEN
046600        WHEN +100
046700           SET WS-ROW-NOT-FOUND TO TRUE
046800        WHEN OTHER
046900           MOVE 'INSERT MOVEMENT IN' TO ERR-PARA
047000           PERFORM 8000-SQL-ERROR
047100     END-EVALUATE
047200     IF WS-CCY-GBP-AMOUNT >= WS-LLNT-GBP
047300        MOVE 'RESERVE SET - LARGE LOSS LEVEL REACHED' TO MSGO
047400     END-IF
047500     MOVE 'CLR.T_RESERVE' TO WS-AUD-TABLE
047600     MOVE CA-CLAIM-ID TO WS-AUD-KEY
047700     MOVE 'U' TO WS-AUD-ACTION
047800     MOVE WS-USER-ID TO WS-AUD-USER
047900     MOVE WS-PGM-ID TO WS-AUD-PGM
048000     CALL 'CLRCM020' USING WS-AUDIT-PARMS
