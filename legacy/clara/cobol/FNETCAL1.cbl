010500* ---------------------------------------------------------------*
010600* 0000-MAIN                                                      *
010700* PSEUDO-CONVERSATIONAL CONTROL                                  *
010800* ---------------------------------------------------------------*
010900 0000-MAIN.
011000     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
011100     IF EIBCALEN = ZERO
011200         INITIALIZE CLR-COMMAREA
011300         MOVE 'FR02' TO CA-TRANID
011400         MOVE 12 TO CA-RETURN-CD
011500         MOVE 'NO COMMAREA SUPPLIED' TO CA-MSG
011600         PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
011700     ELSE
011800         MOVE DFHCOMMAREA TO CLR-COMMAREA
011900         PERFORM 2000-PROCESS-INPUT THRU 2000-PROCESS-INPUT-EXIT
012000     END-IF
012100     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
012200     GOBACK.
012300 0000-MAIN-EXIT.
012400     EXIT.
012500* ---------------------------------------------------------------*
012600* 2000-PROCESS-INPUT                                             *
012700* PROCESS THE REQUEST                                            *
012800* ---------------------------------------------------------------*
012900 2000-PROCESS-INPUT.
013000     PERFORM 2100-EDIT-INPUT THRU 2100-EDIT-INPUT-EXIT
013100     IF WS-NO-ERROR
013200         PERFORM 2200-APPLY THRU 2200-APPLY-EXIT
013300     END-IF
013400     .
013500 2000-PROCESS-INPUT-EXIT.
013600     EXIT.
013700* ---------------------------------------------------------------*
013800* 2100-EDIT-INPUT                                                *
013900* VALIDATE THE REQUEST                                           *
014000* ---------------------------------------------------------------*
014100 2100-EDIT-INPUT.
014200     SET WS-NO-ERROR TO TRUE
014300     IF CA-CLAIM-ID = SPACES OR LOW-VALUES
014400         SET WS-ERROR-FOUND TO TRUE
014500         MOVE 8 TO CA-RETURN-CD
014600         MOVE 'CLAIM ID IS REQUIRED' TO CA-MSG
014700     END-IF
014800     PERFORM 1500-CHECK-AUTHORITY THRU 1500-CHECK-AUTHORITY-EXIT
014900     .
015000 2100-EDIT-INPUT-EXIT.
015100     EXIT.
015200* ---------------------------------------------------------------*
015300* 1500-CHECK-AUTHORITY                                           *
015400* CONFIRM THE USER MAY RUN THIS FUNCTION                         *
015500* ---------------------------------------------------------------*
015600 1500-CHECK-AUTHORITY.
015700     MOVE WS-USER-ID TO WS-AUTH-USER
015800     MOVE 'CLRFR020' TO WS-AUTH-FUNCTION
015900     CALL 'CLRCM070' USING WS-AUTH-PARMS
016000                      CLR-ERROR-BLOCK
016100     IF ERR-SQLCODE NOT = ZERO
016200         MOVE 'CALL CLRCM070' TO ERR-PARA
016300         PERFORM 8000-SQL-ERROR
016400     END-IF
016500     IF WS-AUTH-ALLOWED NOT = 'Y'
016600         SET WS-ERROR-FOUND TO TRUE
016700         MOVE 8 TO CA-RETURN-CD
016800         MOVE 'NOT AUTHORISED FOR THIS FUNCTION' TO CA-MSG
016900     END-IF
017000     .
017100 1500-CHECK-AUTHORITY-EXIT.
017200     EXIT.
017300* ---------------------------------------------------------------*
