017500* APPLY THE CHANGE                                               *
017600* ---------------------------------------------------------------*
017700 2200-APPLY.
017800     PERFORM 2300-READ-CLAIM-LINK THRU 2300-READ-CLAIM-LINK-EXIT
017900     PERFORM 2500-EDIT-CLAIM-LINK THRU 2500-EDIT-CLAIM-LINK-EXIT
018000     PERFORM 2510-EDIT-FRAUD-SCORE THRU 2510-EDIT-FRAUD-SCORE-EXIT
018100     PERFORM 2520-EDIT-CLAIM-LINK-2 THRU
018200         2520-EDIT-CLAIM-LINK-2-EXIT
018300     PERFORM 2530-EDIT-FRAUD-SCORE-2 THRU
018400         2530-EDIT-FRAUD-SCORE-2-EXIT
018500     PERFORM 2540-EDIT-FRAUD-SCORE-3 THRU
018600         2540-EDIT-FRAUD-SCORE-3-EXIT
018700     PERFORM 3000-REQUEST-SCORE THRU 3000-REQUEST-SCORE-EXIT
018800     PERFORM 4100-INSERT-FRAUD-SCORE THRU
018900         4100-INSERT-FRAUD-SCORE-EXIT
019000     IF WS-NO-ERROR
019100         EXEC CICS SYNCPOINT END-EXEC
019200         MOVE ZERO TO CA-RETURN-CD
019300     END-IF
019400     .
019500 2200-APPLY-EXIT.
019600     EXIT.
019700* ---------------------------------------------------------------*
019800* 2300-READ-CLAIM-LINK                                           *
019900* LOOK UP CLR.T_CLAIM_LINK                                       *
020000* ---------------------------------------------------------------*
020100 2300-READ-CLAIM-LINK.
020200     SET WS-ROW-FOUND TO TRUE
020300     EXEC SQL
020400         SELECT LINK_ID, CLAIM_ID_A, CLAIM_ID_B, LINK_TYPE_CD
020500                , DETECTED_DT
020600           INTO :FRDL-LINK-ID, :FRDL-CLAIM-ID-A
020700                , :FRDL-CLAIM-ID-B, :FRDL-LINK-TYPE-CD
020800                , :FRDL-DETECTED-DT
020900           FROM CLR.T_CLAIM_LINK
021000          WHERE LINK_ID = :FRDL-LINK-ID
021100     END-EXEC
021200     EVALUATE SQLCODE
021300         WHEN 0
021400             ADD 1 TO WS-CLAIM-LINK-READ
021500         WHEN +100
021600             SET WS-ROW-NOT-FOUND TO TRUE
021700         WHEN OTHER
021800             MOVE 'READ CLR.T_CLAIM_LINK' TO ERR-PARA
021900             PERFORM 8000-SQL-ERROR
022000     END-EVALUATE
022100     .
022200 2300-READ-CLAIM-LINK-EXIT.
022300     EXIT.
022400* ---------------------------------------------------------------*
022500* 2500-EDIT-CLAIM-LINK                                           *
022600* FIELD EDITS FOR CLR.T_CLAIM_LINK                               *
022700* ---------------------------------------------------------------*
022800 2500-EDIT-CLAIM-LINK.
022900     IF FRDL-CLAIM-ID-A = SPACES OR LOW-VALUES
023000         ADD 1 TO WS-REJECT-CNT
023100         MOVE 'CLAIM_ID_A MISSING' TO ERR-TEXT
023200     END-IF
023300     IF FRDL-CLAIM-ID-B = SPACES OR LOW-VALUES
023400         ADD 1 TO WS-REJECT-CNT
023500         MOVE 'CLAIM_ID_B MISSING' TO ERR-TEXT
023600     END-IF
023700     IF FRDL-LINK-TYPE-CD NOT = 'PH' AND FRDL-LINK-TYPE-CD NOT =
023800         'BA' AND FRDL-LINK-TYPE-CD NOT = 'VH' AND
023900         FRDL-LINK-TYPE-CD NOT = 'AD'
024000         ADD 1 TO WS-REJECT-CNT
024100         MOVE 'LINK_TYPE_CD INVALID' TO ERR-TEXT
024200     END-IF
024300     .
024400 2500-EDIT-CLAIM-LINK-EXIT.
024500     EXIT.
024600* ---------------------------------------------------------------*
024700* 2510-EDIT-FRAUD-SCORE                                          *
024800* VALIDATE CLR.T_FRAUD_SCORE                                     *
024900* ---------------------------------------------------------------*
025000 2510-EDIT-FRAUD-SCORE.
025100     IF FRDS-CLAIM-ID = SPACES OR LOW-VALUES
025200         ADD 1 TO WS-REJECT-CNT
025300         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
025400     END-IF
025500     IF FRDS-SCORE NOT NUMERIC
025600         MOVE ZERO TO FRDS-SCORE
025700         ADD 1 TO WS-REJECT-CNT
025800     END-IF
025900     .
026000 2510-EDIT-FRAUD-SCORE-EXIT.
026100     EXIT.
026200* ---------------------------------------------------------------*
026300* 2520-EDIT-CLAIM-LINK-2                                         *
026400* VALIDATE CLR.T_CLAIM_LINK                                      *
026500* ---------------------------------------------------------------*
026600 2520-EDIT-CLAIM-LINK-2.
026700     IF FRDL-DETECTED-DT NOT = SPACES AND FRDL-DETECTED-DT(5:1)
026800         NOT = '-'
026900         MOVE 'DETECTED_DT BAD DATE' TO ERR-TEXT
027000         ADD 1 TO WS-REJECT-CNT
027100     END-IF
027200     IF FRDL-VERSION-NO NOT NUMERIC
027300         MOVE ZERO TO FRDL-VERSION-NO
027400         ADD 1 TO WS-REJECT-CNT
027500     END-IF
027600     .
027700 2520-EDIT-CLAIM-LINK-2-EXIT.
027800     EXIT.
027900* ---------------------------------------------------------------*
028000* 2530-EDIT-FRAUD-SCORE-2                                        *
028100* CHECK MANDATORY FIELDS IN CLR.T_FRAUD_SCORE                    *
028200* ---------------------------------------------------------------*
028300 2530-EDIT-FRAUD-SCORE-2.
028400     IF FRDS-MODEL-VERSION = SPACES OR LOW-VALUES
028500         ADD 1 TO WS-REJECT-CNT
028600         MOVE 'MODEL_VERSION MISSING' TO ERR-TEXT
028700     END-IF
028800     IF FRDS-TOP-REASON-1 = SPACES OR LOW-VALUES
028900         ADD 1 TO WS-REJECT-CNT
029000         MOVE 'TOP_REASON_1 MISSING' TO ERR-TEXT
029100     END-IF
029200     .
029300 2530-EDIT-FRAUD-SCORE-2-EXIT.
029400     EXIT.
029500* ---------------------------------------------------------------*
029600* 2540-EDIT-FRAUD-SCORE-3                                        *
029700* CHECK MANDATORY FIELDS IN CLR.T_FRAUD_SCORE                    *
029800* ---------------------------------------------------------------*
029900 2540-EDIT-FRAUD-SCORE-3.
030000 2540-EDIT-FRAUD-SCORE-3-EXIT.
030100     EXIT.
030200* ---------------------------------------------------------------*
030300* 3000-REQUEST-SCORE                                             *
030400* SENTINEL SCORE REQUEST                                         *
030500* ---------------------------------------------------------------*
030600 3000-REQUEST-SCORE.
030700* SYNCHRONOUS SCORE REQUEST (CLX-IF-008) OVER HTTPS THROUGH CICS
030800*   WEB.
030900     MOVE CA-CLAIM-ID TO SR-CLAIM-ID
031000     MOVE FRDL-CLAIM-ID-A TO SR-CLAIM-ID
031100     EXEC CICS WEB OPEN HOST(WS-SCORE-HOST) SCHEME(HTTPS)
031200         SESSTOKEN(WS-WEB-TOKEN) RESP(WS-RESP) END-EXEC
031300     IF WS-RESP NOT = DFHRESP(NORMAL)
031400         MOVE 12 TO CA-RETURN-CD
031500         MOVE 'SCORING SERVICE UNAVAILABLE' TO CA-MSG
031600         SET WS-ERROR-FOUND TO TRUE
031700     ELSE
031800         EXEC CICS WEB CONVERSE SESSTOKEN(WS-WEB-TOKEN) POST
031900             FROM(SENT-REQUEST)
032000             INTO(SENT-RESPONSE) TOLENGTH(WS-WEB-LEN)
032100             STATUSCODE(WS-WEB-STATUS) RESP(WS-RESP) END-EXEC
032200         EXEC CICS WEB CLOSE SESSTOKEN(WS-WEB-TOKEN) END-EXEC
032300         MOVE SS-CLAIM-ID TO FRDS-CLAIM-ID
032400         MOVE SS-SCORE TO FRDS-SCORE
032500         MOVE SS-MODEL-VERSION TO FRDS-MODEL-VERSION
032600         MOVE SS-REASON-1 TO FRDS-TOP-REASON-1
032700         MOVE SS-REASON-2 TO FRDS-TOP-REASON-2
032800     END-IF
032900     .
033000 3000-REQUEST-SCORE-EXIT.
033100     EXIT.
033200* ---------------------------------------------------------------*
033300* 4100-INSERT-FRAUD-SCORE                                        *
033400* INSERT CLR.T_FRAUD_SCORE                                       *
033500* ---------------------------------------------------------------*
033600 4100-INSERT-FRAUD-SCORE.
033700     MOVE CA-CLAIM-ID TO FRDS-CLAIM-ID
033800     EXEC SQL
033900         INSERT INTO CLR.T_FRAUD_SCORE
034000              ( CLAIM_ID, SCORE_TS, SCORE, MODEL_VERSION
034100              , TOP_REASON_1, TOP_REASON_2, SOURCE_SYS_CD
034200              , LAST_UPD_TS, LAST_UPD_PGM, LAST_UPD_USER )
034300         VALUES
034400              ( :FRDS-CLAIM-ID, CURRENT TIMESTAMP, :FRDS-SCORE
034500              , :FRDS-MODEL-VERSION, :FRDS-TOP-REASON-1
034600              , :FRDS-TOP-REASON-2, :FRDS-SOURCE-SYS-CD
034700              , CURRENT TIMESTAMP, :WS-PGM-ID, :WS-USER-ID )
034800     END-EXEC
034900     EVALUATE SQLCODE
035000         WHEN 0
035100             ADD 1 TO WS-FRAUD-SCORE-WRITTEN
035200         WHEN +100
035300             SET WS-ROW-NOT-FOUND TO TRUE
035400         WHEN OTHER
035500             MOVE 'INSERT CLR.T_FRAUD_SCORE' TO ERR-PARA
035600             PERFORM 8000-SQL-ERROR
035700     END-EVALUATE
035800     .
035900 4100-INSERT-FRAUD-SCORE-EXIT.
036000     EXIT.
036100* ---------------------------------------------------------------*
036200* 9000-RETURN                                                    *
036300* RETURN TO CICS                                                 *
036400* ---------------------------------------------------------------*
036500 9000-RETURN.
036600     MOVE CLR-COMMAREA TO DFHCOMMAREA
036700     EXEC CICS RETURN END-EXEC
036800     .
036900 9000-RETURN-EXIT.
037000     EXIT.
037100* ---------------------------------------------------------------*
037200* 8000-SQL-ERROR                                                 *
037300* SEVERE ERROR - REPORT AND STOP                                 *
037400* ---------------------------------------------------------------*
037500 8000-SQL-ERROR.
037600     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
037700     MOVE WS-PGM-ID TO ERR-PGM
037800     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
037900         ERR-TEXT
038000     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
038100     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
038200     MOVE 16 TO CA-RETURN-CD
038300     MOVE ERR-TEXT TO CA-MSG
038400     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
038500     .
038600 8000-SQL-ERROR-EXIT.
038700     EXIT.
