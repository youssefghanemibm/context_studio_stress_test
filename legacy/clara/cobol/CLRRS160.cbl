017000* ---------------------------------------------------------------*
017100 1200-CHECK-PARAMETERS.
017200     EXEC SQL
017300         SELECT COUNT(*)
017400           INTO :WS-PARM-ROWS
017500           FROM CLR.T_PARAM
017600          WHERE PARAM_KEY LIKE 'RSV_%'
017700            AND VALID_FROM <= CURRENT DATE
017800            AND (VALID_TO IS NULL OR VALID_TO >= CURRENT DATE)
017900     END-EXEC
018000     EVALUATE SQLCODE
018100         WHEN 0
018200             CONTINUE
018300         WHEN OTHER
