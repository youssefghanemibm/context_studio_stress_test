009800 PROCEDURE DIVISION.
009900* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
010000 0000-MAIN.
010100     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
010200     IF EIBCALEN = ZERO
010300         INITIALIZE CLR-COMMAREA
010400         MOVE 'ST09' TO CA-TRANID
010500         MOVE 12 TO CA-RETURN-CD
010600         MOVE 'NO COMMAREA SUPPLIED' TO CA-MSG
010700         PERFORM 9000-RETURN
010800     ELSE
010900         MOVE DFHCOMMAREA TO CLR-COMMAREA
011000         PERFORM 2000-PROCESS-INPUT
011100     END-IF
011200     PERFORM 9000-RETURN
011300     GOBACK.
011400* --- 2000-PROCESS-INPUT: PROCESS THE REQUEST
011500 2000-PROCESS-INPUT.
011600     PERFORM 2100-EDIT-INPUT
011700     IF WS-NO-ERROR
011800         PERFORM 2200-APPLY
011900     END-IF
012000     .
012100* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
012200 2100-EDIT-INPUT.
012300     SET WS-NO-ERROR TO TRUE
012400     IF CA-CLAIM-ID = SPACES OR LOW-VALUES
012500         SET WS-ERROR-FOUND TO TRUE
012600         MOVE 8 TO CA-RETURN-CD
012700         MOVE 'CLAIM ID IS REQUIRED' TO CA-MSG
012800     END-IF
012900     .
013000* --- 2200-APPLY: BUSINESS PROCESSING
013100 2200-APPLY.
013200     PERFORM 2300-READ-PAYEE
013300     PERFORM 2500-EDIT-PAYEE
013400     PERFORM 2510-EDIT-PAYMENT
013500     PERFORM 2520-EDIT-PAYEE-2
013600     PERFORM 2530-EDIT-PAYMENT-2
013700     PERFORM 2540-EDIT-PAYEE-3
013800     PERFORM 2550-EDIT-PAYMENT-3
013900     PERFORM 4100-UPDATE-PAYMENT
014000     PERFORM 4900-WRITE-AUDIT
014100     IF WS-NO-ERROR
014200         EXEC CICS SYNCPOINT END-EXEC
014300         MOVE ZERO TO CA-RETURN-CD
014400     END-IF
014500     .
014600* --- 2300-READ-PAYEE: FETCH CLR.T_PAYEE
014700 2300-READ-PAYEE.
014800     SET WS-ROW-FOUND TO TRUE
014900     EXEC SQL
015000         SELECT PAYEE_ID, PAYEE_NAME, IBAN, SORT_CODE
015100                , PAYEE_TYPE_CD, CREATED_TS
015200           INTO :PAYE-PAYEE-ID, :PAYE-PAYEE-NAME, :PAYE-IBAN
015300                , :PAYE-SORT-CODE, :PAYE-PAYEE-TYPE-CD
015400                , :PAYE-CREATED-TS
015500           FROM CLR.T_PAYEE
015600          WHERE PAYEE_ID = :PAYE-PAYEE-ID
015700     END-EXEC
015800     EVALUATE SQLCODE
015900         WHEN 0
016000             ADD 1 TO WS-PAYEE-READ
016100         WHEN +100
016200             SET WS-ROW-NOT-FOUND TO TRUE
016300         WHEN OTHER
016400             MOVE 'READ CLR.T_PAYEE' TO ERR-PARA
016500             PERFORM 8000-SQL-ERROR
016600     END-EVALUATE
016700     .
016800* --- 2500-EDIT-PAYEE: FIELD EDITS FOR CLR.T_PAYEE
016900 2500-EDIT-PAYEE.
017000     IF PAYE-PAYEE-ID = SPACES OR LOW-VALUES
017100         ADD 1 TO WS-REJECT-CNT
017200         MOVE 'PAYEE_ID MISSING' TO ERR-TEXT
017300     END-IF
017400     IF PAYE-PAYEE-NAME = SPACES OR LOW-VALUES
017500         ADD 1 TO WS-REJECT-CNT
017600         MOVE 'PAYEE_NAME MISSING' TO ERR-TEXT
017700     END-IF
017800     IF PAYE-IBAN = SPACES OR LOW-VALUES
017900         ADD 1 TO WS-REJECT-CNT
018000         MOVE 'IBAN MISSING' TO ERR-TEXT
018100     END-IF
018200     .
018300* --- 2510-EDIT-PAYMENT: VALIDATE CLR.T_PAYMENT
018400 2510-EDIT-PAYMENT.
018500     IF PAYR-CLAIM-ID = SPACES OR LOW-VALUES
018600         ADD 1 TO WS-REJECT-CNT
018700         MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
018800     END-IF
018900     IF PAYR-PAYEE-ID = SPACES OR LOW-VALUES
019000         ADD 1 TO WS-REJECT-CNT
019100         MOVE 'PAYEE_ID MISSING' TO ERR-TEXT
019200     END-IF
019300     IF PAYR-PAY-AMT NOT NUMERIC
019400         MOVE ZERO TO PAYR-PAY-AMT
019500         ADD 1 TO WS-REJECT-CNT
019600     END-IF
019700     .
019800* --- 2520-EDIT-PAYEE-2: VALIDATE CLR.T_PAYEE
019900 2520-EDIT-PAYEE-2.
020000     IF PAYE-PAYEE-TYPE-CD = SPACES OR LOW-VALUES
020100         ADD 1 TO WS-REJECT-CNT
020200         MOVE 'PAYEE_TYPE_CD MISSING' TO ERR-TEXT
020300     END-IF
020400     .
020500* --- 2530-EDIT-PAYMENT-2: CHECK MANDATORY FIELDS IN CLR.T_PAYMENT
020600 2530-EDIT-PAYMENT-2.
020700     IF PAYR-CURRENCY-CD = SPACES OR LOW-VALUES
020800         ADD 1 TO WS-REJECT-CNT
020900         MOVE 'CURRENCY_CD MISSING' TO ERR-TEXT
021000     END-IF
021100     IF PAYR-PAY-STATUS NOT = 'RQ' AND PAYR-PAY-STATUS NOT = 'SC'
021200         AND PAYR-PAY-STATUS NOT = 'SN' AND PAYR-PAY-STATUS NOT =
021300         'CF' AND PAYR-PAY-STATUS NOT = 'CX'
021400         ADD 1 TO WS-REJECT-CNT
021500         MOVE 'PAY_STATUS INVALID' TO ERR-TEXT
021600     END-IF
021700     IF PAYR-AUTH-USER = SPACES OR LOW-VALUES
021800         ADD 1 TO WS-REJECT-CNT
021900         MOVE 'AUTH_USER MISSING' TO ERR-TEXT
022000     END-IF
022100     IF PAYR-SANCTIONS-RESULT = SPACES OR LOW-VALUES
022200         ADD 1 TO WS-REJECT-CNT
022300         MOVE 'SANCTIONS_RESULT MISSING' TO ERR-TEXT
022400     END-IF
022500     .
022600* --- 2540-EDIT-PAYEE-3: VALIDATE CLR.T_PAYEE
022700 2540-EDIT-PAYEE-3.
022800* --- 2550-EDIT-PAYMENT-3: FIELD EDITS FOR CLR.T_PAYMENT
022900 2550-EDIT-PAYMENT-3.
023000* --- 4100-UPDATE-PAYMENT: UPDATE CLR.T_PAYMENT
023100 4100-UPDATE-PAYMENT.
023200     EXEC SQL
023300         UPDATE CLR.T_PAYMENT
023400            SET PAY_STATUS = 'CX'
023500              , COMMENT_TXT = :PAYR-COMMENT-TXT
023600              , LAST_UPD_TS = CURRENT TIMESTAMP
023700              , LAST_UPD_PGM = :WS-PGM-ID
023800              , LAST_UPD_USER = :WS-USER-ID
023900          WHERE PAY_ID = :PAYR-PAY-ID
024000     END-EXEC
024100     EVALUATE SQLCODE
024200         WHEN 0
024300             ADD 1 TO WS-PAYMENT-WRITTEN
024400         WHEN +100
024500             SET WS-ROW-NOT-FOUND TO TRUE
024600         WHEN OTHER
024700             MOVE 'UPDATE CLR.T_PAYMENT' TO ERR-PARA
024800             PERFORM 8000-SQL-ERROR
024900     END-EVALUATE
025000     .
025100* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
025200 4900-WRITE-AUDIT.
025300     MOVE 'CLR.T_PAYMENT' TO WS-AUD-TABLE
025400     MOVE CA-CLAIM-ID TO WS-AUD-KEY
025500     MOVE 'A' TO WS-AUD-ACTION
025600     MOVE WS-USER-ID TO WS-AUD-USER
025700     MOVE WS-PGM-ID TO WS-AUD-PGM
025800     CALL 'CLRCM020' USING WS-AUDIT-PARMS
025900                      CLR-ERROR-BLOCK
026000     IF ERR-SQLCODE NOT = ZERO
026100         ADD 1 TO WS-REJECT-CNT
026200     END-IF
026300     .
026400* --- 9000-RETURN: RETURN TO CICS
026500 9000-RETURN.
026600     MOVE CLR-COMMAREA TO DFHCOMMAREA
026700     EXEC CICS RETURN END-EXEC
026800     .
026900* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
027000 8000-SQL-ERROR.
027100     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
027200     MOVE WS-PGM-ID TO ERR-PGM
027300     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
027400         ERR-TEXT
027500     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
027600     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
027700     MOVE 16 TO CA-RETURN-CD
027800     MOVE ERR-TEXT TO CA-MSG
027900     PERFORM 9000-RETURN
028000     .
