027600 2000-SCHEDULE.
027700* TIER-3 REVIEW CADENCE (BR-RSV-007) IS A PARAMETER, NOT A
027800*   CONSTANT:
027900* RSV_T3_REVIEW_DAYS IS READ THROUGH CLRCM040 FOR EVERY RUN DATE.
028000     MOVE 'RSV_T3_REVIEW_DAYS' TO PARM-PARAM-KEY
028100     CALL 'CLRCM040' USING PARMREC1-REC
028200                      CLR-ERROR-BLOCK
028300     IF ERR-SQLCODE NOT = ZERO
028400        MOVE 'CALL CLRCM040' TO ERR-PARA
028500        PERFORM 8000-SQL-ERROR
028600     END-IF
028700     MOVE FUNCTION NUMVAL(PARM-PARAM-VALUE) TO WS-REVIEW-DAYS
028800     MOVE FUNCTION CURRENT-DATE(1:8) TO WS-YYYYMMDD
028900     COMPUTE WS-DATE-INT = FUNCTION INTEGER-OF-DATE(WS-YYYYMMDD)
029000        + WS-REVIEW-DAYS
029100     COMPUTE WS-YYYYMMDD = FUNCTION DATE-OF-INTEGER(WS-DATE-INT)
029200     STRING WS-YYYYMMDD(1:4) '-' WS-YYYYMMDD(5:2) '-'
029300         WS-YYYYMMDD(7:2)
029400        DELIMITED BY SIZE INTO DW-IN-DATE
029500     MOVE 'UK' TO DW-CALENDAR
029600     MOVE ZERO TO DW-BUS-DAYS
029700     CALL 'CLRCM010' USING CLR-DATE-WORK
029800                      CLR-ERROR-BLOCK
029900     IF ERR-SQLCODE NOT = ZERO
030000        MOVE 'CALL CLRCM010' TO ERR-PARA
030100        PERFORM 8000-SQL-ERROR
030200     END-IF
030300     MOVE DW-OUT-DATE TO WS-NEXT-REVIEW-DT
030400     EXEC SQL
030500         SELECT RSV_ID
030600           INTO :RSV-RSV-ID
030700           FROM FINAL TABLE (
030800         UPDATE CLR.T_RESERVE
030900            SET RSV_NEXT_REVIEW_DT = :WS-NEXT-REVIEW-DT
031000              , LAST_UPD_TS = CURRENT TIMESTAMP
031100              , LAST_UPD_PGM = :WS-PGM-ID
031200              , LAST_UPD_USER = :WS-USER-ID
031300          WHERE CLAIM_ID = :TIR-CLAIM-ID
031400            AND RSV_TYPE_CD = 'ID'
031500            AND RSV_STATUS = 'O' )
031600     END-EXEC
031700     EVALUATE SQLCODE
031800        WHEN 0
031900           ADD 1 TO WS-RESERVE-WRITTEN
032000        WHEN +100
032100           SET WS-ROW-NOT-FOUND TO TRUE
032200        WHEN OTHER
