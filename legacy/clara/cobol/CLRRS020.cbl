019100* ---------------------------------------------------------------*
019200* 0000-MAIN                                                      *
019300* PSEUDO-CONVERSATIONAL CONTROL                                  *
019400* ---------------------------------------------------------------*
019500 0000-MAIN.
019600     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
019700     IF EIBCALEN = ZERO
019800        INITIALIZE CLR-COMMAREA
019900        MOVE 'RS02' TO CA-TRANID
020000        PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
020100     ELSE
020200        MOVE DFHCOMMAREA TO CLR-COMMAREA
020300        PERFORM 2000-PROCESS-INPUT THRU 2000-PROCESS-INPUT-EXIT
020400     END-IF
020500     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
020600     GOBACK.
020700 0000-MAIN-EXIT.
020800     EXIT.
020900* ---------------------------------------------------------------*
021000* 1000-FIRST-TIME                                                *
021100* SEND THE EMPTY SCREEN                                          *
021200* ---------------------------------------------------------------*
021300 1000-FIRST-TIME.
021400     MOVE LOW-VALUES TO CLRM320O
021500     EXEC CICS SEND MAP('CLRM320') MAPSET('CLRMS04')
021600        ERASE FREEKB RESP(WS-RESP) END-EXEC
021700     .
021800 1000-FIRST-TIME-EXIT.
021900     EXIT.
022000* ---------------------------------------------------------------*
022100* 2000-PROCESS-INPUT                                             *
022200* INPUT PROCESSING                                               *
022300* ---------------------------------------------------------------*
022400 2000-PROCESS-INPUT.
022500     EXEC CICS RECEIVE MAP('CLRM320') MAPSET('CLRMS04')
022600        INTO(CLRM320I) RESP(WS-RESP) END-EXEC
022700     EVALUATE TRUE
022800        WHEN EIBAID = AID-PF3
022900        WHEN EIBAID = AID-CLEAR
023000           MOVE ZERO TO CA-RETURN-CD
023100           EXEC CICS RETURN END-EXEC
023200        WHEN EIBAID = AID-PF12
023300           PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
023400        WHEN EIBAID = AID-ENTER
023500           PERFORM 2100-EDIT-INPUT THRU 2100-EDIT-INPUT-EXIT
023600           IF WS-NO-ERROR
023700              PERFORM 2200-APPLY THRU 2200-APPLY-EXIT
023800           END-IF
023900        WHEN OTHER
024000           MOVE 'INVALID KEY PRESSED' TO MSGO
024100     END-EVALUATE
024200     EXEC CICS SEND MAP('CLRM320') MAPSET('CLRMS04')
024300        DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
024400     .
024500 2000-PROCESS-INPUT-EXIT.
024600     EXIT.
024700* ---------------------------------------------------------------*
024800* 2100-EDIT-INPUT                                                *
024900* VALIDATE THE REQUEST                                           *
025000* ---------------------------------------------------------------*
025100 2100-EDIT-INPUT.
025200     SET WS-NO-ERROR TO TRUE
025300     IF CLAIMIDL = ZERO OR CLAIMIDI = SPACES
025400        SET WS-ERROR-FOUND TO TRUE
025500        MOVE WS-MSG-01 TO MSGO
025600        MOVE -1 TO CLAIMIDL
025700     ELSE
025800        MOVE CLAIMIDI TO CA-CLAIM-ID
025900     END-IF
026000     PERFORM 1500-CHECK-AUTHORITY THRU 1500-CHECK-AUTHORITY-EXIT
026100     .
026200 2100-EDIT-INPUT-EXIT.
026300     EXIT.
026400* ---------------------------------------------------------------*
026500* 1500-CHECK-AUTHORITY                                           *
026600* CONFIRM THE USER MAY RUN THIS FUNCTION                         *
026700* ---------------------------------------------------------------*
026800 1500-CHECK-AUTHORITY.
026900     MOVE WS-USER-ID TO WS-AUTH-USER
027000     MOVE 'CLRRS020' TO WS-AUTH-FUNCTION
027100     CALL 'CLRCM070' USING WS-AUTH-PARMS
