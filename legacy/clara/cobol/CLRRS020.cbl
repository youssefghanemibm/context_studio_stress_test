058800 3000-ADJUST.
058900* RESERVE ADJUSTMENT. AUTHORITY IS CHECKED FIRST; ABOVE-AUTHORITY
059000* CHANGES ARE QUEUED FOR APPROVAL THROUGH CLRRS040.
059100     MOVE FUNCTION NUMVAL(NEWAMTI) TO WS-NEW-AMT WS-RA-AMOUNT
059200     MOVE WS-USER-ID TO WS-RA-USER
059300     MOVE CLM-CURRENCY-CD TO WS-RA-CURRENCY
059400     CALL 'CLRRS015' USING WS-RSVAUTH-PARMS
059500                      CLR-ERROR-BLOCK
059600     IF ERR-SQLCODE NOT = ZERO
059700        MOVE 'CALL CLRRS015' TO ERR-PARA
059800        PERFORM 8000-SQL-ERROR
059900     END-IF
060000     IF WS-RA-RESULT NOT = 'Y'
060100        CALL 'CLRRS040' USING DFHEIBLK
060200                         DFHCOMMAREA
060300        MOVE DFHCOMMAREA TO CLR-COMMAREA
060400        IF CA-RETURN-CD > 4
060500           SET WS-ERROR-FOUND TO TRUE
060600        END-IF
060700        MOVE 'CHANGE QUEUED FOR APPROVAL' TO MSGO
060800     ELSE
060900        MOVE CLM-CURRENCY-CD TO WS-CCY-FROM
061000        MOVE WS-NEW-AMT TO WS-CCY-AMOUNT
061100        MOVE WS-RUN-DATE TO WS-CCY-RATE-DT
061200        CALL 'CLRCM030' USING WS-CCY-PARMS
061300                         CLR-ERROR-BLOCK
061400        IF ERR-SQLCODE NOT = ZERO
061500           MOVE 'CALL CLRCM030' TO ERR-PARA
061600           PERFORM 8000-SQL-ERROR
061700        END-IF
061800        MOVE FUNCTION NUMVAL(RSVIDI) TO RSV-RSV-ID
061900        EXEC SQL
062000            SELECT RSV_OUTSTANDING_AMT
062100              INTO :WS-OLD-AMT
062200              FROM OLD TABLE (
062300            UPDATE CLR.T_RESERVE
062400               SET RSV_OUTSTANDING_AMT = :WS-NEW-AMT
062500                 , RSV_GBP_EQUIV_AMT = :WS-CCY-GBP-AMOUNT
062600                 , RSV_AUTH_LEVEL = :WS-RA-REQUIRED-LVL
062700                 , RSV_SET_BY_USER = :WS-USER-ID
062800                 , RSV_NEXT_REVIEW_DT = :RSV-RSV-NEXT-REVIEW-DT
062900                 , LAST_UPD_TS = CURRENT TIMESTAMP
063000                 , LAST_UPD_PGM = :WS-PGM-ID
063100             WHERE RSV_ID = :RSV-RSV-ID
063200               AND RSV_STATUS = 'O' )
063300        END-EXEC
063400        EVALUATE SQLCODE
063500           WHEN 0
063600              ADD 1 TO WS-RESERVE-WRITTEN
063700           WHEN +100
063800              SET WS-ROW-NOT-FOUND TO TRUE
063900           WHEN OTHER
064000              MOVE '3000-ADJUST' TO ERR-PARA
064100              PERFORM 8000-SQL-ERROR
064200        END-EVALUATE
064300        COMPUTE WS-DELTA-AMT = WS-NEW-AMT - WS-OLD-AMT
064400        PERFORM 3100-POST-ADJUSTMENT THRU
064500            3100-POST-ADJUSTMENT-EXIT
064600     END-IF
064700     .
064800 3000-ADJUST-EXIT.
064900     EXIT.
