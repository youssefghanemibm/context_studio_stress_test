067600              ( RSV_ID, CLAIM_ID, MOVE_TS, MOVE_TYPE_CD
067700              , MOVE_AMT, MOVE_GBP_AMT, REASON_CD, USER_ID
067800              , PGM_ID, EXTRACTED_FLAG )
067900         VALUES
068000              ( :RSVM-RSV-ID, :RSVM-CLAIM-ID, CURRENT TIMESTAMP
068100              , :RSVM-MOVE-TYPE-CD, :RSVM-MOVE-AMT
068200              , :RSVM-MOVE-GBP-AMT, :RSVM-REASON-CD
068300              , :RSVM-USER-ID, :RSVM-PGM-ID
068400              , :RSVM-EXTRACTED-FLAG )
068500     END-EXEC
