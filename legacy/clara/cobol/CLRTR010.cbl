022200        EXEC CICS SYNCPOINT END-EXEC
022300        MOVE ZERO TO CA-RETURN-CD
022400     END-IF
022500     .
022600* --- 2300-READ-CLAIM: READ CLR.T_CLAIM
022700 2300-READ-CLAIM.
022800     MOVE CA-CLAIM-ID TO CLM-CLAIM-ID
022900     SET WS-ROW-FOUND TO TRUE
023000     EXEC SQL
023100         SELECT CLAIM_ID, POLICY_NO, PRODUCT_CD, PERIL_CD
023200                , LOSS_DT
023300           INTO :CLM-CLAIM-ID, :CLM-POLICY-NO
023400                , :CLM-PRODUCT-CD, :CLM-PERIL-CD
023500                , :CLM-LOSS-DT
023600           FROM CLR.T_CLAIM
023700          WHERE CLAIM_ID = :CLM-CLAIM-ID
023800     END-EXEC
023900     EVALUATE SQLCODE
024000        WHEN 0
024100           ADD 1 TO WS-CLAIM-READ
024200        WHEN +100
024300           SET WS-ROW-NOT-FOUND TO TRUE
024400        WHEN OTHER
024500           MOVE 'READ CLR.T_CLAIM' TO ERR-PARA
024600           PERFORM 8000-SQL-ERROR
024700     END-EVALUATE
024800     .
024900* --- 2320-READ-CLAIM-TIER: FETCH CLR.T_CLAIM_TIER
025000 2320-READ-CLAIM-TIER.
025100     MOVE CA-CLAIM-ID TO TIR-CLAIM-ID
