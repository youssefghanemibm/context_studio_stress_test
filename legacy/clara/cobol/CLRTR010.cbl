015700* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
015800 0000-MAIN.
015900     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
016000     IF EIBCALEN = ZERO
016100        INITIALIZE CLR-COMMAREA
016200        MOVE 'TR01' TO CA-TRANID
016300        PERFORM 1000-FIRST-TIME
016400     ELSE
016500        MOVE DFHCOMMAREA TO CLR-COMMAREA
016600        PERFORM 2000-PROCESS-INPUT
016700     END-IF
016800     PERFORM 9000-RETURN
016900     GOBACK.
017000* --- 1000-FIRST-TIME: SEND THE EMPTY SCREEN
017100 1000-FIRST-TIME.
017200     MOVE LOW-VALUES TO CLRM110O
017300     EXEC CICS SEND MAP('CLRM110') MAPSET('CLRMS02')
017400        ERASE FREEKB RESP(WS-RESP) END-EXEC
017500     .
017600* --- 2000-PROCESS-INPUT: INPUT PROCESSING
017700 2000-PROCESS-INPUT.
017800     EXEC CICS RECEIVE MAP('CLRM110') MAPSET('CLRMS02')
017900        INTO(CLRM110I) RESP(WS-RESP) END-EXEC
018000     EVALUATE TRUE
018100        WHEN EIBAID = AID-PF3
018200        WHEN EIBAID = AID-CLEAR
018300           MOVE ZERO TO CA-RETURN-CD
018400           EXEC CICS RETURN END-EXEC
018500        WHEN EIBAID = AID-PF12
018600           PERFORM 1000-FIRST-TIME
018700        WHEN EIBAID = AID-ENTER
018800           PERFORM 2100-EDIT-INPUT
018900           IF WS-NO-ERROR
019000              PERFORM 2200-APPLY
019100           END-IF
019200        WHEN OTHER
019300           MOVE 'INVALID KEY PRESSED' TO MSGO
019400     END-EVALUATE
019500     EXEC CICS SEND MAP('CLRM110') MAPSET('CLRMS02')
019600        DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
019700     .
019800* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
019900 2100-EDIT-INPUT.
020000     SET WS-NO-ERROR TO TRUE
020100     IF CLAIMIDL = ZERO OR CLAIMIDI = SPACES
020200        SET WS-ERROR-FOUND TO TRUE
020300        MOVE WS-MSG-01 TO MSGO
020400        MOVE -1 TO CLAIMIDL
020500     ELSE
020600        MOVE CLAIMIDI TO CA-CLAIM-ID
020700     END-IF
020800     .
