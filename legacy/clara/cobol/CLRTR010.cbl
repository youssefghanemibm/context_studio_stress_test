025300     EXEC SQL
025400         SELECT CLAIM_ID, TIER_FROM_TS, TIER_CD
025500           INTO :TIR-CLAIM-ID, :TIR-TIER-FROM-TS
025600                , :TIR-TIER-CD
025700           FROM CLR.T_CLAIM_TIER
025800          WHERE CLAIM_ID = :TIR-CLAIM-ID
025900            AND TIER_FROM_TS = :TIR-TIER-FROM-TS
026000     END-EXEC
026100     EVALUATE SQLCODE
026200        WHEN 0
026300           ADD 1 TO WS-CLAIM-TIER-READ
026400        WHEN +100
026500           SET WS-ROW-NOT-FOUND TO TRUE
026600        WHEN OTHER
026700           MOVE 'READ CLR.T_CLAIM_TIER' TO ERR-PARA
026800           PERFORM 8000-SQL-ERROR
026900     END-EVALUATE
