032300     IF CLM-CLAIM-STATUS NOT = 'OP' AND CLM-CLAIM-STATUS NOT =
032400         'CS' AND CLM-CLAIM-STATUS NOT = 'CN' AND CLM-CLAIM-STATUS
032500         NOT = 'RO' AND CLM-CLAIM-STATUS NOT = 'RC'
032600        ADD 1 TO WS-REJECT-CNT
032700        MOVE 'CLAIM_STATUS INVALID' TO ERR-TEXT
032800     END-IF
032900     IF CLM-TIER-CD NOT = '1' AND CLM-TIER-CD NOT = '2' AND
033000         CLM-TIER-CD NOT = '3'
033100        ADD 1 TO WS-REJECT-CNT
033200        MOVE 'TIER_CD INVALID' TO ERR-TEXT
033300     END-IF
