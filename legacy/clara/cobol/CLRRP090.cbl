009800     05  WS-IND-1                PIC S9(4)  COMP VALUE ZERO.
009900     05  WS-IND-2                PIC S9(4)  COMP VALUE ZERO.
010000     05  WS-NEW-ID               PIC S9(18) COMP VALUE ZERO.
010100*
010200     EXEC SQL INCLUDE SQLCA END-EXEC.
010300*
010400* COPYBOOKS (HOST STRUCTURES AND WORK AREAS)
010500 COPY CLRCLM01.
010600 COPY NISARET1.
010700 COPY RPTRUN01.
010800 COPY CLRERR01.
010900*
011000* PARAMETER AREAS FOR CALLED MODULES
011100 01  WS-AUDIT-PARMS.
011200     05  WS-AUD-TABLE            PIC X(18).
011300     05  WS-AUD-KEY              PIC X(30).
011400     05  WS-AUD-ACTION           PIC X(1).
011500     05  WS-AUD-USER             PIC X(8).
011600     05  WS-AUD-PGM              PIC X(8).
011700*
011800* DRIVING CURSOR ON CLR.T_CLAIM
011900     EXEC SQL
012000         DECLARE C-CLAIM CURSOR WITH HOLD FOR
012100         SELECT CLAIM_ID, POLICY_NO, PRODUCT_CD, PERIL_CD
012200           FROM CLR.T_CLAIM
012300          WHERE CLAIM_STATUS IN ('OP', 'RO', 'RC')
012400          ORDER BY CLAIM_ID
012500          FOR FETCH ONLY
012600     END-EXEC.
012700*
012800* CONTROL REPORT LINES
012900 01  WS-RPT-HEAD-1.
013000     05  FILLER                  PIC X(1)   VALUE '1'.
013100     05  FILLER                  PIC X(10)  VALUE 'CLRRP090'.
013200     05  FILLER                  PIC X(40)  VALUE
013300           'EXECUTIVE DASHBOARD EXTRACT'.
013400     05  FILLER                  PIC X(10)  VALUE 'RUN DATE: '.
013500     05  RH1-RUN-DATE            PIC X(10).
013600     05  FILLER                  PIC X(62)  VALUE SPACES.
013700 01  WS-RPT-DETAIL.
013800     05  FILLER                  PIC X(1)   VALUE SPACE.
013900     05  RD-LABEL                PIC X(40).
014000     05  RD-VALUE                PIC X(60).
014100     05  FILLER                  PIC X(32)  VALUE SPACES.
014200 01  WS-RPT-TOTAL.
014300     05  FILLER                  PIC X(1)   VALUE SPACE.
014400     05  RT-LABEL                PIC X(40).
014500     05  RT-COUNT                PIC ZZZ,ZZZ,ZZ9.
014600     05  FILLER                  PIC X(81)  VALUE SPACES.
014700 PROCEDURE DIVISION.
014800* --- 0000-MAINLINE: CONTROL FLOW
014900 0000-MAINLINE.
015000     PERFORM 1000-INITIALISE
015100     PERFORM 2000-PROCESS
015200     PERFORM 9000-TERMINATE
015300     GOBACK.
015400* --- 1000-INITIALISE: INITIALISATION
015500 1000-INITIALISE.
015600     MOVE FUNCTION CURRENT-DATE(1:8) TO WS-RUN-TS
015700     STRING WS-RUN-TS(1:4) '-' WS-RUN-TS(5:2) '-' WS-RUN-TS(7:2)
015800        DELIMITED BY SIZE INTO WS-RUN-DATE
015900     MOVE 'CLRBATCH' TO WS-USER-ID
016000     OPEN OUTPUT REPORT-FILE
016100     IF WS-RPTOUT-STATUS NOT = '00'
016200        DISPLAY 'CLRRP090 OPEN FAILED RPTOUT ' WS-RPTOUT-STATUS
016300        MOVE 16 TO RETURN-CODE
016400        GOBACK
016500     END-IF
016600     OPEN OUTPUT EXTRACT-FILE
016700     IF WS-EXTOUT-STATUS NOT = '00'
016800        DISPLAY 'CLRRP090 OPEN FAILED EXTOUT ' WS-EXTOUT-STATUS
016900        MOVE 16 TO RETURN-CODE
017000        GOBACK
017100     END-IF
017200     MOVE WS-RUN-DATE TO RH1-RUN-DATE
017300     WRITE REPORT-RECORD FROM WS-RPT-HEAD-1
017400     .
017500* --- 2000-PROCESS: READ AND PROCESS ALL INPUT
017600 2000-PROCESS.
017700     EXEC SQL
017800         OPEN C-CLAIM
017900     END-EXEC
018000     EVALUATE SQLCODE
018100        WHEN 0
018200           CONTINUE
018300        WHEN OTHER
018400           MOVE '2000-OPEN-C-CLAIM' TO ERR-PARA
018500           PERFORM 8000-SQL-ERROR
018600     END-EVALUATE
018700     PERFORM 2100-FETCH-NEXT
018800     PERFORM UNTIL WS-END-OF-DATA
018900        PERFORM 2200-PROCESS-ROW
019000        PERFORM 2100-FETCH-NEXT
019100     END-PERFORM
019200     EXEC SQL
019300         CLOSE C-CLAIM
019400     END-EXEC
019500     .
019600* --- 2100-FETCH-NEXT: FETCH THE NEXT DRIVING ROW
019700 2100-FETCH-NEXT.
019800     EXEC SQL
019900         FETCH C-CLAIM
020000          INTO :CLM-CLAIM-ID, :CLM-POLICY-NO, :CLM-PRODUCT-CD
020100               , :CLM-PERIL-CD
020200     END-EXEC
020300     EVALUATE SQLCODE
020400        WHEN 0
020500           ADD 1 TO WS-CLAIM-READ
020600        WHEN +100
020700           SET WS-END-OF-DATA TO TRUE
020800        WHEN OTHER
020900           MOVE '2100-FETCH-NEXT' TO ERR-PARA
021000           PERFORM 8000-SQL-ERROR
021100     END-EVALUATE
021200     .
021300* --- 2200-PROCESS-ROW: ONE UNIT OF WORK
021400 2200-PROCESS-ROW.
021500     SET WS-NO-ERROR TO TRUE
021600     PERFORM 2300-READ-NISA-RETURN
021700     PERFORM 4100-INSERT-REPORT-RUN
021800     PERFORM 4900-WRITE-AUDIT
021900     PERFORM 5000-WRITE-EXTRACT
022000     PERFORM 6000-COMMIT-CHECK
022100     .
022200* --- 2300-READ-NISA-RETURN: FETCH CLR.T_NISA_RETURN
022300 2300-READ-NISA-RETURN.
022400     SET WS-ROW-FOUND TO TRUE
022500     EXEC SQL
022600         SELECT RETURN_CD, PERIOD_CD, CELL_REF, CELL_VALUE
022700                , SUBMITTED_DT
022800           INTO :NISA-RETURN-CD, :NISA-PERIOD-CD
022900                , :NISA-CELL-REF, :NISA-CELL-VALUE
023000                , :NISA-SUBMITTED-DT
023100           FROM CLR.T_NISA_RETURN
023200          WHERE RETURN_CD = :NISA-RETURN-CD
023300            AND PERIOD_CD = :NISA-PERIOD-CD
023400     END-EXEC
023500     EVALUATE SQLCODE
023600        WHEN 0
023700           ADD 1 TO WS-NISA-RETURN-READ
023800        WHEN +100
023900           SET WS-ROW-NOT-FOUND TO TRUE
024000        WHEN OTHER
024100           MOVE 'READ CLR.T_NISA_RETURN' TO ERR-PARA
024200           PERFORM 8000-SQL-ERROR
024300     END-EVALUATE
024400     .
024500* --- 4100-INSERT-REPORT-RUN: INSERT CLR.T_REPORT_RUN
024600 4100-INSERT-REPORT-RUN.
024700     EXEC SQL
024800         INSERT INTO CLR.T_REPORT_RUN
024900              ( RUN_ID, REPORT_CD, RUN_TS, ROW_COUNT
025000              , RUN_STATUS, LAST_UPD_TS, LAST_UPD_PGM
025100              , LAST_UPD_USER )
025200         VALUES
025300              ( :RPTR-RUN-ID, :RPTR-REPORT-CD
025400              , CURRENT TIMESTAMP, :RPTR-ROW-COUNT
025500              , :RPTR-RUN-STATUS, CURRENT TIMESTAMP, :WS-PGM-ID
025600              , :WS-USER-ID )
025700     END-EXEC
025800     EVALUATE SQLCODE
025900        WHEN 0
026000           ADD 1 TO WS-REPORT-RUN-WRITTEN
026100        WHEN +100
026200           SET WS-ROW-NOT-FOUND TO TRUE
026300        WHEN OTHER
026400           MOVE 'INSERT CLR.T_REPORT_RUN' TO ERR-PARA
026500           PERFORM 8000-SQL-ERROR
026600     END-EVALUATE
026700     .
026800* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
026900 4900-WRITE-AUDIT.
027000     MOVE 'CLR.T_REPORT_RUN' TO WS-AUD-TABLE
027100     MOVE CLM-CLAIM-ID TO WS-AUD-KEY
027200     MOVE 'I' TO WS-AUD-ACTION
027300     MOVE WS-USER-ID TO WS-AUD-USER
027400     MOVE WS-PGM-ID TO WS-AUD-PGM
027500     CALL 'CLRCM020' USING WS-AUDIT-PARMS
027600                      CLR-ERROR-BLOCK
027700     IF ERR-SQLCODE NOT = ZERO
027800        ADD 1 TO WS-REJECT-CNT
027900     END-IF
028000     .
028100* --- 5000-WRITE-EXTRACT: WRITE THE OUTBOUND RECORD
028200 5000-WRITE-EXTRACT.
028300     MOVE SPACES TO EXTRACT-RECORD
028400     MOVE CLM-CLAIM-ID TO EXTRACT-RECORD(1:12)
028500     WRITE EXTRACT-RECORD
028600     IF WS-EXTOUT-STATUS NOT = '00'
028700        DISPLAY WS-PGM-ID ' WRITE FAILED EXTOUT ' WS-EXTOUT-STATUS
028800        ADD 1 TO WS-REJECT-CNT
028900     END-IF
029000     .
029100* --- 6000-COMMIT-CHECK: PERIODIC COMMIT
029200 6000-COMMIT-CHECK.
029300     ADD 1 TO WS-SINCE-COMMIT
029400     IF WS-SINCE-COMMIT >= WS-COMMIT-FREQ
029500        EXEC SQL
029600            COMMIT
029700        END-EXEC
029800        MOVE ZERO TO WS-SINCE-COMMIT
029900     END-IF
030000     .
030100* --- 9000-TERMINATE: CLOSE DOWN
030200 9000-TERMINATE.
030300     EXEC SQL
030400         COMMIT
030500     END-EXEC
030600     MOVE 'CLR.T_CLAIM ROWS READ' TO RT-LABEL
030700     MOVE WS-CLAIM-READ TO RT-COUNT
030800     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
030900     MOVE 'CLR.T_NISA_RETURN ROWS READ' TO RT-LABEL
031000     MOVE WS-NISA-RETURN-READ TO RT-COUNT
031100     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
031200     MOVE 'CLR.T_REPORT_RUN ROWS WRITTEN' TO RT-LABEL
031300     MOVE WS-REPORT-RUN-WRITTEN TO RT-COUNT
031400     WRITE REPORT-RECORD FROM WS-RPT-TOTAL
031500     CLOSE REPORT-FILE
031600     CLOSE EXTRACT-FILE
031700     IF WS-REJECT-CNT > ZERO
031800        MOVE 4 TO RETURN-CODE
031900     END-IF
032000     .
032100* --- 8000-SQL-ERROR: DB2 ERROR HANDLING
032200 8000-SQL-ERROR.
032300     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
032400     MOVE WS-PGM-ID TO ERR-PGM
032500     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
032600         ERR-TEXT
032700     DISPLAY WS-PGM-ID ' ' ERR-PARA ' ' ERR-TEXT
032800     EXEC SQL
032900         ROLLBACK
033000     END-EXEC
033100     MOVE 16 TO RETURN-CODE
033200     CLOSE REPORT-FILE
033300     CLOSE EXTRACT-FILE
033400     GOBACK.
