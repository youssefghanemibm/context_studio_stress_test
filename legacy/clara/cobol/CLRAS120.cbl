014600     IF WS-RPTOUT-STATUS NOT = '00'
014700        DISPLAY 'CLRAS120 OPEN FAILED RPTOUT ' WS-RPTOUT-STATUS
014800        MOVE 16 TO RETURN-CODE
014900        GOBACK
015000     END-IF
015100     OPEN OUTPUT EXTRACT-FILE
015200     IF WS-EXTOUT-STATUS NOT = '00'
015300        DISPLAY 'CLRAS120 OPEN FAILED EXTOUT ' WS-EXTOUT-STATUS
015400        MOVE 16 TO RETURN-CODE
015500        GOBACK
015600     END-IF
015700     MOVE WS-RUN-DATE TO RH1-RUN-DATE
