015900     .
016000* --- 2000-PROCESS: MAIN PROCESSING LOOP
016100 2000-PROCESS.
016200     EXEC SQL
016300         OPEN C-ASSESSMENT
016400     END-EXEC
016500     EVALUATE SQLCODE
016600        WHEN 0
016700           CONTINUE
016800        WHEN OTHER
016900           MOVE '2000-OPEN-C-ASSESSMENT' TO ERR-PARA
017000           PERFORM 8000-SQL-ERROR
017100     END-EVALUATE
017200     PERFORM 2100-FETCH-NEXT
017300     PERFORM UNTIL WS-END-OF-DATA
017400        PERFORM 2200-PROCESS-ROW
017500        PERFORM 2100-FETCH-NEXT
017600     END-PERFORM
017700     EXEC SQL
017800         CLOSE C-ASSESSMENT
017900     END-EXEC
018000     .
018100* --- 2100-FETCH-NEXT: FETCH THE NEXT DRIVING ROW
018200 2100-FETCH-NEXT.
018300     EXEC SQL
018400         FETCH C-ASSESSMENT
018500          INTO :ASM-ASSESS-ID, :ASM-CLAIM-ID
018600               , :ASM-ASSESS-TYPE-CD, :ASM-COVER-DECISION-CD
018700               , :ASM-ESTIMATE-AMT
018800     END-EXEC
018900     EVALUATE SQLCODE
019000        WHEN 0
019100           ADD 1 TO WS-ASSESSMENT-READ
019200        WHEN +100
019300           SET WS-END-OF-DATA TO TRUE
019400        WHEN OTHER
019500           MOVE '2100-FETCH-NEXT' TO ERR-PARA
019600           PERFORM 8000-SQL-ERROR
019700     END-EVALUATE
019800     .
019900* --- 2200-PROCESS-ROW: ONE UNIT OF WORK
020000 2200-PROCESS-ROW.
020100     SET WS-NO-ERROR TO TRUE
020200     PERFORM 2300-READ-ASSE-ASSI
020300     PERFORM 2500-EDIT-ASSESSMENT
020400     PERFORM 2510-EDIT-ASSE-ASSI
020500     PERFORM 2520-EDIT-ASSESSMENT-2
020600     PERFORM 2530-EDIT-ASSE-ASSI-2
020700     PERFORM 2540-EDIT-ASSE-ASSI-3
020800     PERFORM 5000-WRITE-EXTRACT
020900     .
021000* --- 2300-READ-ASSE-ASSI: READ CLR.T_ASSESSOR_ASSIGNMENT
021100 2300-READ-ASSE-ASSI.
021200     SET WS-ROW-FOUND TO TRUE
021300     EXEC SQL
021400         SELECT ASSIGN_ID, CLAIM_ID, ASSESSOR_ID, VENDOR_CD
021500                , APPOINTED_TS, SLA_DUE_DT
021600           INTO :ASG-ASSIGN-ID, :ASG-CLAIM-ID
021700                , :ASG-ASSESSOR-ID, :ASG-VENDOR-CD
021800                , :ASG-APPOINTED-TS, :ASG-SLA-DUE-DT
021900           FROM CLR.T_ASSESSOR_ASSIGNMENT
022000          WHERE CLAIM_ID = :ASM-CLAIM-ID
022100          FETCH FIRST 1 ROW ONLY
022200     END-EXEC
022300     EVALUATE SQLCODE
022400        WHEN 0
022500           ADD 1 TO WS-ASSESSOR-ASSIGNMENT-READ
022600        WHEN +100
022700           SET WS-ROW-NOT-FOUND TO TRUE
022800        WHEN OTHER
022900           MOVE 'READ CLR.T_ASSESSOR_ASSIGNMENT' TO ERR-PARA
023000           PERFORM 8000-SQL-ERROR
023100     END-EVALUATE
023200     .
023300* --- 2500-EDIT-ASSESSMENT: CHECK MANDATORY FIELDS IN CLR.T_ASSESS
023400 2500-EDIT-ASSESSMENT.
023500     IF ASM-CLAIM-ID = SPACES OR LOW-VALUES
023600        ADD 1 TO WS-REJECT-CNT
023700        MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
023800     END-IF
023900     IF ASM-ASSESS-TYPE-CD NOT = 'DK' AND ASM-ASSESS-TYPE-CD NOT =
024000         'SV' AND ASM-ASSESS-TYPE-CD NOT = 'VI'
024100        ADD 1 TO WS-REJECT-CNT
024200        MOVE 'ASSESS_TYPE_CD INVALID' TO ERR-TEXT
024300     END-IF
024400     .
024500* --- 2510-EDIT-ASSE-ASSI: FIELD EDITS FOR CLR.T_ASSESSOR_ASSIGNME
024600 2510-EDIT-ASSE-ASSI.
024700     IF ASG-CLAIM-ID = SPACES OR LOW-VALUES
024800        ADD 1 TO WS-REJECT-CNT
024900        MOVE 'CLAIM_ID MISSING' TO ERR-TEXT
025000     END-IF
025100     IF ASG-ASSESSOR-ID = SPACES OR LOW-VALUES
025200        ADD 1 TO WS-REJECT-CNT
025300        MOVE 'ASSESSOR_ID MISSING' TO ERR-TEXT
025400     END-IF
025500     .
025600* --- 2520-EDIT-ASSESSMENT-2: VALIDATE CLR.T_ASSESSMENT
025700 2520-EDIT-ASSESSMENT-2.
025800     IF ASM-COVER-DECISION-CD NOT = 'AC' AND ASM-COVER-DECISION-CD
025900         NOT = 'DC' AND ASM-COVER-DECISION-CD NOT = 'PA'
026000        ADD 1 TO WS-REJECT-CNT
026100        MOVE 'COVER_DECISION_CD INVALID' TO ERR-TEXT
026200     END-IF
026300     IF ASM-ESTIMATE-AMT NOT NUMERIC
026400        MOVE ZERO TO ASM-ESTIMATE-AMT
026500        ADD 1 TO WS-REJECT-CNT
026600     END-IF
026700     IF ASM-REPORT-RECEIVED-DT NOT = SPACES AND
026800         ASM-REPORT-RECEIVED-DT(5:1) NOT = '-'
026900        MOVE 'REPORT_RECEIVED_DT BAD DATE' TO ERR-TEXT
027000        ADD 1 TO WS-REJECT-CNT
027100     END-IF
027200     .
027300* --- 2530-EDIT-ASSE-ASSI-2: FIELD EDITS FOR CLR.T_ASSESSOR_ASSIGN
027400 2530-EDIT-ASSE-ASSI-2.
027500     IF ASG-SLA-DUE-DT NOT = SPACES AND ASG-SLA-DUE-DT(5:1) NOT =
027600         '-'
027700        MOVE 'SLA_DUE_DT BAD DATE' TO ERR-TEXT
027800        ADD 1 TO WS-REJECT-CNT
027900     END-IF
028000     .
028100* --- 2540-EDIT-ASSE-ASSI-3: CHECK MANDATORY FIELDS IN CLR.T_ASSES
028200 2540-EDIT-ASSE-ASSI-3.
028300     IF ASG-VERSION-NO NOT NUMERIC
028400        MOVE ZERO TO ASG-VERSION-NO
028500        ADD 1 TO WS-REJECT-CNT
028600     END-IF
028700     .
028800* --- 5000-WRITE-EXTRACT: WRITE THE OUTBOUND RECORD
028900 5000-WRITE-EXTRACT.
029000     MOVE SPACES TO EXTRACT-RECORD
029100     MOVE ASM-CLAIM-ID TO EXTRACT-RECORD(1:12)
029200     WRITE EXTRACT-RECORD
029300     IF WS-EXTOUT-STATUS NOT = '00'
029400        DISPLAY WS-PGM-ID ' WRITE FAILED EXTOUT ' WS-EXTOUT-STATUS
029500        ADD 1 TO WS-REJECT-CNT
029600     END-IF
029700     .
