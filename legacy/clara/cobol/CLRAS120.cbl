010200* DRIVING CURSOR ON CLR.T_ASSESSMENT
010300     EXEC SQL
010400         DECLARE C-ASSESSMENT CURSOR WITH HOLD FOR
010500         SELECT ASSESS_ID, CLAIM_ID, ASSESS_TYPE_CD
010600                , COVER_DECISION_CD, ESTIMATE_AMT
010700           FROM CLR.T_ASSESSMENT
010800          WHERE LAST_UPD_TS >= :WS-LAST-RUN-TS
010900          ORDER BY ASSESS_ID
011000          FOR FETCH ONLY
011100     END-EXEC.
