014600 PROCEDURE DIVISION.
014700* --- 0000-MAIN: PSEUDO-CONVERSATIONAL CONTROL
014800 0000-MAIN.
014900     EXEC CICS ASSIGN USERID(WS-USER-ID) END-EXEC
015000     IF EIBCALEN = ZERO
015100        INITIALIZE CLR-COMMAREA
015200        MOVE 'ST01' TO CA-TRANID
015300        PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
015400     ELSE
015500        MOVE DFHCOMMAREA TO CLR-COMMAREA
015600        PERFORM 2000-PROCESS-INPUT THRU 2000-PROCESS-INPUT-EXIT
015700     END-IF
015800     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
015900     GOBACK.
016000 0000-MAIN-EXIT.
016100     EXIT.
016200* --- 1000-FIRST-TIME: SEND THE EMPTY SCREEN
016300 1000-FIRST-TIME.
016400     MOVE LOW-VALUES TO CLRM510O
016500     EXEC CICS SEND MAP('CLRM510') MAPSET('CLRMS06')
016600        ERASE FREEKB RESP(WS-RESP) END-EXEC
016700     .
016800 1000-FIRST-TIME-EXIT.
016900     EXIT.
017000* --- 2000-PROCESS-INPUT: PROCESS THE REQUEST
017100 2000-PROCESS-INPUT.
017200     EXEC CICS RECEIVE MAP('CLRM510') MAPSET('CLRMS06')
017300        INTO(CLRM510I) RESP(WS-RESP) END-EXEC
017400     EVALUATE TRUE
017500        WHEN EIBAID = AID-PF3
017600        WHEN EIBAID = AID-CLEAR
017700           MOVE ZERO TO CA-RETURN-CD
017800           EXEC CICS RETURN END-EXEC
017900        WHEN EIBAID = AID-PF12
018000           PERFORM 1000-FIRST-TIME THRU 1000-FIRST-TIME-EXIT
018100        WHEN EIBAID = AID-ENTER
018200           PERFORM 2100-EDIT-INPUT THRU 2100-EDIT-INPUT-EXIT
018300           IF WS-NO-ERROR
018400              PERFORM 2200-APPLY THRU 2200-APPLY-EXIT
018500           END-IF
018600        WHEN OTHER
018700           MOVE 'INVALID KEY PRESSED' TO MSGO
018800     END-EVALUATE
018900     EXEC CICS SEND MAP('CLRM510') MAPSET('CLRMS06')
019000        DATAONLY FREEKB CURSOR RESP(WS-RESP) END-EXEC
019100     .
019200 2000-PROCESS-INPUT-EXIT.
019300     EXIT.
019400* --- 2100-EDIT-INPUT: VALIDATE THE REQUEST
019500 2100-EDIT-INPUT.
019600     SET WS-NO-ERROR TO TRUE
019700     IF CLAIMIDL = ZERO OR CLAIMIDI = SPACES
019800        SET WS-ERROR-FOUND TO TRUE
019900        MOVE WS-MSG-01 TO MSGO
020000        MOVE -1 TO CLAIMIDL
020100     ELSE
020200        MOVE CLAIMIDI TO CA-CLAIM-ID
020300     END-IF
020400     PERFORM 1500-CHECK-AUTHORITY THRU 1500-CHECK-AUTHORITY-EXIT
020500     .
020600 2100-EDIT-INPUT-EXIT.
020700     EXIT.
020800* --- 1500-CHECK-AUTHORITY: CONFIRM THE USER MAY RUN THIS FUNCTION
020900 1500-CHECK-AUTHORITY.
021000     MOVE WS-USER-ID TO WS-AUTH-USER
021100     MOVE 'CLRST010' TO WS-AUTH-FUNCTION
021200     CALL 'CLRCM070' USING WS-AUTH-PARMS
021300                      CLR-ERROR-BLOCK
021400     IF ERR-SQLCODE NOT = ZERO
021500        MOVE 'CALL CLRCM070' TO ERR-PARA
021600        PERFORM 8000-SQL-ERROR
021700     END-IF
021800     IF WS-AUTH-ALLOWED NOT = 'Y'
021900        SET WS-ERROR-FOUND TO TRUE
022000        MOVE 8 TO CA-RETURN-CD
022100        MOVE 'NOT AUTHORISED FOR THIS FUNCTION' TO CA-MSG
022200     END-IF
022300     .
022400 1500-CHECK-AUTHORITY-EXIT.
022500     EXIT.
022600* --- 2200-APPLY: CARRY OUT THE REQUEST
022700 2200-APPLY.
022800     PERFORM 2300-READ-RESERVE THRU 2300-READ-RESERVE-EXIT
022900     PERFORM 4100-INSERT-SETTLEMENT THRU
023000         4100-INSERT-SETTLEMENT-EXIT
023100     PERFORM 4900-WRITE-AUDIT THRU 4900-WRITE-AUDIT-EXIT
023200     IF WS-NO-ERROR
023300        EXEC CICS SYNCPOINT END-EXEC
023400        MOVE ZERO TO CA-RETURN-CD
023500     END-IF
023600     .
023700 2200-APPLY-EXIT.
023800     EXIT.
023900* --- 2300-READ-RESERVE: FETCH CLR.T_RESERVE
024000 2300-READ-RESERVE.
024100     SET WS-ROW-FOUND TO TRUE
024200     EXEC SQL
024300         SELECT RSV_ID, CLAIM_ID, RSV_TYPE_CD
024400           INTO :RSV-RSV-ID, :RSV-CLAIM-ID, :RSV-RSV-TYPE-CD
024500           FROM CLR.T_RESERVE
024600          WHERE RSV_ID = :RSV-RSV-ID
024700     END-EXEC
024800     EVALUATE SQLCODE
024900        WHEN 0
025000           ADD 1 TO WS-RESERVE-READ
025100        WHEN +100
025200           SET WS-ROW-NOT-FOUND TO TRUE
025300        WHEN OTHER
025400           MOVE 'READ CLR.T_RESERVE' TO ERR-PARA
025500           PERFORM 8000-SQL-ERROR
025600     END-EVALUATE
025700     .
025800 2300-READ-RESERVE-EXIT.
025900     EXIT.
026000* --- 4100-INSERT-SETTLEMENT: INSERT CLR.T_SETTLEMENT
026100 4100-INSERT-SETTLEMENT.
026200     MOVE CA-CLAIM-ID TO STLR-CLAIM-ID
026300     EXEC SQL
026400         INSERT INTO CLR.T_SETTLEMENT
026500              ( CLAIM_ID, OFFER_AMT, OFFER_DT, ACCEPTED_DT
026600              , FINAL_FLAG, EXCESS_APPLIED_AMT, ARCHIVE_FLAG
026700              , CREATED_TS, EXT_REF, LAST_UPD_TS, LAST_UPD_PGM
026800              , LAST_UPD_USER )
026900         VALUES
027000              ( :STLR-CLAIM-ID, :STLR-OFFER-AMT, :STLR-OFFER-DT
027100              , :STLR-ACCEPTED-DT, :STLR-FINAL-FLAG
027200              , :STLR-EXCESS-APPLIED-AMT, :STLR-ARCHIVE-FLAG
027300              , CURRENT TIMESTAMP, :STLR-EXT-REF
027400              , CURRENT TIMESTAMP, :WS-PGM-ID, :WS-USER-ID )
027500     END-EXEC
027600     EVALUATE SQLCODE
027700        WHEN 0
027800           ADD 1 TO WS-SETTLEMENT-WRITTEN
027900        WHEN +100
028000           SET WS-ROW-NOT-FOUND TO TRUE
028100        WHEN OTHER
028200           MOVE 'INSERT CLR.T_SETTLEMENT' TO ERR-PARA
028300           PERFORM 8000-SQL-ERROR
028400     END-EVALUATE
028500     .
028600 4100-INSERT-SETTLEMENT-EXIT.
028700     EXIT.
028800* --- 4900-WRITE-AUDIT: AUDIT TRAIL VIA CLRCM020
028900 4900-WRITE-AUDIT.
029000     MOVE 'CLR.T_SETTLEMENT' TO WS-AUD-TABLE
029100     MOVE CA-CLAIM-ID TO WS-AUD-KEY
029200     MOVE 'U' TO WS-AUD-ACTION
029300     MOVE WS-USER-ID TO WS-AUD-USER
029400     MOVE WS-PGM-ID TO WS-AUD-PGM
029500     CALL 'CLRCM020' USING WS-AUDIT-PARMS
029600                      CLR-ERROR-BLOCK
029700     IF ERR-SQLCODE NOT = ZERO
029800        ADD 1 TO WS-REJECT-CNT
029900     END-IF
030000     .
030100 4900-WRITE-AUDIT-EXIT.
030200     EXIT.
030300* --- 9000-RETURN: RETURN TO CICS
030400 9000-RETURN.
030500     EXEC CICS RETURN TRANSID('ST01') COMMAREA(CLR-COMMAREA)
030600        LENGTH(LENGTH OF CLR-COMMAREA) END-EXEC
030700     .
030800 9000-RETURN-EXIT.
030900     EXIT.
031000* --- 8000-SQL-ERROR: SEVERE ERROR - REPORT AND STOP
031100 8000-SQL-ERROR.
031200     MOVE SQLCODE TO ERR-SQLCODE WS-SQLCODE-DSP
031300     MOVE WS-PGM-ID TO ERR-PGM
031400     STRING 'SQLCODE ' WS-SQLCODE-DSP DELIMITED BY SIZE INTO
031500         ERR-TEXT
031600     CALL 'CLRCM050' USING CLR-ERROR-BLOCK
031700     EXEC CICS SYNCPOINT ROLLBACK END-EXEC
031800     MOVE 16 TO CA-RETURN-CD
031900     MOVE ERR-TEXT TO CA-MSG
032000     PERFORM 9000-RETURN THRU 9000-RETURN-EXIT
032100     .
032200 8000-SQL-ERROR-EXIT.
032300     EXIT.
