014400* --- 2300-READ-CLAIM: FETCH CLR.T_CLAIM
014500 2300-READ-CLAIM.
014600     MOVE CA-CLAIM-ID TO CLM-CLAIM-ID
014700     SET WS-ROW-FOUND TO TRUE
014800     EXEC SQL
014900         SELECT CLAIM_ID, POLICY_NO, PRODUCT_CD
015000           INTO :CLM-CLAIM-ID, :CLM-POLICY-NO
015100                , :CLM-PRODUCT-CD
015200           FROM CLR.T_CLAIM
015300          WHERE CLAIM_ID = :CLM-CLAIM-ID
015400     END-EXEC
015500     EVALUATE SQLCODE
015600        WHEN 0
015700           ADD 1 TO WS-CLAIM-READ
015800        WHEN +100
015900           SET WS-ROW-NOT-FOUND TO TRUE
016000        WHEN OTHER
016100           MOVE 'READ CLR.T_CLAIM' TO ERR-PARA
016200           PERFORM 8000-SQL-ERROR
016300     END-EVALUATE
016400     .
016500* --- 2320-READ-SETTLEMENT: FETCH CLR.T_SETTLEMENT
016600 2320-READ-SETTLEMENT.
016700     SET WS-ROW-FOUND TO TRUE
016800     EXEC SQL
016900         SELECT SETTLE_ID, CLAIM_ID, OFFER_AMT, OFFER_DT
017000                , ACCEPTED_DT, FINAL_FLAG
017100           INTO :STLR-SETTLE-ID, :STLR-CLAIM-ID
017200                , :STLR-OFFER-AMT, :STLR-OFFER-DT
017300                , :STLR-ACCEPTED-DT, :STLR-FINAL-FLAG
017400           FROM CLR.T_SETTLEMENT
017500          WHERE SETTLE_ID = :STLR-SETTLE-ID
017600     END-EXEC
017700     EVALUATE SQLCODE
017800        WHEN 0
017900           ADD 1 TO WS-SETTLEMENT-READ
018000        WHEN +100
018100           SET WS-ROW-NOT-FOUND TO TRUE
018200        WHEN OTHER
018300           MOVE 'READ CLR.T_SETTLEMENT' TO ERR-PARA
018400           PERFORM 8000-SQL-ERROR
018500     END-EVALUATE
018600     .
018700* --- 2500-EDIT-CLAIM: CHECK MANDATORY FIELDS IN CLR.T_CLAIM
