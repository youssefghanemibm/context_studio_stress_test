021500     IF CLM-CLAIM-STATUS NOT = 'OP' AND CLM-CLAIM-STATUS NOT =
021600         'CS' AND CLM-CLAIM-STATUS NOT = 'CN' AND CLM-CLAIM-STATUS
021700         NOT = 'RO' AND CLM-CLAIM-STATUS NOT = 'RC'
021800        ADD 1 TO WS-REJECT-CNT
021900        MOVE 'CLAIM_STATUS INVALID' TO ERR-TEXT
022000     END-IF
022100     IF CLM-TIER-CD NOT = '1' AND CLM-TIER-CD NOT = '2' AND
