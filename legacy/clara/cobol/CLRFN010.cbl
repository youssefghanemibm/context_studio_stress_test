023000* ---------------------------------------------------------------*
023100 2100-EDIT-INPUT.
023200     SET WS-NO-ERROR TO TRUE
023300     IF POLINOL = ZERO OR POLINOI = SPACES
023400        SET WS-ERROR-FOUND TO TRUE
023500        MOVE WS-MSG-01 TO MSGO
023600        MOVE -1 TO POLINOL
023700     ELSE
023800        CONTINUE
023900     END-IF
