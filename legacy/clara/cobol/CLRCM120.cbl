009300* --- 2300-READ-USER: FETCH CLR.T_USER
009400 2300-READ-USER.
009500     MOVE WS-USER-ID TO USRR-USER-ID
009600     SET WS-ROW-FOUND TO TRUE
009700     EXEC SQL
009800         SELECT USER_ID, USER_NAME, TEAM_CD, RSV_AUTH_LEVEL
009900                , PAY_AUTH_LEVEL
010000           INTO :USRR-USER-ID, :USRR-USER-NAME, :USRR-TEAM-CD
010100                , :USRR-RSV-AUTH-LEVEL, :USRR-PAY-AUTH-LEVEL
010200           FROM CLR.T_USER
010300          WHERE USER_ID = :USRR-USER-ID
010400     END-EXEC
010500     EVALUATE SQLCODE
010600         WHEN 0
010700             ADD 1 TO WS-USER-READ
010800         WHEN +100
010900             SET WS-ROW-NOT-FOUND TO TRUE
011000         WHEN OTHER
011100             MOVE 'READ CLR.T_USER' TO ERR-PARA
011200             PERFORM 8000-SQL-ERROR
011300     END-EVALUATE
011400     .
011500* --- 2500-EDIT-USER: FIELD EDITS FOR CLR.T_USER
011600 2500-EDIT-USER.
011700     IF USRR-USER-ID = SPACES OR LOW-VALUES
011800         ADD 1 TO WS-REJECT-CNT
011900         MOVE 'USER_ID MISSING' TO ERR-TEXT
012000     END-IF
012100     IF USRR-USER-NAME = SPACES OR LOW-VALUES
012200         ADD 1 TO WS-REJECT-CNT
012300         MOVE 'USER_NAME MISSING' TO ERR-TEXT
012400     END-IF
012500     IF USRR-TEAM-CD = SPACES OR LOW-VALUES
012600         ADD 1 TO WS-REJECT-CNT
012700         MOVE 'TEAM_CD MISSING' TO ERR-TEXT
012800     END-IF
012900     .
013000* --- 2510-EDIT-USER-2: VALIDATE CLR.T_USER
013100 2510-EDIT-USER-2.
013200     IF USRR-RSV-AUTH-LEVEL = SPACES OR LOW-VALUES
013300         ADD 1 TO WS-REJECT-CNT
013400         MOVE 'RSV_AUTH_LEVEL MISSING' TO ERR-TEXT
013500     END-IF
013600     IF USRR-PAY-AUTH-LEVEL = SPACES OR LOW-VALUES
013700         ADD 1 TO WS-REJECT-CNT
013800         MOVE 'PAY_AUTH_LEVEL MISSING' TO ERR-TEXT
013900     END-IF
014000     IF USRR-ACTIVE-FLAG = SPACES OR LOW-VALUES
014100         ADD 1 TO WS-REJECT-CNT
014200         MOVE 'ACTIVE_FLAG MISSING' TO ERR-TEXT
014300     END-IF
014400     .
