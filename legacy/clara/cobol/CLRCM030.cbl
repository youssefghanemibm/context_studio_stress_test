009000* --- 2300-READ-CURRENCY-RATE: LOOK UP CLR.T_CURRENCY_RATE
009100 2300-READ-CURRENCY-RATE.
009200     MOVE WS-RUN-DATE TO CURR-RATE-DT
009300     SET WS-ROW-FOUND TO TRUE
009400     EXEC SQL
009500         SELECT CURRENCY_CD, RATE_DT, RATE_TO_GBP
009600                , RATE_TYPE_CD, ARCHIVE_FLAG
009700           INTO :CURR-CURRENCY-CD, :CURR-RATE-DT
009800                , :CURR-RATE-TO-GBP, :CURR-RATE-TYPE-CD
009900                , :CURR-ARCHIVE-FLAG
010000           FROM CLR.T_CURRENCY_RATE
010100          WHERE CURRENCY_CD = :CURR-CURRENCY-CD
010200            AND RATE_DT = :CURR-RATE-DT
010300     END-EXEC
010400     EVALUATE SQLCODE
010500        WHEN 0
010600           ADD 1 TO WS-CURRENCY-RATE-READ
010700        WHEN +100
010800           SET WS-ROW-NOT-FOUND TO TRUE
010900        WHEN OTHER
011000           MOVE 'READ CLR.T_CURRENCY_RATE' TO ERR-PARA
011100           PERFORM 8000-SQL-ERROR
011200     END-EVALUATE
011300     .
011400* --- 2500-EDIT-CURRENCY-RATE: VALIDATE CLR.T_CURRENCY_RATE
011500 2500-EDIT-CURRENCY-RATE.
011600     IF CURR-CURRENCY-CD = SPACES OR LOW-VALUES
011700        ADD 1 TO WS-REJECT-CNT
011800        MOVE 'CURRENCY_CD MISSING' TO ERR-TEXT
011900     END-IF
012000     IF CURR-RATE-DT NOT = SPACES AND CURR-RATE-DT(5:1) NOT = '-'
012100        MOVE 'RATE_DT BAD DATE' TO ERR-TEXT
012200        ADD 1 TO WS-REJECT-CNT
012300     END-IF
012400     IF CURR-RATE-TO-GBP NOT NUMERIC
012500        MOVE ZERO TO CURR-RATE-TO-GBP
012600        ADD 1 TO WS-REJECT-CNT
012700     END-IF
012800     .
012900* --- 2510-EDIT-CURRENCY-RATE-2: CHECK MANDATORY FIELDS IN CLR.T_C
013000 2510-EDIT-CURRENCY-RATE-2.
013100     IF CURR-RATE-TYPE-CD NOT = 'DY' AND CURR-RATE-TYPE-CD NOT =
013200         'ME' AND CURR-RATE-TYPE-CD NOT = 'YE'
013300        ADD 1 TO WS-REJECT-CNT
013400        MOVE 'RATE_TYPE_CD INVALID' TO ERR-TEXT
013500     END-IF
013600     IF CURR-ARCHIVE-FLAG NOT = 'Y' AND CURR-ARCHIVE-FLAG NOT =
013700         'N'
013800        ADD 1 TO WS-REJECT-CNT
013900        MOVE 'ARCHIVE_FLAG INVALID' TO ERR-TEXT
014000     END-IF
014100     .
014200* --- 2520-EDIT-CURRENCY-RATE-3: FIELD EDITS FOR CLR.T_CURRENCY_RA
014300 2520-EDIT-CURRENCY-RATE-3.
