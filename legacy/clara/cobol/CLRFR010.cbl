016608 2320-READ-FRAU-NOTI.
016612     SET WS-ROW-FOUND TO TRUE
016616     EXEC SQL
016620         SELECT NOTICE_ID, REF_ID, CLAIM_ID
016624                , NOTICE_CHANNEL_CD, NOTICE_DUE_DT
016628                , NOTICE_SENT_TS
016632           INTO :FRDN-NOTICE-ID, :FRDN-REF-ID, :FRDN-CLAIM-ID
016636                , :FRDN-NOTICE-CHANNEL-CD
016640                , :FRDN-NOTICE-DUE-DT, :FRDN-NOTICE-SENT-TS
016644           FROM CLR.T_FRAUD_NOTIFICATION
016648          WHERE NOTICE_ID = :FRDN-NOTICE-ID
