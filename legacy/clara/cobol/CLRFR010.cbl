014700* --- 2300-READ-CLAIM-LINK: FETCH CLR.T_CLAIM_LINK
014800 2300-READ-CLAIM-LINK.
014900     SET WS-ROW-FOUND TO TRUE
015000     EXEC SQL
015100         SELECT LINK_ID, CLAIM_ID_A, CLAIM_ID_B, LINK_TYPE_CD
015200           INTO :FRDL-LINK-ID, :FRDL-CLAIM-ID-A
015300                , :FRDL-CLAIM-ID-B, :FRDL-LINK-TYPE-CD
015400           FROM CLR.T_CLAIM_LINK
015500          WHERE LINK_ID = :FRDL-LINK-ID
015600     END-EXEC
015700     EVALUATE SQLCODE
015800         WHEN 0
015900             ADD 1 TO WS-CLAIM-LINK-READ
016000         WHEN +100
016100             SET WS-ROW-NOT-FOUND TO TRUE
016200         WHEN OTHER
016300             MOVE 'READ CLR.T_CLAIM_LINK' TO ERR-PARA
016400             PERFORM 8000-SQL-ERROR
016500     END-EVALUATE
016600     .
