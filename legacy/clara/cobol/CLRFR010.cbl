023000              , :FRDS-MODEL-VERSION, :FRDS-TOP-REASON-1
023100              , :FRDS-TOP-REASON-2, :FRDS-SOURCE-SYS-CD
023200              , CURRENT TIMESTAMP, :WS-PGM-ID, :WS-USER-ID )
023300     END-EXEC
