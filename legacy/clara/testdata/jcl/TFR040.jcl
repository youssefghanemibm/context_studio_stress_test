//TFR040   JOB (CLR,TEST),'UNIT TEST CLRFR040',CLASS=T,MSGCLASS=X,NOTIFY=&SYSUID
//* UNIT TEST RUN OF CLRFR040 AGAINST THE TEST SCHEMA (FIXTURES IN testdata/db2)
//         INCLUDE MEMBER=CLRTSYMS
//STEP010  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=&TSTHLQ..LOADLIB,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//RPTOUT   DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=JCLONLY
  DSN SYSTEM(&TSTSSID)
  RUN PROGRAM(CLRFR040) PLAN(&TSTPLAN) -
      LIB('&TSTHLQ..LOADLIB')
  END
/*
