************************************************************************
* MAPSET   : CLRMS01                                                   *
* MAP      : CLRM010  FNOL CAPTURE                FN01 / CLRFN010      *
* MAP      : CLRM015  POLICY LOOKUP               FN15 / CLRFN015      *
* GENERATE THE SYMBOLIC MAP WITH SYSPARM=DSECT; KEEP THE COPY IN THE   *
* PROGRAMS (INLINE SYMBOLIC MAP) IN STEP WITH THIS SOURCE.             *
************************************************************************
CLRMS01  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,TERM=3270-2
*
* MAP CLRM010 - FNOL CAPTURE
* TRANSACTION FN01, PROGRAM CLRFN010
*
CLRM010  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM010'
         DFHMDF POS=(1,30),LENGTH=12,ATTRB=(ASKIP,BRT),                X
               INITIAL='FNOL CAPTURE'
*        POLICY-NO
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='POLICY NO .......'
POLINO   DFHMDF POS=(4,20),LENGTH=10,ATTRB=PROT
         DFHMDF POS=(4,30),LENGTH=1,ATTRB=ASKIP
*        LOSS-DATE
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='LOSS DATE .......'
LOSDAT   DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT,IC)
         DFHMDF POS=(6,30),LENGTH=1,ATTRB=ASKIP
*        PERIL
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='PERIL ...........'
PERIL    DFHMDF POS=(8,20),LENGTH=30,ATTRB=UNPROT
         DFHMDF POS=(8,50),LENGTH=1,ATTRB=ASKIP
*        CHANNEL
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='CHANNEL .........'
CHANNEL  DFHMDF POS=(10,20),LENGTH=30,ATTRB=UNPROT
         DFHMDF POS=(10,50),LENGTH=1,ATTRB=ASKIP
*        LOSS-DESC
         DFHMDF POS=(12,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='LOSS DESC .......'
LOSDES   DFHMDF POS=(12,20),LENGTH=30,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(12,50),LENGTH=1,ATTRB=ASKIP
*        CALLER-PHONE
         DFHMDF POS=(14,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='CALLER PHONE ....'
CALPHO   DFHMDF POS=(14,20),LENGTH=10,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(14,30),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
*
* MAP CLRM015 - POLICY LOOKUP
* TRANSACTION FN15, PROGRAM CLRFN015
*
CLRM015  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM015'
         DFHMDF POS=(1,30),LENGTH=13,ATTRB=(ASKIP,BRT),                X
               INITIAL='POLICY LOOKUP'
*        POLICY-NO
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='POLICY NO .......'
POLINO   DFHMDF POS=(4,20),LENGTH=12,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(4,32),LENGTH=1,ATTRB=ASKIP
*        PH-NAME
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='PH NAME .........'
PHNAME   DFHMDF POS=(6,20),LENGTH=8,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(6,28),LENGTH=1,ATTRB=ASKIP
*        COVER-START
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='COVER START .....'
COVSTA   DFHMDF POS=(8,20),LENGTH=20,ATTRB=UNPROT
         DFHMDF POS=(8,40),LENGTH=1,ATTRB=ASKIP
*        COVER-END
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='COVER END .......'
COVEEND  DFHMDF POS=(10,20),LENGTH=10,ATTRB=UNPROT
         DFHMDF POS=(10,30),LENGTH=1,ATTRB=ASKIP
*        EXCESS
         DFHMDF POS=(12,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='EXCESS ..........'
EXCESS   DFHMDF POS=(12,20),LENGTH=10,ATTRB=UNPROT
         DFHMDF POS=(12,30),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
