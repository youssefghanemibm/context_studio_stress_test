************************************************************************
* MAPSET   : CLRMS02                                                   *
* MAP      : CLRM110  TRIAGE WORKBENCH            TR01 / CLRTR010      *
* GENERATE THE SYMBOLIC MAP WITH SYSPARM=DSECT; KEEP THE COPY IN THE   *
* PROGRAMS (INLINE SYMBOLIC MAP) IN STEP WITH THIS SOURCE.             *
************************************************************************
CLRMS02  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,TERM=3270-2
*
* MAP CLRM110 - TRIAGE WORKBENCH
* TRANSACTION TR01, PROGRAM CLRTR010
*
CLRM110  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM110'
         DFHMDF POS=(1,30),LENGTH=16,ATTRB=(ASKIP,BRT),                X
               INITIAL='TRIAGE WORKBENCH'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=12,ATTRB=PROT
         DFHMDF POS=(4,32),LENGTH=1,ATTRB=ASKIP
*        TIER
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='TIER ............'
TIER     DFHMDF POS=(6,20),LENGTH=16,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(6,36),LENGTH=1,ATTRB=ASKIP
*        SCORE
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='SCORE ...........'
SCORE    DFHMDF POS=(8,20),LENGTH=8,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(8,28),LENGTH=1,ATTRB=ASKIP
*        ROUTE
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='ROUTE ...........'
ROUTE    DFHMDF POS=(10,20),LENGTH=20,ATTRB=UNPROT
         DFHMDF POS=(10,40),LENGTH=1,ATTRB=ASKIP
*        FASTTRACK
         DFHMDF POS=(12,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='FASTTRACK .......'
FAST     DFHMDF POS=(12,20),LENGTH=20,ATTRB=PROT
         DFHMDF POS=(12,40),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
