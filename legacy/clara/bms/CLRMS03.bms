************************************************************************
* MAPSET   : CLRMS03                                                   *
* MAP      : CLRM210  ASSESSMENT WORKBENCH        AS01 / CLRAS010      *
* MAP      : CLRM220  CLAIMS ASSESSOR APPOINTMENT AS02 / CLRAS020      *
* GENERATE THE SYMBOLIC MAP WITH SYSPARM=DSECT; KEEP THE COPY IN THE   *
* PROGRAMS (INLINE SYMBOLIC MAP) IN STEP WITH THIS SOURCE.             *
************************************************************************
CLRMS03  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,TERM=3270-2
*
* MAP CLRM210 - ASSESSMENT WORKBENCH
* TRANSACTION AS01, PROGRAM CLRAS010
*
CLRM210  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM210'
         DFHMDF POS=(1,30),LENGTH=20,ATTRB=(ASKIP,BRT),                X
               INITIAL='ASSESSMENT WORKBENCH'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=20,ATTRB=PROT
         DFHMDF POS=(4,40),LENGTH=1,ATTRB=ASKIP
*        ASSESS-TYPE
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='ASSESS TYPE .....'
ASSTYP   DFHMDF POS=(6,20),LENGTH=16,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(6,36),LENGTH=1,ATTRB=ASKIP
*        ESTIMATE
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='ESTIMATE ........'
ESTI     DFHMDF POS=(8,20),LENGTH=8,ATTRB=UNPROT
         DFHMDF POS=(8,28),LENGTH=1,ATTRB=ASKIP
*        COVER-DEC
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='COVER DEC .......'
COVEDEC  DFHMDF POS=(10,20),LENGTH=16,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(10,36),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
*
* MAP CLRM220 - CLAIMS ASSESSOR APPOINTMENT
* TRANSACTION AS02, PROGRAM CLRAS020
*
CLRM220  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM220'
         DFHMDF POS=(1,30),LENGTH=27,ATTRB=(ASKIP,BRT),                X
               INITIAL='CLAIMS ASSESSOR APPOINTMENT'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=20,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(4,40),LENGTH=1,ATTRB=ASKIP
*        ASSESSOR-ID
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='ASSESSOR ID .....'
ASSEID   DFHMDF POS=(6,20),LENGTH=16,ATTRB=UNPROT
         DFHMDF POS=(6,36),LENGTH=1,ATTRB=ASKIP
*        VENDOR
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='VENDOR ..........'
VENDOR   DFHMDF POS=(8,20),LENGTH=10,ATTRB=UNPROT
         DFHMDF POS=(8,30),LENGTH=1,ATTRB=ASKIP
*        SLA-DUE
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='SLA DUE .........'
SLADUE   DFHMDF POS=(10,20),LENGTH=30,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(10,50),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
