************************************************************************
* MAPSET   : CLRMS04                                                   *
* MAP      : CLRM310  INITIAL RESERVE             RS01 / CLRRS010      *
* MAP      : CLRM320  RESERVE ADJUSTMENT          RS02 / CLRRS020      *
* MAP      : CLRM330  RESERVE ENQUIRY             RS03 / CLRRS030      *
* GENERATE THE SYMBOLIC MAP WITH SYSPARM=DSECT; KEEP THE COPY IN THE   *
* PROGRAMS (INLINE SYMBOLIC MAP) IN STEP WITH THIS SOURCE.             *
************************************************************************
CLRMS04  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,TERM=3270-2
*
* MAP CLRM310 - INITIAL RESERVE
* TRANSACTION RS01, PROGRAM CLRRS010
*
CLRM310  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM310'
         DFHMDF POS=(1,30),LENGTH=15,ATTRB=(ASKIP,BRT),                X
               INITIAL='INITIAL RESERVE'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=12,ATTRB=(UNPROT,IC)
         DFHMDF POS=(4,32),LENGTH=1,ATTRB=ASKIP
*        RSV-TYPE
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='RSV TYPE ........'
RSVTYPE  DFHMDF POS=(6,20),LENGTH=16,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(6,36),LENGTH=1,ATTRB=ASKIP
*        CURRENCY
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CURRENCY ........'
CURR     DFHMDF POS=(8,20),LENGTH=12,ATTRB=PROT
         DFHMDF POS=(8,32),LENGTH=1,ATTRB=ASKIP
*        RSV-AMT
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='RSV AMT .........'
RSVAMT   DFHMDF POS=(10,20),LENGTH=10,ATTRB=PROT
         DFHMDF POS=(10,30),LENGTH=1,ATTRB=ASKIP
*        AUTH-LEVEL
         DFHMDF POS=(12,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='AUTH LEVEL ......'
AUTLEV   DFHMDF POS=(12,20),LENGTH=10,ATTRB=UNPROT
         DFHMDF POS=(12,30),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
*
* MAP CLRM320 - RESERVE ADJUSTMENT
* TRANSACTION RS02, PROGRAM CLRRS020
*
CLRM320  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM320'
         DFHMDF POS=(1,30),LENGTH=18,ATTRB=(ASKIP,BRT),                X
               INITIAL='RESERVE ADJUSTMENT'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=16,ATTRB=PROT
         DFHMDF POS=(4,36),LENGTH=1,ATTRB=ASKIP
*        RSV-ID
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='RSV ID ..........'
RSVID    DFHMDF POS=(6,20),LENGTH=20,ATTRB=PROT
         DFHMDF POS=(6,40),LENGTH=1,ATTRB=ASKIP
*        OLD-AMT
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='OLD AMT .........'
OLDAMT   DFHMDF POS=(8,20),LENGTH=10,ATTRB=(UNPROT,IC)
         DFHMDF POS=(8,30),LENGTH=1,ATTRB=ASKIP
*        NEW-AMT
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='NEW AMT .........'
NEWAMT   DFHMDF POS=(10,20),LENGTH=16,ATTRB=UNPROT
         DFHMDF POS=(10,36),LENGTH=1,ATTRB=ASKIP
*        REASON
         DFHMDF POS=(12,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='REASON ..........'
REASON   DFHMDF POS=(12,20),LENGTH=30,ATTRB=UNPROT
         DFHMDF POS=(12,50),LENGTH=1,ATTRB=ASKIP
*        NEXT-REVIEW
         DFHMDF POS=(14,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='NEXT REVIEW .....'
NEXREV   DFHMDF POS=(14,20),LENGTH=10,ATTRB=UNPROT
         DFHMDF POS=(14,30),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
*
* MAP CLRM330 - RESERVE ENQUIRY
* TRANSACTION RS03, PROGRAM CLRRS030
*
CLRM330  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM330'
         DFHMDF POS=(1,30),LENGTH=15,ATTRB=(ASKIP,BRT),                X
               INITIAL='RESERVE ENQUIRY'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=16,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(4,36),LENGTH=1,ATTRB=ASKIP
*        RSV-ID
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='RSV ID ..........'
RSVID    DFHMDF POS=(6,20),LENGTH=16,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(6,36),LENGTH=1,ATTRB=ASKIP
*        OUTSTANDING
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='OUTSTANDING .....'
OUTS     DFHMDF POS=(8,20),LENGTH=10,ATTRB=PROT
         DFHMDF POS=(8,30),LENGTH=1,ATTRB=ASKIP
*        PAID-TD
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='PAID TD .........'
PAIDTD   DFHMDF POS=(10,20),LENGTH=16,ATTRB=UNPROT
         DFHMDF POS=(10,36),LENGTH=1,ATTRB=ASKIP
*        GBP-EQUIV
         DFHMDF POS=(12,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='GBP EQUIV .......'
GBPEQUI  DFHMDF POS=(12,20),LENGTH=20,ATTRB=UNPROT
         DFHMDF POS=(12,40),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
