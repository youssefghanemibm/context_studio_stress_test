************************************************************************
* MAPSET   : CLRMS07                                                   *
* MAP      : CLRM610  RECOVERY POTENTIAL          RC01 / CLRRC010      *
* MAP      : CLRM620  SUBROGATION CASE            RC02 / CLRRC020      *
* GENERATE THE SYMBOLIC MAP WITH SYSPARM=DSECT; KEEP THE COPY IN THE   *
* PROGRAMS (INLINE SYMBOLIC MAP) IN STEP WITH THIS SOURCE.             *
************************************************************************
CLRMS07  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,TERM=3270-2
*
* MAP CLRM610 - RECOVERY POTENTIAL
* TRANSACTION RC01, PROGRAM CLRRC010
*
CLRM610  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM610'
         DFHMDF POS=(1,30),LENGTH=18,ATTRB=(ASKIP,BRT),                X
               INITIAL='RECOVERY POTENTIAL'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=20,ATTRB=PROT
         DFHMDF POS=(4,40),LENGTH=1,ATTRB=ASKIP
*        TP-FAULT
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='TP FAULT ........'
TPFAULT  DFHMDF POS=(6,20),LENGTH=30,ATTRB=(UNPROT,IC)
         DFHMDF POS=(6,50),LENGTH=1,ATTRB=ASKIP
*        TP-INSURER
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='TP INSURER ......'
TPINSU   DFHMDF POS=(8,20),LENGTH=16,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(8,36),LENGTH=1,ATTRB=ASKIP
*        EXPECTED-AMT
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='EXPECTED AMT ....'
EXPEAMT  DFHMDF POS=(10,20),LENGTH=20,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(10,40),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
*
* MAP CLRM620 - SUBROGATION CASE
* TRANSACTION RC02, PROGRAM CLRRC020
*
CLRM620  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM620'
         DFHMDF POS=(1,30),LENGTH=16,ATTRB=(ASKIP,BRT),                X
               INITIAL='SUBROGATION CASE'
*        CASE-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CASE ID .........'
CASEID   DFHMDF POS=(4,20),LENGTH=12,ATTRB=PROT
         DFHMDF POS=(4,32),LENGTH=1,ATTRB=ASKIP
*        DEMAND-AMT
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='DEMAND AMT ......'
DEMAAMT  DFHMDF POS=(6,20),LENGTH=20,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(6,40),LENGTH=1,ATTRB=ASKIP
*        SOLICITOR
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='SOLICITOR .......'
SOLI     DFHMDF POS=(8,20),LENGTH=12,ATTRB=PROT
         DFHMDF POS=(8,32),LENGTH=1,ATTRB=ASKIP
*        LIMITATION-DATE
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='LIMITATION DATE .'
LIMDAT   DFHMDF POS=(10,20),LENGTH=8,ATTRB=PROT
         DFHMDF POS=(10,28),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
