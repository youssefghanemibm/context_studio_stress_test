************************************************************************
* MAPSET   : CLRMS06                                                   *
* MAP      : CLRM510  SETTLEMENT OFFER            ST01 / CLRST010      *
* GENERATE THE SYMBOLIC MAP WITH SYSPARM=DSECT; KEEP THE COPY IN THE   *
* PROGRAMS (INLINE SYMBOLIC MAP) IN STEP WITH THIS SOURCE.             *
************************************************************************
CLRMS06  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,      X
               CTRL=(FREEKB,FRSET),TIOAPFX=YES,TERM=3270-2
*
* MAP CLRM510 - SETTLEMENT OFFER
* TRANSACTION ST01, PROGRAM CLRST010
*
CLRM510  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=7,ATTRB=(ASKIP,BRT),INITIAL='CLRM510'
         DFHMDF POS=(1,30),LENGTH=16,ATTRB=(ASKIP,BRT),                X
               INITIAL='SETTLEMENT OFFER'
*        CLAIM-ID
         DFHMDF POS=(4,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='CLAIM ID ........'
CLAIMID  DFHMDF POS=(4,20),LENGTH=8,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(4,28),LENGTH=1,ATTRB=ASKIP
*        OFFER-AMT
         DFHMDF POS=(6,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='OFFER AMT .......'
OFFEAMT  DFHMDF POS=(6,20),LENGTH=12,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(6,32),LENGTH=1,ATTRB=ASKIP
*        EXCESS
         DFHMDF POS=(8,1),LENGTH=17,ATTRB=ASKIP,                       X
               INITIAL='EXCESS ..........'
EXCESS   DFHMDF POS=(8,20),LENGTH=16,ATTRB=PROT
         DFHMDF POS=(8,36),LENGTH=1,ATTRB=ASKIP
*        OFFER-DATE
         DFHMDF POS=(10,1),LENGTH=17,ATTRB=ASKIP,                      X
               INITIAL='OFFER DATE ......'
OFFDAT   DFHMDF POS=(10,20),LENGTH=12,ATTRB=PROT
         DFHMDF POS=(10,32),LENGTH=1,ATTRB=ASKIP
MSG      DFHMDF POS=(23,1),LENGTH=79,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=44,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  PF7=BACK  PF8=FORWARD  PF12=CANCEL'
         DFHMSD TYPE=FINAL
         END
